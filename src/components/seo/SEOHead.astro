---
import { generateMeta, generateJsonLd } from "@lib/seo";
import { getAlternateLinks } from "@i18n/index";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  faqItems?: { question: string; answer: string }[];
  keywords?: string[];
  howToSteps?: { name: string; text: string; image?: string }[];
  locale?: string;
  toolSchema?: {
    name: string;
    description: string;
    url: string;
    featureList: string[];
  };
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
    image?: string;
  };
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = true,
  breadcrumbs,
  faqItems,
  keywords,
  howToSteps,
  locale = "en",
  toolSchema,
  articleSchema,
} = Astro.props;

const meta = generateMeta({ title, description, canonical, ogImage, noindex });

const alternateLinks = getAlternateLinks(locale as any, Astro.url.pathname.replace(/^\/(en|es|pt|hi|fr|de)(\/|$)/, "/$2"));

const jsonLdData = jsonLd
  ? generateJsonLd({
      name: title,
      description,
      url: canonical,
      breadcrumbs,
      faqItems,
      howToSteps,
      toolSchema,
      articleSchema,
    })
  : null;
---

<meta name="generator" content={Astro.generator} />

<!-- Preload local primary font -->
<link rel="preload" href="/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-semibold.woff2" as="font" type="font/woff2" crossorigin />

<title>{meta.title}</title>

{meta.meta.map((m) => (
  <meta {...m} />
))}

{keywords && keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(", ")} />
)}

{meta.link.map((l) => (
  <link {...l} />
))}

{alternateLinks.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
<link rel="alternate" hreflang="x-default" href={`https://quickjpgconverter.com${Astro.url.pathname.replace(/^\/(en|es|pt|hi|fr|de)(\/|$)/, "/$2")}`} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.svg" />

{jsonLdData && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />
)}
