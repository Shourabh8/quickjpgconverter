---
import { generateMeta, generateJsonLd } from "@lib/seo";
import { getAlternateLinks } from "@i18n/index";
import { isExcludedRoute } from "@data/seoExclusions.mjs";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  faqItems?: { question: string; answer: string }[];
  keywords?: string[];
  howToSteps?: { name: string; text: string; image?: string }[];
  locale?: string;
  toolSchema?: {
    name: string;
    description: string;
    url: string;
    featureList: string[];
  };
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
    image?: string;
  };
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = true,
  breadcrumbs,
  faqItems,
  keywords,
  howToSteps,
  locale = "en",
  toolSchema,
  articleSchema,
} = Astro.props;

const effectiveNoindex = noindex || isExcludedRoute(Astro.url.pathname);
const meta = generateMeta({ title, description, canonical, ogImage, noindex: effectiveNoindex, locale });

const cleanPath = (Astro.url.pathname.replace(/^\/(en|es|pt|hi|fr|de)(?=\/|$)/, "") || "/").replace(/\/+/g, "/");
const alternateLinks = effectiveNoindex ? [] : getAlternateLinks(locale as any, cleanPath);
const xDefaultHref = cleanPath === "/" ? "https://quickjpgconverter.com/" : `https://quickjpgconverter.com${cleanPath.replace(/\/+$/, "")}/`;

const jsonLdData = jsonLd
  ? generateJsonLd({
      name: title,
      description,
      url: meta.canonical,
      locale,
      breadcrumbs,
      faqItems,
      howToSteps,
      toolSchema,
      articleSchema,
    })
  : null;
---

<meta name="generator" content={Astro.generator} />

<!-- Preload local primary font -->
<link rel="preload" href="/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-semibold.woff2" as="font" type="font/woff2" crossorigin />

<title>{meta.title}</title>

{meta.meta.map((m) => (
  <meta {...m} />
))}

{meta.link.map((l) => (
  <link {...l} />
))}

{alternateLinks.length > 0 && (
  <>
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
  </>
)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.svg" />

{jsonLdData && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />
)}
