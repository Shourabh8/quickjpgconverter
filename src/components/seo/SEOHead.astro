---
import { generateMeta, generateJsonLd } from "@lib/seo";
import { locales, getLocalePrefix } from "@i18n/index";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  faqItems?: { question: string; answer: string }[];
  keywords?: string[];
  howToSteps?: { name: string; text: string; image?: string }[];
  locale?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = true,
  breadcrumbs,
  faqItems,
  keywords,
  howToSteps,
  locale = "en",
} = Astro.props;

const meta = generateMeta({ title, description, canonical, ogImage, noindex });

const jsonLdData = jsonLd
  ? generateJsonLd({
      name: title,
      description,
      url: canonical,
      breadcrumbs,
      faqItems,
      howToSteps,
    })
  : null;

// Generate hreflang links
const currentPath = Astro.url.pathname;
const basePath = currentPath.replace(/^\/(en|es|pt|hi|fr|de)(\/|$)/, "/$2");
const siteUrl = "https://quickjpgconverter.com";
const hreflangLinks = locales.map((l) => {
  const prefix = getLocalePrefix(l);
  return { lang: l, href: `${siteUrl}${prefix}${basePath}` };
});
// x-default points to English version
hreflangLinks.push({ lang: "x-default", href: `${siteUrl}${basePath}` });
---

<meta name="generator" content={Astro.generator} />

<title>{meta.title}</title>

{meta.meta.map((m) => (
  <meta {...m} />
))}

{keywords && keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(", ")} />
)}

{meta.link.map((l) => (
  <link {...l} />
))}

<!-- Hreflang for international targeting -->
{hreflangLinks.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
<link rel="manifest" href="/manifest.json" />

{jsonLdData && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />
)}
