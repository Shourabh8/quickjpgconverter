---
interface Props {
  slug: string;
  title: string;
  description: string;
  from: string;
  to: string;
  icon: string;
  category?: string;
  class?: string;
  "data-search"?: string;
}

const { slug, title, description, from, to, icon, category, class: className, "data-search": dataSearch } = Astro.props;

// Determine category theme (similar to iLovePDF/iLoveIMG color semantics)
const isCompress = category === "image-compressors" || slug.includes("compress");
const isCreative = category === "image-tools" || ["watermark-image", "image-color-picker", "image-to-black-and-white", "remove-background", "crop-image"].includes(slug);
const isGovt = ["signature-resizer", "passport-photo-size", "passport-photo-size-india", "aadhar-photo-resize", "upsc-photo-compressor", "compress-for-govt-form"].includes(slug);
const isPdf = category === "pdf-converters" || category === "pdf-tools" || slug.includes("pdf");

let theme = {
  iconBg: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20 group-hover:bg-blue-500/20 group-hover:border-blue-500/40",
  badgeBg: "bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20",
  cardHover: "hover:border-blue-500/40 hover:shadow-[0_12px_28px_-6px_rgba(37,99,235,0.12)]",
  titleHover: "group-hover:text-blue-600 dark:group-hover:text-blue-400",
  arrowHover: "group-hover:text-blue-500",
};

if (isCompress) {
  theme = {
    iconBg: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20 group-hover:bg-emerald-500/20 group-hover:border-emerald-500/40",
    badgeBg: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20",
    cardHover: "hover:border-emerald-500/40 hover:shadow-[0_12px_28px_-6px_rgba(16,185,129,0.14)]",
    titleHover: "group-hover:text-emerald-600 dark:group-hover:text-emerald-400",
    arrowHover: "group-hover:text-emerald-500",
  };
} else if (isGovt) {
  theme = {
    iconBg: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20 group-hover:bg-amber-500/20 group-hover:border-amber-500/40",
    badgeBg: "bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20",
    cardHover: "hover:border-amber-500/40 hover:shadow-[0_12px_28px_-6px_rgba(245,158,11,0.14)]",
    titleHover: "group-hover:text-amber-600 dark:group-hover:text-amber-400",
    arrowHover: "group-hover:text-amber-500",
  };
} else if (isCreative) {
  theme = {
    iconBg: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20 group-hover:bg-purple-500/20 group-hover:border-purple-500/40",
    badgeBg: "bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20",
    cardHover: "hover:border-purple-500/40 hover:shadow-[0_12px_28px_-6px_rgba(139,92,246,0.14)]",
    titleHover: "group-hover:text-purple-600 dark:group-hover:text-purple-400",
    arrowHover: "group-hover:text-purple-500",
  };
} else if (isPdf) {
  theme = {
    iconBg: "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20 group-hover:bg-rose-500/20 group-hover:border-rose-500/40",
    badgeBg: "bg-rose-500/10 text-rose-700 dark:text-rose-300 border-rose-500/20",
    cardHover: "hover:border-rose-500/40 hover:shadow-[0_12px_28px_-6px_rgba(244,63,94,0.14)]",
    titleHover: "group-hover:text-rose-600 dark:group-hover:text-rose-400",
    arrowHover: "group-hover:text-rose-500",
  };
}
---

<a
  href={`/${slug}/`}
  class:list={[
    "card-gradient group block p-6 sm:p-7 relative transition-all duration-300",
    theme.cardHover,
    className
  ]}
  data-search={dataSearch}
>
  <div class="flex items-start justify-between mb-4">
    <div class:list={[
      "w-12 h-12 rounded-2xl flex items-center justify-center text-2xl border transition-all duration-300 group-hover:scale-110",
      theme.iconBg
    ]}>
      {icon}
    </div>
    <div class:list={["w-8 h-8 rounded-full flex items-center justify-center bg-surface-subtle/80 text-text-tertiary transition-all duration-300 group-hover:translate-x-1", theme.arrowHover]}>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>

  <h3 class:list={[
    "text-lg font-semibold text-text-primary mb-1.5 transition-colors",
    theme.titleHover
  ]}>
    {title}
  </h3>
  <p class="text-sm text-text-secondary leading-relaxed mb-4">
    {description}
  </p>

  <div class="flex items-center gap-2">
    <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-lg bg-surface-subtle text-text-secondary border border-border-muted">
      {from}
    </span>
    <svg class="w-3.5 h-3.5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
    <span class:list={[
      "inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg border",
      theme.badgeBg
    ]}>
      {to}
    </span>
  </div>
</a>

