---
import Container from "../ui/Container.astro";
import FeatureCard from "../ui/FeatureCard.astro";

interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<section class="section bg-surface-muted">
  <Container>
    <div class="text-center mb-12">
      <span class="badge-brand mb-4 inline-flex">Features</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
        Why Choose This Tool?
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto">
        Fast, secure, and free — everything runs directly in your browser.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {features.map((feature) => (
        <FeatureCard
          icon={feature.icon}
          title={feature.title}
          description={feature.description}
        />
      ))}
    </div>
  </Container>
</section>
