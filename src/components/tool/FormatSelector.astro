---
interface Props {
  from: string;
  to: string;
}

const { from, to } = Astro.props;
---

<div class="inline-flex items-center gap-3 sm:gap-4 p-2 rounded-2xl border border-border-default bg-surface">
  <div class="px-4 sm:px-5 py-2.5 rounded-xl bg-surface-subtle text-center min-w-[80px] sm:min-w-[100px]">
    <span class="text-[10px] sm:text-xs text-text-tertiary uppercase tracking-wider font-medium">From</span>
    <p class="text-sm sm:text-base font-bold text-text-primary">{from}</p>
  </div>

  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center shadow-sm">
    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
  </div>

  <div class="px-4 sm:px-5 py-2.5 rounded-xl bg-brand-50 dark:bg-brand-950/50 border border-brand-100 dark:border-brand-900/50 text-center min-w-[80px] sm:min-w-[100px]">
    <span class="text-[10px] sm:text-xs text-brand-600 dark:text-brand-400 uppercase tracking-wider font-medium">To</span>
    <p class="text-sm sm:text-base font-bold text-brand-700 dark:text-brand-300">{to}</p>
  </div>
</div>
