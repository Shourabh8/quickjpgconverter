---
interface Props {
  from: string;
  to: string;
}

const { from, to } = Astro.props;
---

<div class="inline-flex items-center gap-3 sm:gap-4 p-2.5 sm:p-3 rounded-2xl border border-border-default bg-surface shadow-lg">
  <div class="px-5 sm:px-6 py-3 rounded-xl bg-surface-subtle text-center min-w-[90px] sm:min-w-[110px]">
    <span class="text-[10px] sm:text-xs text-text-tertiary uppercase tracking-wider font-medium">From</span>
    <p class="text-lg sm:text-xl font-bold text-text-primary mt-0.5">{from}</p>
  </div>

  <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-gradient-to-br from-brand-500 to-accent-500 flex items-center justify-center shadow-md">
    <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
  </div>

  <div class="px-5 sm:px-6 py-3 rounded-xl bg-gradient-to-br from-brand-500 to-brand-600 text-center min-w-[90px] sm:min-w-[110px] shadow-sm">
    <span class="text-[10px] sm:text-xs text-brand-100 uppercase tracking-wider font-medium">To</span>
    <p class="text-lg sm:text-xl font-bold text-white mt-0.5">{to}</p>
  </div>
</div>
