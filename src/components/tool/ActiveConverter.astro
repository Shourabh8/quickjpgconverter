---
import { type Locale, defaultLocale, isValidLocale } from "@i18n/index";

interface Props {
  targetFormat: string;
  targetExt: string;
  targetMime: string;
  accept: string;
  inputFormat: string;
  outputFormat: string;
  allowFormatSwitch?: boolean;
  locale?: string;
}

const {
  targetFormat,
  targetExt,
  targetMime,
  accept,
  inputFormat,
  outputFormat,
  allowFormatSwitch = false,
  locale = "en",
} = Astro.props;

const activeLocale = (isValidLocale(locale) ? locale : defaultLocale) as Locale;

const uiStrings: Record<Locale, {
