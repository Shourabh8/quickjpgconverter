  optionsTitle: string;
  qualityHigh: string;
  qualityHighDesc: string;
  qualityBalanced: string;
  qualityBalancedDesc: string;
  qualitySmall: string;
  qualitySmallDesc: string;
  outputFormatTitle: string;
  converting: string;
  convertBtnPrefix: string;
  sandboxNote: string;
  descPng: string;
  descJpg: string;
  descWebp: string;
