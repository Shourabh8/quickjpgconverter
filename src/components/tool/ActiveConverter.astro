  pt: {
    chooseFormat: "Escolha o formato de saída:",
    convertToLabel: "Converter para:",
    dropHeadline: `Solte seus arquivos ${inputFormat} aqui`,
    dropSub: "toque para selecionar ou arraste e solte",
    chooseFiles: "Escolher Arquivos",
    maxLimit: `${inputFormat} · Máx. 50MB por arquivo · Múltiplos arquivos`,
    dropOverlay: "Solte para carregar",
    filesReady: "0 arquivos prontos",
    clearAll: "Limpar tudo",
    inputPrefix: "Entrada:",
    outputPrefix: "Saída:",
    optionsTitle: "Opções de Conversão",
    qualityHigh: "Alta Qualidade",
    qualityHighDesc: "Melhor fidelidade visual, arquivo maior",
    qualityBalanced: "Equilibrado",
    qualityBalancedDesc: "Bom equilíbrio entre tamanho e qualidade",
    qualitySmall: "Menor Tamanho",
    qualitySmallDesc: "Arquivo menor, leve perda visual",
    outputFormatTitle: "Formato de Saída",
    converting: "Convertendo...",
    convertBtnPrefix: "Converter para",
    sandboxNote: "Processado localmente no seu navegador sem envios",
    descPng: "Sem perdas · Transparência · Arquivo maior",
    descJpg: "Compatível · Universal · Arquivos menores",
    descWebp: "Moderno · 25-35% menor · Rápido",
  },
  hi: {
    chooseFormat: "आउटपुट फ़ॉर्मेट चुनें:",
    convertToLabel: "कनवर्ट करें:",
    dropHeadline: `अपनी ${inputFormat} फ़ाइलें यहां छोड़ें`,
    dropSub: "चुनने के लिए टैप करें या ड्रैग और ड्रॉप करें",
    chooseFiles: "फ़ाइलें चुनें",
    maxLimit: `${inputFormat} · अधिकतम 50MB प्रति फ़ाइल · एक साथ कई फ़ाइलें`,
