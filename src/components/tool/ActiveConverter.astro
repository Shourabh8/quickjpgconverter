    sandboxNote: "Procesado localmente en tu navegador sin subir archivos",
    descPng: "Sin pérdida · Transparencia · Mayor tamaño",
    descJpg: "Con pérdida · Universal · Archivos más ligeros",
    descWebp: "Moderno · 25-35% más ligero · Rápido",
