  },
  de: {
    chooseFormat: "Zielformat wählen:",
    convertToLabel: "Konvertieren in:",
    dropHeadline: `${inputFormat}-Dateien hier ablegen`,
    dropSub: "zum Durchsuchen tippen oder per Drag-and-Drop",
    chooseFiles: "Dateien auswählen",
    maxLimit: `${inputFormat} · Max. 50 MB pro Datei · Stapelverarbeitung`,
    dropOverlay: "Zum Laden ablegen",
    filesReady: "0 Dateien bereit",
    clearAll: "Alle löschen",
    inputPrefix: "Eingabe:",
    outputPrefix: "Ausgabe:",
    optionsTitle: "Konvertierungsoptionen",
    qualityHigh: "Hohe Qualität",
    qualityHighDesc: "Beste Bildtreue, größere Datei",
    qualityBalanced: "Ausgewogen",
    qualityBalancedDesc: "Gute Balance zwischen Größe und Qualität",
    qualitySmall: "Kleinste Größe",
    qualitySmallDesc: "Kleinste Datei, leichte Kompression",
    outputFormatTitle: "Ausgabeformat",
    converting: "Konvertierung läuft...",
    convertBtnPrefix: "Konvertieren in",
    sandboxNote: "Lokal in Ihrem Browser verarbeitet — kein Server-Upload",
    descPng: "Verlustfrei · Transparenz · Größere Dateien",
    descJpg: "Universell · Kompatibel · Kleinere Dateien",
    descWebp: "Modern · 25-35% kleiner · Schnell",
  },
};

const u = uiStrings[activeLocale];

const conversionOptions = [
  { id: "quality-high", label: u.qualityHigh, desc: u.qualityHighDesc, checked: true },
  { id: "quality-balanced", label: u.qualityBalanced, desc: u.qualityBalancedDesc, checked: false },
  { id: "quality-small", label: u.qualitySmall, desc: u.qualitySmallDesc, checked: false },
];
---

<div
  id="converter-config"
  data-target-format={targetFormat}
  data-target-ext={targetExt}
  data-target-mime={targetMime}
  class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted flex-wrap gap-3">
    <span class="text-sm font-semibold text-text-primary">
      {allowFormatSwitch ? u.chooseFormat : u.convertToLabel}
    </span>
    <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default overflow-x-auto">
      {allowFormatSwitch ? (
        <>
          <button
            type="button"
            data-target-switch
            data-target-format="png"
            data-target-ext="png"
            data-target-mime="image/png"
            class="px-3.5 py-2 min-h-[44px] sm:min-h-0 sm:py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-brand-600 text-white shadow-sm transition-all cursor-pointer"
          >
            PNG
          </button>
          <button
            type="button"
            data-target-switch
            data-target-format="jpg"
            data-target-ext="jpg"
            data-target-mime="image/jpeg"
            class="px-3.5 py-2 min-h-[44px] sm:min-h-0 sm:py-1.5 rounded-lg text-xs sm:text-sm font-medium text-text-secondary hover:text-text-primary transition-all cursor-pointer"
          >
            JPG
          </button>
          <button
            type="button"
            data-target-switch
            data-target-format="webp"
            data-target-ext="webp"
            data-target-mime="image/webp"
            class="px-3.5 py-2 min-h-[44px] sm:min-h-0 sm:py-1.5 rounded-lg text-xs sm:text-sm font-medium text-text-secondary hover:text-text-primary transition-all cursor-pointer"
          >
            WebP
          </button>
          <button
            type="button"
            data-target-switch
            data-target-format="avif"
            data-target-ext="avif"
            data-target-mime="image/avif"
            class="px-3.5 py-2 min-h-[44px] sm:min-h-0 sm:py-1.5 rounded-lg text-xs sm:text-sm font-medium text-text-secondary hover:text-text-primary transition-all cursor-pointer"
          >
            AVIF
          </button>
        </>
      ) : (
        <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">{outputFormat}</span>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[440px]">
    <!-- LEFT: Upload / Preview -->
    <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
      <!-- Upload zone -->
      <div id="upload-zone" class="h-full">
        <div
          id="drop-area"
          class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
        >
          <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">{u.dropHeadline}</h3>
          <p class="text-sm text-text-secondary mb-5 max-w-xs">{u.dropSub}</p>
          <label class="btn-primary btn-md cursor-pointer min-h-[44px]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            {u.chooseFiles}
            <input type="file" class="sr-only" accept={accept} multiple />
          </label>
          <p class="text-xs text-text-tertiary mt-4">{u.maxLimit}</p>
          <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
            <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            <p class="text-base font-semibold text-brand-700 dark:text-brand-300">{u.dropOverlay}</p>
          </div>
        </div>
      </div>

      <!-- Preview zone -->
      <div id="preview-zone" class="hidden h-full">
        <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
          <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-success"></div>
              <span id="file-count" class="text-sm font-medium text-text-primary">{u.filesReady}</span>
            </div>
            <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium min-h-[36px] px-2">{u.clearAll}</button>
          </div>
          <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
          <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
            <span class="text-text-tertiary">{u.inputPrefix} {inputFormat}</span>
            <span class="text-text-tertiary">→</span>
            <span id="output-format-badge" class="text-brand-600 dark:text-brand-400 font-medium">{u.outputPrefix} {outputFormat}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Options + Actions -->
    <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col justify-between">
      <div>
        <h3 class="text-sm font-semibold text-text-primary mb-3">{u.optionsTitle}</h3>
        <div class="space-y-2 mb-6">
          {conversionOptions.map((opt) => (
            <label class:list={[
              "quality-label flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200",
              opt.checked
                ? "border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30"
                : "border-border-default hover:border-border-strong hover:bg-surface-subtle/50"
            ]}>
              <input type="radio" name="quality" value={opt.id} checked={opt.checked} class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-text-primary">{opt.label}</div>
                <div class="text-xs text-text-tertiary mt-0.5">{opt.desc}</div>
              </div>
            </label>
          ))}
        </div>

        <div class="h-px bg-border-default mb-6"></div>

        <h3 class="text-sm font-semibold text-text-primary mb-3">{u.outputFormatTitle}</h3>
        <div class="p-3 rounded-xl border border-border-default bg-surface-muted mb-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-text-primary">{outputFormat}</div>
              <div class="text-xs text-text-tertiary">
                {outputFormat === "PNG" && u.descPng}
                {outputFormat === "JPG" && u.descJpg}
                {outputFormat === "WebP" && u.descWebp}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <!-- Progress -->
        <div id="progress-area" class="hidden mb-4">
          <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">{u.converting}</p>
        </div>

        <!-- Convert button -->
        <div id="convert-btn-area">
          <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed min-h-[48px]" disabled>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            <span id="convert-btn-text">{u.convertBtnPrefix} {outputFormat}</span>
          </button>
          <p class="text-xs text-text-tertiary text-center mt-2">{u.sandboxNote}</p>
        </div>

        <!-- Download area -->
        <div id="download-area" class="hidden"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initConverter } from "@scripts/converter.js";
  document.addEventListener("DOMContentLoaded", () => {
    const configEl = document.getElementById("converter-config");
    if (configEl) {
      const targetFormat = configEl.getAttribute("data-target-format") || "png";
      const targetExt = configEl.getAttribute("data-target-ext") || "png";
      const targetMime = configEl.getAttribute("data-target-mime") || "image/png";
      initConverter({ targetFormat, targetExt, targetMime });
    }

    // Quality selector styling
    const qualityRadios = document.querySelectorAll('input[name="quality"]');
    const qualityLabels = document.querySelectorAll('.quality-label');

    function updateQualityStyles() {
      const isDark = document.documentElement.classList.contains('dark');
      qualityLabels.forEach((label) => {
        const radio = label.querySelector('input[type="radio"]');
        if (radio?.checked) {
          label.style.borderColor = isDark ? '#1d4ed8' : '#60a5fa';
          label.style.backgroundColor = isDark ? 'rgba(59,130,246,0.08)' : '#eff6ff';
        } else {
          label.style.borderColor = '';
          label.style.backgroundColor = '';
        }
      });
    }

    qualityRadios.forEach((radio) => {
      radio.addEventListener('change', updateQualityStyles);
    });

    const observer = new MutationObserver(updateQualityStyles);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    updateQualityStyles();
  });
</script>
