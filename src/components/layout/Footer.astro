---
import { site } from "@data/site";
import { tools } from "@data/tools";
import VisitorCounter from "../ui/VisitorCounter.astro";

const currentYear = new Date().getFullYear();

const toolLinks1 = tools.slice(0, 4);
const toolLinks2 = tools.slice(4);
---

<footer class="border-t border-border-default bg-surface-muted">
  <div class="container-main py-16 lg:py-20">
    <!-- Top section -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 mb-14">
      <!-- Brand column -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Quick JPG Converter logo">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <path d="M9 3v18" />
              <path d="M14 9l3 3-3 3" />
            </svg>
          </div>
          <span class="font-semibold text-[15px] text-text-primary tracking-tight">{site.name}</span>
        </a>
        <p class="text-sm text-text-secondary leading-relaxed max-w-xs mb-5">
          Free online image conversion tools. Convert JPG, PNG, WebP, and PDF
          files instantly in your browser.
        </p>
        <div class="flex items-center gap-2 mb-5">
          <span class="badge-brand">100% Free</span>
          <span class="badge-success">Private</span>
        </div>
        <!-- Newsletter signup -->
        <div class="max-w-xs">
          <p class="text-xs font-semibold text-text-primary mb-2">Stay updated</p>
          <p class="text-xs text-text-tertiary mb-3">New tools and tips. No spam, ever.</p>
          <form id="newsletter-form" class="flex gap-2">
            <input
              type="email"
              id="newsletter-email"
              placeholder="you@example.com"
              required
              class="flex-1 min-w-0 px-3 py-2 text-xs rounded-lg border border-border-default bg-surface text-text-primary placeholder:text-text-tertiary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            />
            <button type="submit" class="px-3 py-2 text-xs font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors whitespace-nowrap">
              Subscribe
            </button>
          </form>
          <p id="newsletter-msg" class="text-xs text-success mt-2 hidden"></p>
        </div>
      </div>

      <!-- Tools column 1 -->
      <div>
        <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4">Convert</h4>
        <ul class="space-y-2.5">
          {toolLinks1.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
              >
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools column 2 -->
      <div>
        <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4">More Tools</h4>
        <ul class="space-y-2.5">
          {toolLinks2.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
              >
                {tool.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/tools" class="text-sm text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 font-medium transition-colors duration-200">
              View all tools →
            </a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/about" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              About
            </a>
          </li>
          <li>
            <a href="/contact" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              Contact
            </a>
          </li>
          <li>
            <a href="/faq" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              FAQ
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="divider mb-6"></div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-tertiary">
        © {currentYear} {site.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <VisitorCounter />
        <span class="text-xs text-text-tertiary">
          Built with Astro
        </span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var countEl = document.getElementById('visitor-count');
  
  function formatNumber(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }
  
  // POST to increment if new user, then display the count
  // Server checks cookie - only increments for truly new unique users
  fetch('/api/visitor', { method: 'POST' })
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (countEl && data.count) {
        countEl.textContent = formatNumber(data.count);
      }
    })
    .catch(function() {
      // Fallback if API fails
      fetch('/api/visitor')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (countEl && d.count) countEl.textContent = formatNumber(d.count);
        })
        .catch(function() {
          if (countEl) countEl.textContent = '95';
        });
    });

  // Newsletter form
  var newsletterForm = document.getElementById('newsletter-form');
  var newsletterEmail = document.getElementById('newsletter-email');
  var newsletterMsg = document.getElementById('newsletter-msg');
  
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = newsletterEmail.value.trim();
      if (!email) return;
      
      // Store in localStorage for now (placeholder until email service is integrated)
      var subscribers = JSON.parse(localStorage.getItem('qjc_subscribers') || '[]');
      if (!subscribers.includes(email)) {
        subscribers.push(email);
        localStorage.setItem('qjc_subscribers', JSON.stringify(subscribers));
      }
      
      newsletterMsg.textContent = "You're subscribed! We'll notify you when we launch new tools.";
      newsletterMsg.classList.remove('hidden');
      newsletterEmail.value = '';
      
      setTimeout(function() {
        newsletterMsg.classList.add('hidden');
      }, 5000);
    });
  }
});
</script>
