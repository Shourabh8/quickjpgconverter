---
import { site } from "@data/site";
import { tools } from "@data/tools";
import VisitorCounter from "../ui/VisitorCounter.astro";
import {
  type Locale,
  locales,
  defaultLocale,
  useTranslations,
  getLocalePrefix,
  getLocalizedPath,
  localeNames,
  localeFlags,
  isValidLocale,
  multilingualRoutes,
} from "@i18n/index";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const activeLocale = (isValidLocale(locale) ? locale : defaultLocale) as Locale;
const prefix = getLocalePrefix(activeLocale);
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();

function getToolUrl(slug: string) {
  if (multilingualRoutes.has(`/${slug}`)) {
    return `${prefix}/${slug}/`;
  }
  return `/${slug}/`;
}

// Categorized tool clusters for PageRank distribution and topical authority
const converterTools = [
  { slug: "jpg-to-png", title: "JPG to PNG" },
  { slug: "png-to-jpg", title: "PNG to JPG" },
  { slug: "webp-to-jpg", title: "WebP to JPG" },
  { slug: "jpg-to-webp", title: "JPG to WebP" },
  { slug: "heic-to-jpg", title: "HEIC to JPG" },
  { slug: "avif-to-jpg", title: "AVIF to JPG" },
  { slug: "svg-to-png", title: "SVG to PNG" },
  { slug: "batch-converter", title: "Batch Converter" },
];

const compressorTools = [
  { slug: "image-compressor", title: "Image Compressor" },
  { slug: "compress-to-100kb", title: "Compress to 100KB" },
  { slug: "compress-to-200kb", title: "Compress to 200KB" },
  { slug: "compress-image-to-50kb", title: "Compress to 50KB" },
  { slug: "compress-image-to-20kb", title: "Compress to 20KB" },
  { slug: "compress-to-size", title: "Compress to Any Size" },
  { slug: "resize-jpg", title: "Resize JPG" },
];

const govtAndPassportTools = [
  { slug: "passport-photo-size", title: "Passport Photo Size" },
  { slug: "passport-photo-size-india", title: "Indian Passport Photo" },
  { slug: "upsc-photo-compressor", title: "UPSC Photo Compressor" },
  { slug: "signature-resizer", title: "Signature Resizer (20KB)" },
  { slug: "aadhar-photo-resize", title: "Aadhaar Photo Resize" },
  { slug: "compress-for-govt-form", title: "Govt Form Compressor" },
];

const pdfAndEditingTools = [
  { slug: "pdf-to-jpg", title: "PDF to JPG" },
  { slug: "jpg-to-pdf", title: "JPG to PDF" },
  { slug: "pdf-compressor", title: "PDF Compressor" },
  { slug: "remove-background", title: "Remove Background AI" },
  { slug: "watermark-image", title: "Watermark Image" },
  { slug: "image-color-picker", title: "Image Color Picker" },
  { slug: "image-enhancer", title: "Image Enhancer" },
  { slug: "exif-viewer", title: "EXIF Viewer & Remover" },
];
---

<footer class="border-t border-border-default bg-surface-muted/80">
  <div class="container-main py-12 sm:py-14 lg:py-18">
    <!-- Top Brand & Newsletter row -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-10 mb-10 border-b border-border-default/60">
      <div class="lg:col-span-5">
        <a href={prefix || "/"} class="flex items-center gap-2.5 mb-3.5">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center shadow-xs">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="QuickJPG logo">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <path d="M9 3v18" />
              <path d="M14 9l3 3-3 3" />
            </svg>
          </div>
          <span class="font-bold text-[16px] text-text-primary tracking-tight">{site.name}</span>
        </a>
        <p class="text-sm text-text-secondary leading-relaxed max-w-md mb-4">
          Free, privacy-first image and PDF conversion utilities. Everything runs 100% client-side in your web browser — no server uploads, no logins, no limits.
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            100% Client-Side Private
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
            Zero File Storage
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-surface border border-border-default text-text-secondary">
            Unlimited Free
          </span>
        </div>
      </div>

      <div class="lg:col-span-7 flex flex-col justify-center">
        <div class="p-4 sm:p-5 rounded-2xl border border-border-default bg-surface/90 shadow-xs max-w-xl lg:ml-auto w-full">
          <h4 class="text-sm font-semibold text-text-primary mb-1">Stay updated with new image tools</h4>
          <p class="text-xs text-text-secondary mb-3">Get notified when new format converters, batch optimizations, and utilities are released.</p>
          <form id="newsletter-form" class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              id="newsletter-email"
              placeholder="Enter your email address"
              required
              class="flex-1 min-w-0 px-3.5 py-2.5 text-xs rounded-xl border border-border-default bg-surface text-text-primary placeholder:text-text-tertiary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all min-h-[44px]"
            />
            <button type="submit" class="px-4 py-2.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl transition-colors whitespace-nowrap shadow-xs min-h-[44px]">
              Subscribe Free
            </button>
          </form>
          <p id="newsletter-msg" class="text-xs text-success mt-2 hidden"></p>
        </div>
      </div>
    </div>

    <!-- 5-Column Topical Directory Grid for Maximum PageRank Distribution -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 sm:gap-8 lg:gap-6 mb-12">
      <!-- Col 1: Converters -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>🔄</span> Image Converters
        </h4>
        <ul class="space-y-2.5">
          {converterTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Compressors -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>🗜️</span> Compression
        </h4>
        <ul class="space-y-2.5">
          {compressorTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Govt & Exam -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>📋</span> Passport & Forms
        </h4>
        <ul class="space-y-2.5">
          {govtAndPassportTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: PDF & Photo Edit -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>🛠️</span> PDF & Editing
        </h4>
        <ul class="space-y-2.5">
          {pdfAndEditingTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Company & Legal -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>ℹ️</span> About & Legal
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href={`${prefix}/about/`} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              About QuickJPG
            </a>
          </li>
          <li>
            <a href="/why-browser-based/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              Why Browser-Based
            </a>
          </li>
          <li>
            <a href="/blog/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              Guides & Blog
            </a>
          </li>
          <li>
            <a href="/faq/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              FAQ
            </a>
          </li>
          <li>
            <a href="/contact/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              Contact & Support
            </a>
          </li>
          <li>
            <a href="/privacy/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              Terms of Service
            </a>
          </li>
          <li>
            <a href="/disclaimer/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              Disclaimer
            </a>
          </li>
          <li>
            <button
              id="open-cookie-settings"
              type="button"
              class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors cursor-pointer text-left inline-block py-0.5"
            >
              Cookie Preferences
            </button>
          </li>
          <li>
            <a
              href="https://policies.google.com/technologies/partner-sites"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5"
            >
              Google Ad Policies ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Global Languages & SEO Hreflang Directory Grid -->
    <div class="py-6 sm:py-8 my-8 border-y border-border-default/60">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold text-text-primary uppercase tracking-wider flex items-center gap-1.5">
            <span>🌐</span> Global Versions & Languages
          </span>
          <p class="text-xs text-text-secondary mt-1 max-w-xl">
            QuickJPG is available worldwide. Convert images & PDFs privately in your browser in your native language:
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
          {locales.map((l) => (
            <a
              href={getLocalizedPath(l, currentPath)}
              hreflang={l}
              class:list={[
                "inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs transition-all min-h-[44px]",
                l === activeLocale
                  ? "bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/30 font-semibold shadow-2xs"
                  : "bg-surface border border-border-default text-text-secondary hover:text-text-primary hover:border-border-strong hover:bg-surface-subtle",
              ]}
            >
              <span class="text-base">{localeFlags[l]}</span>
              <span class="font-medium">{localeNames[l]}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
      <p class="text-xs text-text-tertiary">
        © {currentYear} {site.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <VisitorCounter />
        <span class="text-xs text-text-tertiary">
          100% Client-Side · Private Sandbox
        </span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var countEl = document.getElementById('visitor-count');
  
  function formatNumber(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }
  
  // POST to increment if new user, then display the count
  fetch('/api/visitor', { method: 'POST' })
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (countEl && data.count) {
        countEl.textContent = formatNumber(data.count);
      }
    })
    .catch(function() {
      fetch('/api/visitor')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (countEl && d.count) countEl.textContent = formatNumber(d.count);
        })
        .catch(function() {
          if (countEl) countEl.textContent = '95';
        });
    });

  // Newsletter form
  var newsletterForm = document.getElementById('newsletter-form');
  var newsletterEmail = document.getElementById('newsletter-email');
  var newsletterMsg = document.getElementById('newsletter-msg');
  
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = newsletterEmail.value.trim();
      if (!email) return;
      
      var subscribers = JSON.parse(localStorage.getItem('qjc_subscribers') || '[]');
      if (!subscribers.includes(email)) {
        subscribers.push(email);
        localStorage.setItem('qjc_subscribers', JSON.stringify(subscribers));
      }
      
      newsletterMsg.textContent = "You're subscribed! We'll notify you when we launch new tools.";
      newsletterMsg.classList.remove('hidden');
      newsletterEmail.value = '';
      
      setTimeout(function() {
        newsletterMsg.classList.add('hidden');
      }, 5000);
    });
  }
});
</script>
