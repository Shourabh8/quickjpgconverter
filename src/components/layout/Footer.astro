---
import { site } from "@data/site";
import { tools } from "@data/tools";

const currentYear = new Date().getFullYear();

const toolLinks1 = tools.slice(0, 4);
const toolLinks2 = tools.slice(4);
---

<footer class="border-t border-border-default bg-surface-muted">
  <div class="container-main py-16 lg:py-20">
    <!-- Top section -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 mb-14">
      <!-- Brand column -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Quick JPG Converter logo">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <path d="M9 3v18" />
              <path d="M14 9l3 3-3 3" />
            </svg>
          </div>
          <span class="font-semibold text-[15px] text-text-primary tracking-tight">{site.name}</span>
        </a>
        <p class="text-sm text-text-secondary leading-relaxed max-w-xs mb-5">
          Free online image conversion tools. Convert JPG, PNG, WebP, and PDF
          files instantly in your browser.
        </p>
        <div class="flex items-center gap-2">
          <span class="badge-brand">100% Free</span>
          <span class="badge-success">Private</span>
        </div>
      </div>

      <!-- Tools column 1 -->
      <div>
        <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4">Convert</h4>
        <ul class="space-y-2.5">
          {toolLinks1.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
              >
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools column 2 -->
      <div>
        <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4">More Tools</h4>
        <ul class="space-y-2.5">
          {toolLinks2.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200"
              >
                {tool.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/tools" class="text-sm text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 font-medium transition-colors duration-200">
              View all tools →
            </a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/about" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              About
            </a>
          </li>
          <li>
            <a href="/contact" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              Contact
            </a>
          </li>
          <li>
            <a href="/faq" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              FAQ
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="divider mb-6"></div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-tertiary">
        © {currentYear} {site.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <span class="text-xs text-text-tertiary">
          Built with Astro
        </span>
      </div>
    </div>
  </div>
</footer>
