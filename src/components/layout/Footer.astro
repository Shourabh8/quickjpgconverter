---

<footer class="border-t border-border-default bg-surface-muted/80">
  <div class="container-main py-12 sm:py-14 lg:py-18">
    <!-- Top Brand & Privacy Guarantee Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-10 mb-10 border-b border-border-default/60">
      <div class="lg:col-span-5">
        <a href={prefix ? `${prefix}/` : "/"} class="flex items-center gap-2.5 mb-3.5">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center shadow-xs">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="QuickJPG logo">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <path d="M9 3v18" />
              <path d="M14 9l3 3-3 3" />
            </svg>
          </div>
          <span class="font-bold text-[16px] text-text-primary tracking-tight">{site.name}</span>
        </a>
        <p class="text-sm text-text-secondary leading-relaxed max-w-md mb-4">
          {ft.tagline}
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {ft.badgePrivate}
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
            {ft.badgeNoStorage}
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-surface border border-border-default text-text-secondary">
            {ft.badgeFree}
          </span>
        </div>
      </div>

      <div class="lg:col-span-7 flex flex-col justify-center">
        <div class="p-4 sm:p-5 rounded-2xl border border-border-default bg-surface/90 shadow-xs max-w-xl lg:ml-auto w-full">
          <h4 class="text-sm font-semibold text-text-primary mb-1">{ft.cardTitle}</h4>
          <p class="text-xs text-text-secondary mb-4 leading-relaxed">{ft.cardDesc}</p>
          <div class="flex flex-wrap gap-2.5">
            <a href="/tools/" class="px-4 py-2.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl transition-colors whitespace-nowrap shadow-xs min-h-[44px] inline-flex items-center">
              {ft.browseTools}
            </a>
            <a href="/contact/" class="px-4 py-2.5 text-xs font-semibold text-text-primary bg-surface-subtle hover:bg-surface-muted border border-border-default rounded-xl transition-colors whitespace-nowrap min-h-[44px] inline-flex items-center">
              {ft.contactSupport}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 5-Column Directory Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 sm:gap-8 lg:gap-6 mb-12">
      <!-- Col 1: Converters -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>🔄</span> {ft.colConverters}
        </h4>
        <ul class="space-y-2.5">
          {converterTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Compressors -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>🗜️</span> {ft.colCompression}
        </h4>
        <ul class="space-y-2.5">
          {compressorTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Govt & Exam -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>📋</span> {ft.colPassport}
        </h4>
        <ul class="space-y-2.5">
          {govtAndPassportTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: PDF & Photo Edit -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>🛠️</span> {ft.colPdf}
        </h4>
        <ul class="space-y-2.5">
          {pdfAndEditingTools.map((t) => (
            <li>
              <a href={getToolUrl(t.slug)} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Company & Legal -->
      <div>
        <h4 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3.5 flex items-center gap-1.5">
          <span>ℹ️</span> {ft.colLegal}
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href={`${prefix}/about/`} class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.about}
            </a>
          </li>
          <li>
            <a href="/why-browser-based/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.whyBrowser}
            </a>
          </li>
          <li>
            <a href="/blog/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.guides}
            </a>
          </li>
          <li>
            <a href="/faq/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.faq}
            </a>
          </li>
          <li>
            <a href="/contact/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.contact}
            </a>
          </li>
          <li>
            <a href="/privacy/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.privacy}
            </a>
          </li>
          <li>
            <a href="/terms/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.terms}
            </a>
          </li>
          <li>
            <a href="/disclaimer/" class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5">
              {ft.disclaimer}
            </a>
          </li>
          <li>
            <button
              id="open-cookie-settings"
              type="button"
              class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors cursor-pointer text-left inline-block py-0.5"
            >
              {ft.cookiePrefs}
            </button>
          </li>
          <li>
            <a
              href="https://policies.google.com/technologies/partner-sites"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-block py-0.5"
            >
              {ft.adPolicies} ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Global Languages & SEO Hreflang Directory Grid -->
    <div class="py-6 sm:py-8 my-8 border-y border-border-default/60">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold text-text-primary uppercase tracking-wider flex items-center gap-1.5">
            <span>🌐</span> {ft.globalTitle}
          </span>
          <p class="text-xs text-text-secondary mt-1 max-w-xl">
            {ft.globalDesc}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
          {locales.map((l) => (
            <a
              href={getLocalizedPath(l, currentPath)}
              hreflang={l}
              class:list={[
                "inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs transition-all min-h-[44px]",
                l === activeLocale
                  ? "bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/30 font-semibold shadow-2xs"
                  : "bg-surface border border-border-default text-text-secondary hover:text-text-primary hover:border-border-strong hover:bg-surface-subtle",
              ]}
            >
              <span class="text-base">{localeFlags[l]}</span>
              <span class="font-medium">{localeNames[l]}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
      <p class="text-xs text-text-tertiary">
        © {currentYear} {site.name}. {ft.rights}
      </p>
      <div class="flex items-center gap-4">
        <VisitorCounter />
        <span class="text-xs text-text-tertiary">
          {ft.sandboxTag}
        </span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var countEl = document.getElementById('visitor-count');

  function formatNumber(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  fetch('/api/visitor', { method: 'POST' })
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (countEl && data.count) {
        countEl.textContent = formatNumber(data.count);
      }
    })
    .catch(function() {
      fetch('/api/visitor')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (countEl && d.count) countEl.textContent = formatNumber(d.count);
        })
        .catch(function() {
          if (countEl) countEl.textContent = '95';
        });
    });
});
</script>
