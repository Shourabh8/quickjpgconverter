---
import { site } from "@data/site";
import VisitorCounter from "../ui/VisitorCounter.astro";
import {
  type Locale,
  locales,
  defaultLocale,
  getLocalePrefix,
  getLocalizedPath,
  localeNames,
  localeFlags,
  isValidLocale,
  multilingualRoutes,
} from "@i18n/index";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const activeLocale = (isValidLocale(locale) ? locale : defaultLocale) as Locale;
const prefix = getLocalePrefix(activeLocale);
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();

function getToolUrl(slug: string) {
  if (multilingualRoutes.has(`/${slug}`)) {
    return `${prefix}/${slug}/`;
  }
  return `/${slug}/`;
}

