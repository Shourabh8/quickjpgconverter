---
import { site } from "@data/site";
import Badge from "../ui/Badge.astro";
import { categories } from "@data/tools";

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "About", href: "/about" },
  { label: "FAQ", href: "/faq" },
  { label: "Contact", href: "/contact" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];

const toolCategories = [
  { key: "image-converters" as const, icon: "🔄" },
  { key: "image-compressors" as const, icon: "🗜️" },
  { key: "image-tools" as const, icon: "🛠️" },
  { key: "pdf-converters" as const, icon: "📄" },
  { key: "pdf-tools" as const, icon: "📑" },
];
---

<header class="sticky top-0 z-50 glass border-b border-border-default/60">
  <div class="container-main flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center shadow-sm group-hover:shadow-glow transition-shadow duration-300">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Quick JPG Converter logo">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <path d="M9 3v18" />
          <path d="M14 9l3 3-3 3" />
        </svg>
      </div>
      <span class="font-semibold text-[15px] text-text-primary hidden sm:block tracking-tight">
        {site.name}
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-0.5">
      <!-- Tools Dropdown -->
      <div class="relative" id="tools-dropdown">
        <a
          href="/tools"
          aria-current={currentPath.startsWith("/tools") ? "page" : undefined}
          class:list={[
            "px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-200 inline-flex items-center gap-1",
            currentPath.startsWith("/tools")
              ? "text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50"
              : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
          ]}
        >
          Tools
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div
          id="tools-menu"
          class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible translate-y-1 transition-all duration-200 z-50"
        >
          <div class="bg-surface rounded-xl border border-border-default shadow-xl p-2">
            {toolCategories.map(({ key, icon }) => (
              <a
                href={`/tools#${key}`}
                class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-surface-subtle transition-colors"
              >
                <span class="text-base">{icon}</span>
                <div>
                  <div class="font-medium">{categories[key].title}</div>
                  <div class="text-xs text-text-tertiary">{categories[key].description}</div>
                </div>
              </a>
            ))}
            <div class="border-t border-border-default mt-2 pt-2">
              <a
                href="/tools"
                class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-950/50 transition-colors"
              >
                <span class="text-base">📋</span>
                View All Tools
              </a>
            </div>
          </div>
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
          class:list={[
            "px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-200",
            currentPath.startsWith(link.href)
              ? "text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50"
              : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="btn-ghost btn-icon w-9 h-9"
        aria-label="Toggle dark mode"
        type="button"
      >
        <svg class="w-[18px] h-[18px] hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <svg class="w-[18px] h-[18px] block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <!-- CTA -->
      <a href="/" class="btn-primary btn-sm hidden sm:inline-flex">
        Start Converting
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden btn-ghost btn-icon w-9 h-9"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="md:hidden hidden border-t border-border-default bg-surface"
  >
    <div class="container-main py-4 flex flex-col gap-1">
      <!-- Tools Section -->
      <div class="px-3 py-2">
        <div class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-2">Tools</div>
        <div class="grid grid-cols-2 gap-1">
          {toolCategories.map(({ key, icon }) => (
            <a
              href={`/tools#${key}`}
              class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs text-text-secondary hover:text-text-primary hover:bg-surface-subtle transition-colors"
            >
              <span>{icon}</span>
              <span>{categories[key].title}</span>
            </a>
          ))}
        </div>
        <a href="/tools" class="mt-2 text-xs font-medium text-brand-600 dark:text-brand-400 hover:underline">View All Tools →</a>
      </div>

      <div class="border-t border-border-default my-2"></div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200",
            currentPath.startsWith(link.href)
              ? "text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50"
              : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href="/" class="btn-primary btn-sm mt-2 justify-center">
        Start Converting
      </a>
    </div>
  </nav>
</header>

<script>
  // Mobile menu
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const firstLink = menu?.querySelector("a") as HTMLElement | null;

  function openMenu() {
    menu?.classList.remove("hidden");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    firstLink?.focus();
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.focus();
  }

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu?.classList.contains("hidden")) {
      closeMenu();
    }
  });

  // Tools dropdown
  const toolsDropdown = document.getElementById("tools-dropdown");
  const toolsMenu = document.getElementById("tools-menu");
  let toolsTimeout: ReturnType<typeof setTimeout>;

  toolsDropdown?.addEventListener("mouseenter", () => {
    clearTimeout(toolsTimeout);
    toolsMenu?.classList.remove("opacity-0", "invisible", "translate-y-1");
    toolsMenu?.classList.add("opacity-100", "visible", "translate-y-0");
  });

  toolsDropdown?.addEventListener("mouseleave", () => {
    toolsTimeout = setTimeout(() => {
      toolsMenu?.classList.add("opacity-0", "invisible", "translate-y-1");
      toolsMenu?.classList.remove("opacity-100", "visible", "translate-y-0");
    }, 150);
  });

  // Dark mode (single source of truth — no duplication)
  const themeToggle = document.getElementById("theme-toggle");
  const html = document.documentElement;

  themeToggle?.addEventListener("click", () => {
    html.classList.toggle("dark");
    const isDark = html.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
