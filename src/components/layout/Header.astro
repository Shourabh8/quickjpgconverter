---
import { site } from "@data/site";
import { categories } from "@data/tools";
import {
  type Locale,
  locales,
  defaultLocale,
  useTranslations,
  getLocalePrefix,
  getLocalizedPath,
  localeNames,
  localeFlags,
  isValidLocale,
} from "@i18n/index";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const activeLocale = (isValidLocale(locale) ? locale : defaultLocale) as Locale;
const t = useTranslations(activeLocale);
const prefix = getLocalePrefix(activeLocale);
const currentPath = Astro.url.pathname;

const faqLabels: Record<Locale, string> = {
  en: "FAQ",
  es: "Preguntas",
  de: "FAQ",
  fr: "FAQ",
  hi: "सवाल-जवाब",
  pt: "Dúvidas",
};

const selectLanguageLabel: Record<Locale, string> = {
  en: "Select Language",
  es: "Elegir idioma",
  de: "Sprache wählen",
  fr: "Choisir la langue",
  hi: "भाषा चुनें",
  pt: "Selecionar idioma",
};

const localizedCategories: Record<Locale, Record<"image-converters" | "image-compressors" | "image-tools" | "pdf-converters" | "pdf-tools", { title: string; description: string }>> = {
  en: {
    "image-converters": { title: categories["image-converters"].title, description: categories["image-converters"].description },
    "image-compressors": { title: categories["image-compressors"].title, description: categories["image-compressors"].description },
    "image-tools": { title: categories["image-tools"].title, description: categories["image-tools"].description },
    "pdf-converters": { title: categories["pdf-converters"].title, description: categories["pdf-converters"].description },
    "pdf-tools": { title: categories["pdf-tools"].title, description: categories["pdf-tools"].description },
  },
  es: {
    "image-converters": { title: "Conversores", description: "JPG, PNG, WebP, HEIC y AVIF" },
    "image-compressors": { title: "Compresores", description: "Reduce el tamaño a KB exactos" },
    "image-tools": { title: "Herramientas", description: "Redimensionar, pasaporte y Base64" },
    "pdf-converters": { title: "Conversores PDF", description: "Entre imágenes y documentos PDF" },
    "pdf-tools": { title: "Herramientas PDF", description: "Comprimir y mejorar archivos PDF" },
  },
  pt: {
    "image-converters": { title: "Conversores", description: "JPG, PNG, WebP, HEIC e AVIF" },
    "image-compressors": { title: "Compressores", description: "Reduza para tamanhos em KB exatos" },
    "image-tools": { title: "Ferramentas", description: "Redimensionar, passaporte e Base64" },
    "pdf-converters": { title: "Conversores PDF", description: "Entre imagens e documentos PDF" },
    "pdf-tools": { title: "Ferramentas PDF", description: "Comprimir e otimizar PDFs" },
  },
  hi: {
    "image-converters": { title: "इमेज कनवर्टर", description: "JPG, PNG, WebP, HEIC और AVIF" },
    "image-compressors": { title: "इमेज कंप्रेसर", description: "फ़ाइल साइज 20KB–200KB तक कम करें" },
    "image-tools": { title: "इमेज टूल्स", description: "रीसाइज़, पासपोर्ट फोटो और Base64" },
    "pdf-converters": { title: "PDF कनवर्टर", description: "इमेज और PDF के बीच बदलें" },
    "pdf-tools": { title: "PDF टूल्स", description: "PDF कंप्रेस और बेहतर बनाएं" },
  },
  fr: {
    "image-converters": { title: "Convertisseurs", description: "JPG, PNG, WebP, HEIC et AVIF" },
    "image-compressors": { title: "Compresseurs", description: "Réduire à la taille en Ko exacte" },
    "image-tools": { title: "Outils Image", description: "Redimensionner, passeport et Base64" },
    "pdf-converters": { title: "Convertisseurs PDF", description: "Entre images et documents PDF" },
    "pdf-tools": { title: "Outils PDF", description: "Compresser et améliorer des PDF" },
  },
  de: {
    "image-converters": { title: "Bildkonverter", description: "JPG, PNG, WebP, HEIC und AVIF" },
    "image-compressors": { title: "Komprimierer", description: "Bildgröße gezielt in KB reduzieren" },
    "image-tools": { title: "Bildwerkzeuge", description: "Größe ändern, Passbild & Base64" },
    "pdf-converters": { title: "PDF-Konverter", description: "Zwischen Bildern und PDFs wechseln" },
    "pdf-tools": { title: "PDF-Werkzeuge", description: "PDFs komprimieren und optimieren" },
  },
};

const navLinks = [
  {
    label:
      activeLocale === "es"
        ? "Por qué"
        : activeLocale === "de"
        ? "Warum"
        : activeLocale === "fr"
        ? "Pourquoi"
        : activeLocale === "hi"
        ? "क्यों"
        : activeLocale === "pt"
        ? "Por que"
        : "Why",
    href: "/why-browser-based/",
  },
  {
    label:
      activeLocale === "es"
        ? "Blog"
        : activeLocale === "de"
        ? "Ratgeber"
        : activeLocale === "fr"
        ? "Guides"
        : activeLocale === "hi"
        ? "गाइड"
        : activeLocale === "pt"
        ? "Guias"
        : "Blog",
    href: "/blog/",
  },
  { label: t.nav?.about || "About", href: `${prefix}/about/` },
  { label: faqLabels[activeLocale], href: "/faq/" },
  { label: t.nav?.privacy || "Privacy", href: "/privacy/" },
  { label: t.nav?.contact || "Contact", href: "/contact/" },
];

const toolCategories = [
  { key: "image-converters" as const, icon: "🔄" },
  { key: "image-compressors" as const, icon: "🗜️" },
  { key: "image-tools" as const, icon: "🛠️" },
  { key: "pdf-converters" as const, icon: "📄" },
  { key: "pdf-tools" as const, icon: "📑" },
];
---

<header class="sticky top-0 z-50 glass border-b border-border-default/50">
  <div class="container-main flex items-center justify-between h-14 sm:h-16">
    <!-- Logo -->
    <a href={prefix || "/"} class="flex items-center gap-2 group shrink-0">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-sm group-hover:shadow-glow transition-all duration-300">
        <svg class="w-4.5 h-4.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="QuickJPG logo">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <path d="M9 3v18" />
          <path d="M14 9l3 3-3 3" />
        </svg>
      </div>
      <span class="font-semibold text-[15px] text-text-primary tracking-tight">
        {site.name}
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-0.5">
      <!-- Tools Dropdown -->
      <div class="relative" id="tools-dropdown">
        <a
          href="/tools/"
          aria-current={currentPath.startsWith("/tools") ? "page" : undefined}
          class:list={[
            "px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-200 inline-flex items-center gap-1",
            currentPath.startsWith("/tools")
              ? "text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50"
              : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
          ]}
        >
          {t.nav?.tools || "Tools"}
          <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div
          id="tools-menu"
          class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible translate-y-1 transition-all duration-200 z-50"
        >
          <div class="bg-surface rounded-xl border border-border-default shadow-xl p-1.5">
            {toolCategories.map(({ key, icon }) => (
              <a
                href={`/tools/#${key}`}
                class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-surface-subtle transition-colors"
              >
                <span class="text-base">{icon}</span>
                <div>
                  <div class="font-medium text-[13px]">{localizedCategories[activeLocale][key].title}</div>
                  <div class="text-[11px] text-text-tertiary">{localizedCategories[activeLocale][key].description}</div>
                </div>
              </a>
            ))}
            <div class="border-t border-border-default mt-1.5 pt-1.5">
              <a
                href="/tools/"
                class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-950/50 transition-colors"
              >
                <span class="text-base">📋</span>
                {t.nav?.viewAllTools || "View All Tools"}
              </a>
            </div>
          </div>
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
          class:list={[
            "px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-200",
            currentPath.startsWith(link.href)
              ? "text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50"
              : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Desktop Language Dropdown -->
      <div class="relative hidden sm:block" id="lang-dropdown">
        <button
          id="lang-dropdown-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={selectLanguageLabel[activeLocale]}
          class="btn-ghost px-2.5 py-1.5 h-9 rounded-lg text-xs font-medium inline-flex items-center gap-1.5 border border-border-default/80 hover:bg-surface-subtle transition-all cursor-pointer"
        >
          <span class="text-base leading-none">{localeFlags[activeLocale]}</span>
          <span class="hidden lg:inline text-text-primary font-medium">{localeNames[activeLocale]}</span>
          <span class="lg:hidden text-text-primary font-semibold uppercase">{activeLocale}</span>
          <svg class="w-3 h-3 opacity-60 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="lang-dropdown-menu"
          class="absolute right-0 top-full pt-2 w-48 opacity-0 invisible translate-y-1 transition-all duration-200 z-50"
        >
          <div class="bg-surface rounded-xl border border-border-default shadow-xl p-1.5">
            <div class="px-3 py-1.5 text-[10px] font-bold text-text-tertiary uppercase tracking-wider border-b border-border-default/60 mb-1">
              {selectLanguageLabel[activeLocale]}
            </div>
            {locales.map((l) => (
              <a
                href={getLocalizedPath(l, currentPath)}
                hreflang={l}
                class:list={[
                  "flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors",
                  l === activeLocale
                    ? "bg-brand-50 dark:bg-brand-950/50 text-brand-600 dark:text-brand-400 font-semibold"
                    : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
                ]}
              >
                <span class="flex items-center gap-2">
                  <span class="text-base">{localeFlags[l]}</span>
                  <span>{localeNames[l]}</span>
                </span>
                {l === activeLocale && (
                  <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="btn-ghost btn-icon w-9 h-9"
        aria-label="Toggle dark mode"
        type="button"
      >
        <svg class="w-[18px] h-[18px] hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <svg class="w-[18px] h-[18px] block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <!-- CTA -->
      <a href={prefix || "/"} class="btn-primary btn-sm hidden md:inline-flex">
        {t.nav?.startConverting || "Start Converting"}
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden btn-ghost btn-icon w-9 h-9"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="md:hidden hidden border-t border-border-default bg-surface max-h-[calc(100dvh-3.5rem)] overflow-y-auto"
  >
    <div class="container-main py-4 flex flex-col gap-2">
      <!-- Mobile Language Selector Section -->
      <div class="p-3 bg-surface-subtle/80 rounded-xl border border-border-default/70">
        <div class="text-[11px] font-semibold text-text-tertiary uppercase tracking-wider mb-2.5 flex items-center justify-between">
          <span class="flex items-center gap-1.5">
            <span>🌐</span>
            <span>
              {activeLocale === "es"
                ? "Idioma"
                : activeLocale === "de"
                ? "Sprache"
                : activeLocale === "fr"
                ? "Langue"
                : activeLocale === "hi"
                ? "भाषा चुनें"
                : activeLocale === "pt"
                ? "Idioma"
                : "Select Language"}
            </span>
          </span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 font-bold uppercase">
            {activeLocale}
          </span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
          {locales.map((l) => (
            <a
              href={getLocalizedPath(l, currentPath)}
              hreflang={l}
              class:list={[
                "flex items-center gap-2 px-3 py-2.5 rounded-lg text-xs font-medium transition-all min-h-[44px]",
                l === activeLocale
                  ? "bg-brand-600 text-white font-semibold shadow-xs"
                  : "bg-surface border border-border-default text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
              ]}
            >
              <span class="text-base">{localeFlags[l]}</span>
              <span class="truncate">{localeNames[l]}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Tools Section -->
      <div class="px-3 py-2">
        <div class="text-[10px] font-semibold text-text-tertiary uppercase tracking-wider mb-2">
          {t.nav?.tools || "Tools"}
        </div>
        <div class="grid grid-cols-2 gap-1.5">
          {toolCategories.map(({ key, icon }) => (
            <a
              href={`/tools/#${key}`}
              class="flex items-center gap-2 px-2.5 py-2 rounded-lg text-xs text-text-secondary hover:text-text-primary hover:bg-surface-subtle transition-colors min-h-[44px]"
            >
              <span class="text-base">{icon}</span>
              <span class="truncate">{localizedCategories[activeLocale][key].title}</span>
            </a>
          ))}
        </div>
        <a href="/tools/" class="inline-flex items-center gap-1 mt-2.5 text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline min-h-[44px]">
          {t.nav?.viewAllTools || "View All Tools"} →
        </a>
      </div>

      <div class="border-t border-border-default my-1"></div>

      <!-- Main Navigation Links -->
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 min-h-[44px] flex items-center",
            currentPath.startsWith(link.href)
              ? "text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50"
              : "text-text-secondary hover:text-text-primary hover:bg-surface-subtle",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/terms/"
        class="px-3 py-2.5 rounded-lg text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-surface-subtle transition-colors min-h-[44px] flex items-center"
      >
        {activeLocale === "es"
          ? "Términos de Servicio"
          : activeLocale === "de"
          ? "Nutzungsbedingungen"
          : activeLocale === "fr"
          ? "Conditions d'utilisation"
          : activeLocale === "hi"
          ? "सेवा की शर्तें"
          : activeLocale === "pt"
          ? "Termos de Serviço"
          : "Terms of Service"}
      </a>

      <!-- Mobile CTA -->
      <a href={prefix || "/"} class="btn-primary btn-md mt-2 justify-center w-full min-h-[48px]">
        {t.nav?.startConverting || "Start Converting"}
      </a>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const firstLink = menu?.querySelector("a") as HTMLElement | null;

  function openMenu() {
    menu?.classList.remove("hidden");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    firstLink?.focus();
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.focus();
  }

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Desktop Language Dropdown toggle & click outside
  const langDropdown = document.getElementById("lang-dropdown");
  const langBtn = document.getElementById("lang-dropdown-btn");
  const langMenu = document.getElementById("lang-dropdown-menu");

  function openLangMenu() {
    langMenu?.classList.remove("opacity-0", "invisible", "translate-y-1");
    langMenu?.classList.add("opacity-100", "visible", "translate-y-0");
    langBtn?.setAttribute("aria-expanded", "true");
  }

  function closeLangMenu() {
    langMenu?.classList.add("opacity-0", "invisible", "translate-y-1");
    langMenu?.classList.remove("opacity-100", "visible", "translate-y-0");
    langBtn?.setAttribute("aria-expanded", "false");
  }

  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = langBtn.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeLangMenu();
    } else {
      openLangMenu();
    }
  });

  // Close menus on outside click or Escape
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (langDropdown && !langDropdown.contains(target)) {
      closeLangMenu();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (!menu?.classList.contains("hidden")) {
        closeMenu();
      }
      closeLangMenu();
    }
  });

  // Tools dropdown (desktop hover)
  const toolsDropdown = document.getElementById("tools-dropdown");
  const toolsMenu = document.getElementById("tools-menu");
  let toolsTimeout: ReturnType<typeof setTimeout>;

  toolsDropdown?.addEventListener("mouseenter", () => {
    clearTimeout(toolsTimeout);
    toolsMenu?.classList.remove("opacity-0", "invisible", "translate-y-1");
    toolsMenu?.classList.add("opacity-100", "visible", "translate-y-0");
  });

  toolsDropdown?.addEventListener("mouseleave", () => {
    toolsTimeout = setTimeout(() => {
      toolsMenu?.classList.add("opacity-0", "invisible", "translate-y-1");
      toolsMenu?.classList.remove("opacity-100", "visible", "translate-y-0");
    }, 150);
  });

  // Dark mode
  const themeToggle = document.getElementById("theme-toggle");
  const html = document.documentElement;

  themeToggle?.addEventListener("click", () => {
    html.classList.toggle("dark");
    const isDark = html.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
