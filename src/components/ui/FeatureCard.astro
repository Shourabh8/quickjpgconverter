---
import Badge from "./Badge.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
  badge?: string;
  class?: string;
}

const { icon, title, description, badge, class: className } = Astro.props;
---

<div class:list={["card-hover p-6 sm:p-7 group", className]}>
  <div class="flex items-start gap-4 mb-4">
    <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center text-xl border border-brand-100 dark:border-brand-900/50 group-hover:scale-110 transition-transform duration-300">
      {icon}
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <h3 class="font-semibold text-text-primary group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
          {title}
        </h3>
        {badge && <Badge>{badge}</Badge>}
      </div>
    </div>
  </div>
  <p class="text-sm text-text-secondary leading-relaxed pl-[3.25rem]">
    {description}
  </p>
</div>
