---
import Container from "@components/ui/Container.astro";

export interface Props {
  toolName: string;
}

const { toolName } = Astro.props;

const email = "supportquickjpgconverter@gmail.com";
const subject = `Feature Request: ${toolName}`;
const body = `Hi,\n\nI'd like to suggest a feature or improvement for the ${toolName} tool:\n\n[Describe your feature request here]\n\nThanks!`;

const gmailLink = `https://mail.google.com/mail/?view=cm&fs=1&to=${email}&subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<section class="section bg-surface-muted">
  <Container>
    <div class="max-w-2xl mx-auto text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/50 border border-brand-100 dark:border-brand-900/50 mb-4">
        <svg class="w-6 h-6 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
        </svg>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-text-primary tracking-tight mb-2">Have a Feature Request?</h2>
      <p class="text-sm sm:text-base text-text-secondary mb-6 max-w-lg mx-auto">
        We're always looking to improve. Tell us what features you'd like to see in the <strong>{toolName}</strong> tool.
      </p>
      <a
        href={gmailLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-600 text-white font-medium hover:bg-brand-700 transition-colors duration-200 shadow-md shadow-brand-600/20"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        Suggest a Feature
      </a>
    </div>
  </Container>
</section>
