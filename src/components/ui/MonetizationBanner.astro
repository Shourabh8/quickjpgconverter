---
interface Props {
  slotId?: string;
  format?: "horizontal" | "rectangle" | "auto";
  class?: string;
}

const { slotId, format = "auto", class: className = "" } = Astro.props;
---

<div class:list={["monetization-wrapper my-8 w-full max-w-4xl mx-auto", className]}>
  <div class="relative overflow-hidden rounded-2xl border border-border-default/80 bg-surface/80 backdrop-blur-md shadow-xs p-4 sm:p-5 transition-all duration-300 hover:border-brand-300 dark:hover:border-brand-700">
    <div class="flex items-center justify-between pb-2 mb-3 border-b border-border-default/50 text-[11px] uppercase tracking-wider text-text-tertiary font-semibold">
      <span>Sponsored & Recommended</span>
      <span class="inline-flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Verified Tool Partner
      </span>
    </div>

    <!-- Ad Unit Container (When AdSense or programmatic script is connected) -->
    {slotId ? (
      <div class="ad-container min-h-[90px] flex items-center justify-center text-center">
        <!-- Google AdSense Unit -->
        <ins
          class="adsbygoogle block"
          style="display:block"
          data-ad-client="ca-pub-9952773938458145"
          data-ad-slot={slotId}
          data-ad-format={format}
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    ) : (
      <!-- High-RPM Native Partner / Affiliate Card Fallback -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
        <div class="md:col-span-2 flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500 to-accent-600 flex items-center justify-center text-white text-xl shadow-md shrink-0">
            ✨
          </div>
          <div>
            <h4 class="text-sm font-semibold text-text-primary">Need Professional Photo Editing & Batch Magic?</h4>
            <p class="text-xs text-text-secondary mt-0.5 leading-relaxed">
              Remove backgrounds with AI, design banners, resize bulk assets for Shopify/Amazon, and create watermark graphics in seconds.
            </p>
          </div>
        </div>
        <div class="flex justify-start md:justify-end">
          <a
            href="/tools/"
            class="btn-primary btn-sm w-full md:w-auto text-xs py-2 px-4 shadow-sm hover:shadow-glow transition-all"
          >
            Explore Free Pro Tools
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    )}
  </div>
</div>
