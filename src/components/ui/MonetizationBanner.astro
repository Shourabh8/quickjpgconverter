---
interface Props {
  slotId?: string;
  format?: "horizontal" | "rectangle" | "auto";
  class?: string;
}

const { slotId, format = "auto", class: className = "" } = Astro.props;
---

{slotId && (
  <div class:list={["monetization-wrapper my-8 w-full max-w-4xl mx-auto min-h-[140px]", className]} style="contain: layout; contain-intrinsic-size: 140px;">
    <div class="relative overflow-hidden rounded-2xl border border-border-default/80 bg-surface/80 backdrop-blur-md shadow-xs p-4 sm:p-5 transition-all duration-300 hover:border-brand-300 dark:hover:border-brand-700">
      <div class="flex items-center justify-between pb-2 mb-3 border-b border-border-default/50 text-[11px] uppercase tracking-wider text-text-tertiary font-semibold">
        <span>Advertisement</span>
      </div>

      <div class="ad-container min-h-[90px] flex items-center justify-center text-center">
        <!-- Google AdSense Unit -->
        <ins
          class="adsbygoogle block"
          style="display:block"
          data-ad-client="ca-pub-9952773938458145"
          data-ad-slot={slotId}
          data-ad-format={format}
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    </div>
  </div>
)}
