---
import { cn } from "@lib/utils";

interface Props {
  variant?: "brand" | "accent" | "success" | "neutral";
  class?: string;
}

const { variant = "brand", class: className } = Astro.props;

const variantClass = variant === "accent" ? "badge-accent" : variant === "success" ? "badge-success" : variant === "neutral" ? "badge-neutral" : "badge-brand";
---

<span class:list={[variantClass, className]}>
  <slot />
</span>
