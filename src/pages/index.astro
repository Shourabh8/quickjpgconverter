---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import { site } from "@data/site";
import { tools, categories, getToolsByCategory } from "@data/tools";

import "@styles/homepage.css";

const faqItems = [
  {
    question: "Is this JPG converter really free?",
    answer: "Yes, completely free. No sign-up required, no watermarks, no hidden fees, no usage limits. Convert as many images as you need, every day, forever.",
  },
  {
    question: "Are my images uploaded to a server?",
    answer: "No. All conversion happens directly in your browser using WebAssembly and Canvas API. Your images never leave your device — not even temporarily.",
  },
  {
    question: "What image formats are supported?",
    answer: "We support JPG, JPEG, PNG, WebP, HEIC, and PDF formats. You can convert between any of these combinations, and also resize JPG images to any dimension.",
  },
  {
    question: "Is there a file size limit?",
    answer: "The practical limit is your device's available memory. For most modern devices, you can convert images up to 50MB without any issues.",
  },
  {
    question: "Does it work on mobile devices?",
    answer: "Yes. Our tools are fully responsive and work on any device with a modern web browser — iPhones, Android phones, tablets, and desktops.",
  },
  {
    question: "How is this different from other JPG converters?",
    answer: "Unlike server-based converters, we never upload your files. This means faster conversion, complete privacy, and no file size restrictions from server limitations.",
  },
  {
    question: "What is the best free JPG to PDF converter?",
    answer: "Quick JPG Converter is one of the best free JPG to PDF converters available. It runs entirely in your browser, requires no sign-up, and produces high-quality PDFs from your JPG images instantly.",
  },
  {
    question: "How do I convert JPG to PDF?",
    answer: "Simply go to our JPG to PDF tool, drag and drop your JPG images, and click Convert. Your PDF will be ready to download in seconds. You can add multiple images to create a multi-page PDF.",
  },
  {
    question: "What is the best PNG to JPG converter?",
    answer: "Quick JPG Converter is an excellent PNG to JPG converter. It offers quality control (high, balanced, smallest), batch conversion, and runs entirely in your browser for complete privacy.",
  },
  {
    question: "How do I convert PDF to JPG?",
    answer: "Use our PDF to JPG tool to extract images from PDF files. Upload your PDF, and each page will be converted to a JPG image that you can download individually or as a batch.",
  },
  {
    question: "What is the best HEIC to JPG converter?",
    answer: "Quick JPG Converter supports HEIC to JPG conversion directly in your browser. It's free, requires no uploads, and works on any device with a modern browser. No software installation needed.",
  },
  {
    question: "How do I convert HEIC to JPG?",
    answer: "Go to our HEIC to JPG tool, drag and drop your HEIC files (common on iPhones), and click Convert. Your JPG files will be ready to download instantly. Works on desktop and mobile.",
  },
  {
    question: "How do I compress an image to 100KB?",
    answer: "Use our Compress to 100KB tool. Upload your image, and it will automatically compress to under 100KB while maintaining the best possible quality. Perfect for passport photos, job portals, and government forms.",
  },
  {
    question: "What is the best free image compressor online?",
    answer: "Quick JPG Converter is one of the best free online image compressors. It supports JPG, PNG, WebP, and AVIF formats, offers quality control, and processes images directly in your browser for complete privacy.",
  },
  {
    question: "How do I convert WebP to JPG?",
    answer: "Use our WebP to JPG tool to convert WebP images to JPG format. Simply upload your WebP files, select quality, and download your JPG images. Works on any device with a modern browser.",
  },
  {
    question: "Is this image converter safe to use?",
    answer: "Yes, completely safe. All processing happens locally in your browser. No files are uploaded to any server, so your images remain private and secure. No data is collected or stored.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer: "Yes! All our tools support batch conversion. You can upload multiple images at once and convert them all in a single operation. Download them individually or as a ZIP file.",
  },
  {
    question: "Do I need to install any software?",
    answer: "No installation required. Quick JPG Converter runs entirely in your web browser. Just visit the website, select your tool, and start converting. Works on Windows, Mac, Linux, iPhone, and Android.",
  },
];

const steps = [
  {
    number: "01",
    title: "Upload Images",
    description: "Drag and drop your images or click to browse. Multiple file selections are supported.",
  },
  {
    number: "02",
    title: "Select Settings",
    description: "Choose your desired output format (PNG, JPG, WebP) and adjust the quality level.",
  },
  {
    number: "03",
    title: "Convert & Download",
    description: "Wait milliseconds for local processing, and download your files individually or in one ZIP.",
  },
];

const testimonials = [
  {
    quote: "Finally, an image tool platform that doesn't make me upload my photos to some random server. Game changer for client work and data security.",
    author: "Sarah K.",
    role: "Freelance Photographer",
    rating: 5,
  },
  {
    quote: "We use this daily for our e-commerce product listings. Batch converting PNGs to WebP directly on the computer is insanely fast and saves us hours.",
    author: "Marcus T.",
    role: "E-commerce Manager",
    rating: 5,
  },
  {
    quote: "Highly recommended for students. No registration wall, no annoying trackers, and the PDF conversion creates clean documentation instantly.",
    author: "Dr. Chen",
    role: "Computer Science Professor",
    rating: 5,
  },
];

const trustBadges = [
  { icon: "🛡️", title: "100% Private", desc: "No Server Uploads" },
  { icon: "⚡", title: "Instant", desc: "Local CPU Processing" },
  { icon: "🚫", title: "Zero Ads Walls", desc: "No Account Required" },
  { icon: "🔒", title: "Secure", desc: "Full Browser Sandboxing" },
];
---

<BaseLayout
  title="QuickJPG - Free Browser-Based Online Image Tools Platform"
  description="Convert, compress, and resize JPG, PNG, WebP, HEIC, and PDF files instantly in your browser. Complete privacy, zero server uploads, fast and free."
  canonical={site.url}
  faqItems={faqItems}
  keywords={["jpg converter", "free image platform", "convert jpg to png", "compress image online", "webp converter", "pdf converter", "image resizer", "no upload converter"]}
>
  <!-- ============================================
       SECTION 1: HERO & CONVERTER ABOVE THE FOLD
       ============================================ -->
  <section class="relative overflow-hidden bg-glow pt-16 sm:pt-20 lg:pt-24 pb-12">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-brand-500/5 rounded-full blur-3xl"></div>

    <Container>
      <div class="text-center max-w-3xl mx-auto mb-8">
        <div class="mb-4 animate-fade-in">
          <Badge>✨ Modern 2026 Sandbox Tools</Badge>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-text-primary tracking-tight leading-[1.15] mb-4 animate-fade-in-up">
          Convert & Optimize Images<br />
          <span class="gradient-text">Directly in Your Browser</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto leading-relaxed animate-fade-in-up delay-100">
          Super-fast client-side utilities. Your photos never touch our servers — 100% private and secure image processing.
        </p>
      </div>

      <!-- Working Converter Area -->
      <div class="max-w-5xl mx-auto animate-fade-in-up delay-200">
        <div class="rounded-2xl border border-border-default bg-surface shadow-2xl shadow-brand-500/5 overflow-hidden">
          <!-- Top bar -->
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-semibold text-text-secondary">Browser Converter Console</span>
            <div class="flex items-center gap-1.5 text-xs text-text-tertiary">
              <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span> Sandbox Active
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[400px]">
            <!-- LEFT: Dropzone / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <!-- Upload zone -->
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full min-h-[280px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/20 dark:hover:bg-brand-950/10 cursor-pointer group"
                >
                  <div class="w-14 h-14 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-4 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-7 h-7 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1">Drop images or PDF here</h3>
                  <p class="text-xs text-text-secondary mb-4">or click to browse from your device</p>
                  <label class="btn-primary btn-sm cursor-pointer">
                    Choose Files
                    <input type="file" class="sr-only" accept="image/*,.pdf" multiple />
                  </label>
                  <p class="text-[10px] text-text-tertiary mt-3">Supports JPG, PNG, WebP, HEIC, PDF · Max 50MB per file</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/90 dark:bg-brand-950/40 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-10 h-10 text-brand-500 mb-2 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-sm font-semibold text-brand-700 dark:text-brand-300">Drop files now</p>
                  </div>
                </div>
              </div>

              <!-- Preview zone -->
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-2.5 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-xs font-semibold text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-[10px] text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-3 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[260px] content-start"></div>
                  <div class="px-4 py-2.5 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Source: Uploaded</span>
                    <span class="text-text-tertiary">→</span>
                    <span id="output-format-badge" class="text-brand-600 dark:text-brand-400 font-semibold">Output: PNG</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Controls & Actions -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col justify-between">
              <div>
                <div class="mb-4">
                  <label class="text-xs font-bold text-text-primary uppercase tracking-wider block mb-2">Convert to Format</label>
                  <select id="homepage-target-format" class="field-input w-full cursor-pointer">
                    <option value="png" data-ext="png" data-mime="image/png" selected>PNG (Lossless, Transparent)</option>
                    <option value="jpg" data-ext="jpg" data-mime="image/jpeg">JPG (Highly Compatible)</option>
                    <option value="webp" data-ext="webp" data-mime="image/webp">WebP (Modern, Light Weight)</option>
                  </select>
                </div>

                <div class="mb-5">
                  <label class="text-xs font-bold text-text-primary uppercase tracking-wider block mb-2">Compression Quality</label>
                  <div class="space-y-1.5">
                    <label class="flex items-start gap-2.5 p-2 rounded-lg border border-border-default cursor-pointer hover:bg-surface-subtle transition-all duration-200">
                      <input type="radio" name="quality" value="quality-high" checked class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div>
                        <div class="text-xs font-semibold text-text-primary">High Quality</div>
                        <div class="text-[10px] text-text-tertiary mt-0.5">Best visual clarity, larger size</div>
                      </div>
                    </label>
                    <label class="flex items-start gap-2.5 p-2 rounded-lg border border-border-default cursor-pointer hover:bg-surface-subtle transition-all duration-200">
                      <input type="radio" name="quality" value="quality-balanced" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div>
                        <div class="text-xs font-semibold text-text-primary">Balanced Compression</div>
                        <div class="text-[10px] text-text-tertiary mt-0.5">Perfect size/quality ratio</div>
                      </div>
                    </label>
                  </div>
                </div>
              </div>

              <div>
                <!-- Progress bar -->
                <div id="progress-area" class="hidden mb-3">
                  <div class="w-full h-1.5 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-[10px] text-text-tertiary text-center mt-1">Ready...</p>
                </div>

                <!-- Convert trigger -->
                <div id="convert-btn-area">
                  <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    Convert Files
                  </button>
                  <p class="text-[10px] text-text-tertiary text-center mt-2">All files processed locally via GPU & Canvas</p>
                </div>

                <!-- Download portal -->
                <div id="download-area" class="hidden"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============================================
       SECTION 2: TRUST BADGES
       ============================================ -->
  <section class="py-10 border-y border-border-default/60 bg-surface-muted">
    <Container>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {trustBadges.map((badge) => (
          <div class="flex items-start gap-3.5 p-2">
            <div class="w-10 h-10 rounded-xl bg-surface border border-border-default flex items-center justify-center text-lg flex-shrink-0 shadow-xs">
              {badge.icon}
            </div>
            <div>
              <h4 class="text-xs font-bold text-text-primary tracking-wide uppercase">{badge.title}</h4>
              <p class="text-xs text-text-secondary mt-0.5 leading-relaxed">{badge.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================================
       SECTION 3: TOOL CATEGORIES & NAV
       ============================================ -->
  <section class="section" id="categories">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-14">
        <Badge class="mb-3">Toolbox Overview</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          Explore Our Specialized Toolkits
        </h2>
        <p class="text-sm text-text-secondary leading-relaxed">
          Select from our suite of high-fidelity client-side image editing and document optimization tools.
        </p>
      </div>

      <!-- Categories Selector Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 max-w-5xl mx-auto mb-16">
        {(["image-converters", "image-compressors", "image-tools", "pdf-converters", "pdf-tools"] as const).map((cat) => (
          <a
            href={`#${cat}-section`}
            class="flex flex-col items-center text-center p-5 rounded-2xl border border-border-default bg-surface hover:border-brand-400 dark:hover:border-brand-700 hover:shadow-lg transition-all duration-300 group"
          >
            <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/40 flex items-center justify-center text-xl border border-brand-100 dark:border-brand-900/50 mb-3 group-hover:scale-110 transition-transform duration-300">
              {categories[cat].icon}
            </div>
            <span class="text-xs font-bold text-text-primary uppercase tracking-wide group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {categories[cat].title}
            </span>
          </a>
        ))}
      </div>

      <!-- ============================================
           GRIDS: CONVERSION TOOLS
           ============================================ -->
      <div id="image-converters-section" class="scroll-mt-24 mb-16">
        <div class="flex items-center gap-3 mb-6 border-b border-border-default/60 pb-3">
          <span class="text-2xl">{categories["image-converters"].icon}</span>
          <div>
            <h3 class="text-lg font-bold text-text-primary">{categories["image-converters"].title}</h3>
            <p class="text-xs text-text-secondary">{categories["image-converters"].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {getToolsByCategory("image-converters").map((tool) => (
            <a href={`/tools/${tool.slug}`} class="card-gradient group block p-5">
              <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center text-lg border border-brand-100 dark:border-brand-900/50 group-hover:scale-110 transition-all duration-300">
                  {tool.icon}
                </div>
                <svg class="w-4 h-4 text-text-tertiary group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <h4 class="text-sm font-bold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                {tool.title}
              </h4>
              <p class="text-xs text-text-secondary leading-relaxed mb-3">{tool.description}</p>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-surface-subtle text-text-secondary border border-border-muted">{tool.from}</span>
                <span class="text-[10px] text-text-tertiary">→</span>
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 border border-brand-200 dark:border-brand-800">{tool.to}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- ============================================
           GRIDS: COMPRESSION TOOLS
           ============================================ -->
      <div id="image-compressors-section" class="scroll-mt-24 mb-16">
        <div class="flex items-center gap-3 mb-6 border-b border-border-default/60 pb-3">
          <span class="text-2xl">{categories["image-compressors"].icon}</span>
          <div>
            <h3 class="text-lg font-bold text-text-primary">{categories["image-compressors"].title}</h3>
            <p class="text-xs text-text-secondary">{categories["image-compressors"].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {getToolsByCategory("image-compressors").map((tool) => (
            <a href={`/tools/${tool.slug}`} class="card-gradient group block p-5">
              <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center text-lg border border-brand-100 dark:border-brand-900/50 group-hover:scale-110 transition-all duration-300">
                  {tool.icon}
                </div>
                <svg class="w-4 h-4 text-text-tertiary group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <h4 class="text-sm font-bold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                {tool.title}
              </h4>
              <p class="text-xs text-text-secondary leading-relaxed mb-3">{tool.description}</p>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-surface-subtle text-text-secondary border border-border-muted">{tool.from}</span>
                <span class="text-[10px] text-text-tertiary">→</span>
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 border border-brand-200 dark:border-brand-800">{tool.to}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- ============================================
           GRIDS: IMAGE UTILITY TOOLS
           ============================================ -->
      <div id="image-tools-section" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6 border-b border-border-default/60 pb-3">
          <span class="text-2xl">{categories["image-tools"].icon}</span>
          <div>
            <h3 class="text-lg font-bold text-text-primary">{categories["image-tools"].title}</h3>
            <p class="text-xs text-text-secondary">{categories["image-tools"].description}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {getToolsByCategory("image-tools").map((tool) => (
            <a href={`/tools/${tool.slug}`} class="card-gradient group block p-5">
              <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center text-lg border border-brand-100 dark:border-brand-900/50 group-hover:scale-110 transition-all duration-300">
                  {tool.icon}
                </div>
                <svg class="w-4 h-4 text-text-tertiary group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <h4 class="text-sm font-bold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                {tool.title}
              </h4>
              <p class="text-xs text-text-secondary leading-relaxed mb-3">{tool.description}</p>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-surface-subtle text-text-secondary border border-border-muted">{tool.from}</span>
                <span class="text-[10px] text-text-tertiary">→</span>
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 border border-brand-200 dark:border-brand-800">{tool.to}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ============================================
       SECTION 4: TRANSPARENCY & ACCESSIBILITY (CRO)
       ============================================ -->
  <section class="section bg-surface-muted border-t border-border-default/60">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
