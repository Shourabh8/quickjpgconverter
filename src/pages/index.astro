---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import { site } from "@data/site";
import { tools, categories, getToolsByCategory } from "@data/tools";
import { blogPosts } from "@data/blog";
import { authors, defaultAuthor } from "@data/authors";

import ActiveConverter from "@components/tool/ActiveConverter.astro";

import "@styles/homepage.css";

const featuredGuides = blogPosts.slice(0, 6);

const faqItems = [
  {
    question: "Is this JPG converter really free?",
    answer: "Yes, completely free. No sign-up required, no watermarks, no hidden fees, no usage limits. Convert as many images as you need, every day, forever.",
  },
  {
    question: "Are my images uploaded to a server?",
    answer: "No. All conversion happens directly in your browser using WebAssembly and Canvas API. Your images never leave your device — not even temporarily.",
  },
  {
    question: "What image formats are supported?",
    answer: "We support JPG, JPEG, PNG, WebP, HEIC, and PDF formats. You can convert between any of these combinations, and also resize JPG images to any dimension.",
  },
  {
    question: "Is there a file size limit?",
    answer: "The practical limit is your device's available memory. For most modern devices, you can convert images up to 50MB without any issues.",
  },
  {
    question: "Does it work on mobile devices?",
    answer: "Yes. Our tools are fully responsive and work on any device with a modern web browser — iPhones, Android phones, tablets, and desktops.",
  },
  {
    question: "How is this different from other JPG converters?",
    answer: "Unlike server-based converters, we never upload your files. This means faster conversion, complete privacy, and no file size restrictions from server limitations.",
  },
  {
    question: "What is the best free JPG to PDF converter?",
    answer: "Quick JPG Converter is one of the best free JPG to PDF converters available. It runs entirely in your browser, requires no sign-up, and produces high-quality PDFs from your JPG images instantly.",
  },
  {
    question: "How do I convert JPG to PDF?",
    answer: "Simply go to our JPG to PDF tool, drag and drop your JPG images, and click Convert. Your PDF will be ready to download in seconds. You can add multiple images to create a multi-page PDF.",
  },
  {
    question: "What is the best PNG to JPG converter?",
    answer: "Quick JPG Converter is an excellent PNG to JPG converter. It offers quality control (high, balanced, smallest), batch conversion, and runs entirely in your browser for complete privacy.",
  },
  {
    question: "How do I convert PDF to JPG?",
    answer: "Use our PDF to JPG tool to extract images from PDF files. Upload your PDF, and each page will be converted to a JPG image that you can download individually or as a batch.",
  },
  {
    question: "What is the best HEIC to JPG converter?",
    answer: "Quick JPG Converter supports HEIC to JPG conversion directly in your browser. It's free, requires no uploads, and works on any device with a modern browser. No software installation needed.",
  },
  {
    question: "How do I convert HEIC to JPG?",
    answer: "Go to our HEIC to JPG tool, drag and drop your HEIC files (common on iPhones), and click Convert. Your JPG files will be ready to download instantly. Works on desktop and mobile.",
  },
  {
    question: "How do I compress an image to 100KB?",
    answer: "Use our Compress to 100KB tool. Upload your image, and it will automatically compress to under 100KB while maintaining the best possible quality. Perfect for passport photos, job portals, and government forms.",
  },
  {
    question: "What is the best free image compressor online?",
    answer: "Quick JPG Converter is one of the best free online image compressors. It supports JPG, PNG, WebP, and AVIF formats, offers quality control, and processes images directly in your browser for complete privacy.",
  },
  {
    question: "How do I convert WebP to JPG?",
    answer: "Use our WebP to JPG tool to convert WebP images to JPG format. Simply upload your WebP files, select quality, and download your JPG images. Works on any device with a modern browser.",
  },
  {
    question: "Is this image converter safe to use?",
    answer: "Yes, completely safe. All processing happens locally in your browser. No files are uploaded to any server, so your images remain private and secure. No data is collected or stored.",
  },
  {
    question: "Can I convert multiple images at once?",
    answer: "Yes! All our tools support batch conversion. You can upload multiple images at once and convert them all in a single operation. Download them individually or as a ZIP file.",
  },
  {
    question: "Do I need to install any software?",
    answer: "No installation required. Quick JPG Converter runs entirely in your web browser. Just visit the website, select your tool, and start converting. Works on Windows, Mac, Linux, iPhone, and Android.",
  },
];

const steps = [
  {
    number: "01",
    title: "Select your format",
    description: "Choose what format you want to convert to — PNG, JPG, WebP, PDF, or resize.",
  },
  {
    number: "02",
    title: "Drop your files",
    description: "Drag and drop your images or click to browse. Multiple files supported at once.",
  },
  {
    number: "03",
    title: "Download instantly",
    description: "Your converted files are ready in seconds. Download them individually or as a ZIP.",
  },
];

const comparisonFeatures = [
  { label: "Upload to server required", quickjpg: false, iloveimg: true, freeconvert: true },
  { label: "Privacy risk", quickjpg: false, iloveimg: true, freeconvert: true },
  { label: "File size limits", quickjpg: false, iloveimg: true, freeconvert: true },
  { label: "Signup required", quickjpg: false, iloveimg: false, freeconvert: true },
  { label: "Watermarks on output", quickjpg: false, iloveimg: false, freeconvert: false },
  { label: "Works offline", quickjpg: true, iloveimg: false, freeconvert: false },
  { label: "Unlimited conversions", quickjpg: true, iloveimg: false, freeconvert: false },
  { label: "100% browser-based", quickjpg: true, iloveimg: false, freeconvert: false },
];

const architectureHighlights = [
  {
    metric: "0 KB Uploaded",
    title: "Local Memory Execution",
    detail: "Files are decoded and re-encoded inside browser memory via HTML5 Canvas, OffscreenCanvas, and WebAssembly—never transmitted over the network.",
  },
  {
    metric: "6+ Formats",
    title: "Cross-Format Pipeline",
    detail: "Convert cleanly between JPG, PNG, WebP, HEIC/HEIF, AVIF, and multi-page PDF without installing desktop software or browser extensions.",
  },
  {
    metric: "Verifiable",
    title: "Inspectable in DevTools",
    detail: "Open your browser Network tab during any conversion to verify that zero image bytes leave your computer, phone, or tablet.",
  },
];
---

<BaseLayout
  title="Free Image Converter & JPG Converter Online"
  description="Convert JPG, PNG, WebP, HEIC, and PDF images instantly for free. 100% private in-browser image converter — zero file uploads, no signup, instant batch download."
  canonical={site.url}
  faqItems={faqItems}
>
  <!-- ============================================
       SECTION 1: HERO
       ============================================ -->
  <section class="relative overflow-hidden pt-6 sm:pt-10">
    <!-- Ambient multi-color mesh lighting -->
    <div class="hero-ambient-lighting"></div>

    <Container class="relative pt-10 sm:pt-14 lg:pt-18 pb-14 sm:pb-18 lg:pb-20">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Live Privacy Trust Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 text-xs font-semibold shadow-xs mb-5 backdrop-blur-md animate-fade-in">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>100% In-Browser Privacy</span>
          <span class="text-emerald-400/60">·</span>
          <span>Zero Server Uploads</span>
          <span class="text-emerald-400/60">·</span>
          <span>Free Forever</span>
        </div>

        <!-- Headline: high-volume transactional keyword with trust hook -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-text-primary tracking-tight leading-[1.08] mb-5 animate-fade-in-up">
          Free Image Converter<br />
          <span class="gradient-text">Privately in Your Browser</span>
        </h1>

        <!-- Subheadline: one clear sentence -->
        <p class="text-base sm:text-lg text-text-secondary max-w-2xl mx-auto mb-6 leading-relaxed animate-fade-in-up delay-100">
          Convert JPG, PNG, WebP, HEIC, and PDF files instantly with lossless quality.
          No sign-up, zero server uploads — your images never leave your computer or phone.
        </p>

        <!-- Fast Navigation Quick Shortcuts -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-8 animate-fade-in-up delay-150 text-xs">
          <span class="text-text-tertiary font-medium">Popular shortcuts:</span>
          <a href="/heic-to-jpg/" class="px-3 py-1 rounded-full bg-surface border border-border-default text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">📱 HEIC to JPG</a>
          <a href="/jpg-to-png/" class="px-3 py-1 rounded-full bg-surface border border-border-default text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">🖼️ JPG to PNG</a>
          <a href="/png-to-jpg/" class="px-3 py-1 rounded-full bg-surface border border-border-default text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">📸 PNG to JPG</a>
          <a href="/compress-to-100kb/" class="px-3 py-1 rounded-full bg-surface border border-border-default text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">🎯 Compress to 100KB</a>
          <a href="/pdf-to-jpg/" class="px-3 py-1 rounded-full bg-surface border border-border-default text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">📄 PDF to JPG</a>
          <a href="/remove-background/" class="px-3 py-1 rounded-full bg-surface border border-border-default text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">✂️ Remove BG</a>
        </div>
      </div>

      <!-- Real Universal Interactive Converter Engine in Hero -->
      <div class="mt-4 sm:mt-6 max-w-4xl mx-auto animate-fade-in-up delay-200">
        <ActiveConverter
          targetFormat="png"
          targetExt="png"
          targetMime="image/png"
          accept="image/*,.heic,.heif,.avif,.pdf,.jfif,.cr2,.raw"
          inputFormat="Any Image"
          outputFormat="PNG"
          allowFormatSwitch={true}
        />
      </div>
    </Container>
  </section>

  <!-- ============================================
       SECTION 1b: POPULAR TOOLS (iLovePDF Inspired)
       ============================================ -->
  <section class="section bg-surface-muted/60 relative">
    <Container>
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-600 dark:text-brand-400 text-xs font-semibold mb-3">
          ⚡ Quick Access
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          Popular Tools
        </h2>
        <p class="text-text-secondary max-w-xl mx-auto">
          Most-used tools for photographers, students, applicants, and creators.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        <!-- Passport Photo Size: Amber theme -->
        <a href="/passport-photo-size/" class="card-hover p-5 group hover:border-amber-500/40 hover:shadow-[0_12px_28px_-6px_rgba(245,158,11,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 dark:bg-amber-500/20 flex items-center justify-center text-xl border border-amber-500/20 mb-3 group-hover:scale-110 group-hover:border-amber-500/40 transition-all duration-300">
            <span>📸</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">Passport Photo Size</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Resize photos for passport & visa applications.</p>
        </a>

        <!-- Signature Resizer: Emerald theme -->
        <a href="/signature-resizer/" class="card-hover p-5 group hover:border-emerald-500/40 hover:shadow-[0_12px_28px_-6px_rgba(16,185,129,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 flex items-center justify-center text-xl border border-emerald-500/20 mb-3 group-hover:scale-110 group-hover:border-emerald-500/40 transition-all duration-300">
            <span>✍️</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Signature Resizer</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Compress signatures to 10–20KB for exams.</p>
        </a>

        <!-- Watermark Image: Purple theme -->
        <a href="/watermark-image/" class="card-hover p-5 group hover:border-purple-500/40 hover:shadow-[0_12px_28px_-6px_rgba(139,92,246,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-purple-500/10 dark:bg-purple-500/20 flex items-center justify-center text-xl border border-purple-500/20 mb-3 group-hover:scale-110 group-hover:border-purple-500/40 transition-all duration-300">
            <span>🛡️</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">Watermark Image</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Add text or logo watermarks to photos.</p>
        </a>

        <!-- Color Picker: Cyan theme -->
        <a href="/image-color-picker/" class="card-hover p-5 group hover:border-cyan-500/40 hover:shadow-[0_12px_28px_-6px_rgba(6,182,212,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-cyan-500/10 dark:bg-cyan-500/20 flex items-center justify-center text-xl border border-cyan-500/20 mb-3 group-hover:scale-110 group-hover:border-cyan-500/40 transition-all duration-300">
            <span>🎨</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">Color Picker</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Sample HEX & RGB with 5x zoom loupe.</p>
        </a>

        <!-- Black & White: Indigo theme -->
        <a href="/image-to-black-and-white/" class="card-hover p-5 group hover:border-indigo-500/40 hover:shadow-[0_12px_28px_-6px_rgba(99,102,241,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-indigo-500/10 dark:bg-indigo-500/20 flex items-center justify-center text-xl border border-indigo-500/20 mb-3 group-hover:scale-110 group-hover:border-indigo-500/40 transition-all duration-300">
            <span>🎭</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Black & White</h3>
          <p class="text-sm text-text-secondary leading-relaxed">5 monochrome styles & document scan.</p>
        </a>

        <!-- Compress to 100KB: Emerald theme -->
        <a href="/compress-to-100kb/" class="card-hover p-5 group hover:border-emerald-500/40 hover:shadow-[0_12px_28px_-6px_rgba(16,185,129,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 flex items-center justify-center text-xl border border-emerald-500/20 mb-3 group-hover:scale-110 group-hover:border-emerald-500/40 transition-all duration-300">
            <span>🗜️</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Compress to 100KB</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Reduce any image to under 100KB.</p>
        </a>

        <!-- Compress for Govt Form: Amber theme -->
        <a href="/compress-for-govt-form/" class="card-hover p-5 group hover:border-amber-500/40 hover:shadow-[0_12px_28px_-6px_rgba(245,158,11,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 dark:bg-amber-500/20 flex items-center justify-center text-xl border border-amber-500/20 mb-3 group-hover:scale-110 group-hover:border-amber-500/40 transition-all duration-300">
            <span>📋</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">Compress for Govt Form</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Reduce images for SSC, UPSC forms.</p>
        </a>

        <!-- Photo to Base64: Sky Blue theme -->
        <a href="/photo-to-base64/" class="card-hover p-5 group hover:border-blue-500/40 hover:shadow-[0_12px_28px_-6px_rgba(59,130,246,0.16)] transition-all duration-300">
          <div class="w-11 h-11 rounded-xl bg-blue-500/10 dark:bg-blue-500/20 flex items-center justify-center text-xl border border-blue-500/20 mb-3 group-hover:scale-110 group-hover:border-blue-500/40 transition-all duration-300">
            <span>⚡</span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Photo to Base64</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Convert images to Base64 data strings.</p>
        </a>
      </div>
    </Container>
  </section>

  <!-- ============================================
       SECTION 2: CONVERTER TOOL
       ============================================ -->
  <section class="section" id="converter">
    <Container>
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          Convert Any Format
        </h2>
        <p class="text-text-secondary max-w-xl mx-auto">
          Every tool runs in your browser. No uploads. No waiting. No limits.
        </p>
      </div>

      <div class="space-y-12">
        {(["image-converters", "image-compressors", "image-tools", "pdf-converters", "pdf-tools"] as const).map((cat) => {
          const catTools = getToolsByCategory(cat);
          const catInfo = categories[cat];
          return (
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span class="text-lg">{catInfo.icon}</span>
                <h3 class="text-lg font-semibold text-text-primary">{catInfo.title}</h3>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {catTools.map((tool) => (
                  <a
                    href={`/${tool.slug}/`}
                    class="card-gradient group block p-5 sm:p-6"
                  >
                    <div class="flex items-start justify-between mb-3">
                      <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center text-xl border border-brand-100 dark:border-brand-900/50 group-hover:scale-110 group-hover:shadow-glow transition-all duration-300">
                        {tool.icon}
                      </div>
                      <svg class="w-4 h-4 text-text-tertiary group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </div>
                    <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                      {tool.title}
                    </h3>
                    <p class="text-sm text-text-secondary leading-relaxed mb-3">
                      {tool.description}
                    </p>
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-md bg-surface-subtle text-text-secondary border border-border-muted">
                        {tool.from}
                      </span>
                      <svg class="w-3 h-3 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                      </svg>
                      <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-md bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 border border-brand-200 dark:border-brand-800">
                        {tool.to}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <div class="text-center mt-10">
        <a href="/tools/" class="btn-primary btn-lg">
          View All Tools
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- ============================================
       SECTION 3: FEATURES
       ============================================ -->
  <section class="section">
    <Container>
      <div class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          Private by Default
        </h2>
        <p class="text-text-secondary max-w-2xl mx-auto">
          Most converters upload your files to their servers. Ours doesn't.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Feature 1 -->
        <div class="card-hover p-6 sm:p-7 group">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/10 to-brand-600/10 flex items-center justify-center border border-brand-200/50 dark:border-brand-800/50 mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-2">Zero Server Uploads</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Your images are processed entirely in your browser using the Canvas API.
            They never leave your device — not even for a millisecond.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="card-hover p-6 sm:p-7 group">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/10 to-brand-600/10 flex items-center justify-center border border-brand-200/50 dark:border-brand-800/50 mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-2">Sub-Second Speed</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            No network round-trips. No upload queues. Conversion happens on your
            device in under a second — even for batches of 20+ images.
          </p>
        </div>

        <!-- Feature 3 -->
