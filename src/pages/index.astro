---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Badge from "@components/ui/Badge.astro";
import { site } from "@data/site";
import { tools, categories, getToolsByCategory } from "@data/tools";

import "@styles/homepage.css";

const trustBadges = [
  { icon: "🛡️", title: "100% Private", desc: "No Server Uploads" },
  { icon: "⚡", title: "Instant", desc: "Local CPU Processing" },
  { icon: "🚫", title: "No Limits", desc: "Unlimited Conversions" },
  { icon: "🔒", title: "Secure", desc: "Browser Sandboxing" },
];
---

<BaseLayout
  title="QuickJPG — Free Browser-Based Online Image Tools Platform"
  description="Convert, compress, and resize JPG, PNG, WebP, HEIC, and PDF files instantly in your browser. Complete privacy, zero server uploads, fast and free."
  canonical={site.url}
  keywords={["jpg converter", "free image platform", "convert jpg to png", "compress image online", "webp converter", "pdf converter", "image resizer", "no upload converter"]}
>
  <!-- ============================================
       HERO & CONVERTER
       ============================================ -->
  <section class="relative overflow-hidden bg-mesh pt-16 sm:pt-20 lg:pt-28 pb-16 sm:pb-20">
    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 bg-grid opacity-40"></div>
    <!-- Top gradient glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-500/8 rounded-full blur-3xl"></div>
    <div class="absolute top-20 right-1/4 w-[300px] h-[300px] bg-accent-500/5 rounded-full blur-3xl"></div>

    <Container class="relative">
      <!-- Hero Content -->
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <div class="mb-5 animate-fade-in">
          <Badge>✨ 100% Browser-Based Tools</Badge>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-text-primary tracking-[-0.03em] leading-[1.1] mb-5 animate-fade-in-up">
          Convert & Optimize<br />
          <span class="gradient-text">Images Instantly</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto leading-relaxed animate-fade-in-up delay-100">
          Your photos never leave your device. Fast, private, and free — powered by WebAssembly and Canvas API.
        </p>
      </div>

      <!-- Converter Widget -->
      <div class="max-w-5xl mx-auto animate-fade-in-up delay-200">
        <div class="rounded-2xl border border-border-default bg-surface shadow-2xl shadow-brand-500/5 overflow-hidden">
          <!-- Top bar -->
          <div class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-border-default bg-surface-muted/50">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-text-primary tracking-tight">Image Converter</span>
              <span class="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-success-muted text-[10px] font-medium text-success">
                <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse-soft"></span>
                Active
              </span>
            </div>
            <span class="text-[11px] text-text-tertiary">Local Processing</span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[380px] sm:min-h-[420px]">
            <!-- LEFT: Dropzone / Preview -->
            <div class="lg:col-span-3 p-4 sm:p-5 border-b lg:border-b-0 lg:border-r border-border-default">
              <!-- Upload zone -->
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full min-h-[260px] sm:min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/30 flex flex-col items-center justify-center text-center p-5 transition-all duration-300 hover:border-brand-400 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
                >
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-50 to-brand-100 dark:from-brand-950/50 dark:to-brand-900/30 flex items-center justify-center border border-brand-100 dark:border-brand-800/50 mb-4 group-hover:scale-105 transition-transform duration-300">
                    <svg class="w-7 h-7 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-sm sm:text-base font-semibold text-text-primary mb-1.5">Drop images or PDF here</h3>
                  <p class="text-xs text-text-secondary mb-4">or click to browse from your device</p>
                  <label class="btn-primary btn-sm cursor-pointer">
                    Choose Files
                    <input type="file" class="sr-only" accept="image/*,.pdf" multiple />
                  </label>
                  <p class="text-[10px] text-text-tertiary mt-3">JPG, PNG, WebP, HEIC, PDF · Max 50MB per file</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/90 dark:bg-brand-950/40 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-10 h-10 text-brand-500 mb-2 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-sm font-semibold text-brand-700 dark:text-brand-300">Drop files now</p>
                  </div>
                </div>
              </div>

              <!-- Preview zone -->
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-2.5 border-b border-border-default bg-surface-muted/50">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-xs font-semibold text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-[10px] text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-3 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[240px] sm:max-h-[280px] content-start"></div>
                  <div class="px-4 py-2.5 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Source: Uploaded</span>
                    <span class="text-text-tertiary">→</span>
                    <span id="output-format-badge" class="text-brand-600 dark:text-brand-400 font-semibold">Output: PNG</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Controls & Actions -->
            <div class="lg:col-span-2 p-4 sm:p-5 flex flex-col justify-between bg-surface-muted/20">
              <div>
                <div class="mb-4">
                  <label class="text-[11px] font-semibold text-text-tertiary uppercase tracking-wider block mb-2">Output Format</label>
                  <select id="homepage-target-format" class="field-input w-full cursor-pointer text-sm">
                    <option value="png" data-ext="png" data-mime="image/png" selected>PNG — Lossless</option>
                    <option value="jpg" data-ext="jpg" data-mime="image/jpeg">JPG — Compatible</option>
                    <option value="webp" data-ext="webp" data-mime="image/webp">WebP — Lightweight</option>
                  </select>
                </div>

                <div class="mb-5">
                  <label class="text-[11px] font-semibold text-text-tertiary uppercase tracking-wider block mb-2">Quality</label>
                  <div class="space-y-1.5">
                    <label class="quality-option flex items-start gap-2.5 p-2.5 rounded-lg border border-border-default cursor-pointer transition-all duration-200 hover:border-border-strong">
                      <input type="radio" name="quality" value="quality-high" checked class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div>
                        <div class="text-xs font-semibold text-text-primary">High Quality</div>
                        <div class="text-[10px] text-text-tertiary mt-0.5">Best visual clarity</div>
                      </div>
                    </label>
                    <label class="quality-option flex items-start gap-2.5 p-2.5 rounded-lg border border-border-default cursor-pointer transition-all duration-200 hover:border-border-strong">
                      <input type="radio" name="quality" value="quality-balanced" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div>
                        <div class="text-xs font-semibold text-text-primary">Balanced</div>
                        <div class="text-[10px] text-text-tertiary mt-0.5">Optimal size/quality</div>
                      </div>
                    </label>
                  </div>
                </div>
              </div>

              <div>
                <!-- Progress bar -->
                <div id="progress-area" class="hidden mb-3">
                  <div class="w-full h-1.5 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-gradient-to-r from-brand-500 to-accent-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-[10px] text-text-tertiary text-center mt-1.5">Ready...</p>
                </div>

                <!-- Convert trigger -->
                <div id="convert-btn-area">
                  <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    Convert Files
                  </button>
                  <p class="text-[10px] text-text-tertiary text-center mt-2">Processed locally via Canvas & WebAssembly</p>
                </div>

                <!-- Download portal -->
                <div id="download-area" class="hidden"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============================================
       TRUST BADGES
       ============================================ -->
  <section class="py-8 sm:py-10 border-y border-border-default/50 bg-surface-muted/50">
    <Container>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {trustBadges.map((badge) => (
          <div class="flex items-center gap-3 p-3 sm:p-4 rounded-xl bg-surface border border-border-default/50 shadow-xs">
            <div class="w-9 h-9 rounded-lg bg-surface-muted flex items-center justify-center text-base flex-shrink-0">
              {badge.icon}
            </div>
            <div>
              <h4 class="text-[11px] font-semibold text-text-primary tracking-wide uppercase">{badge.title}</h4>
              <p class="text-[11px] text-text-secondary leading-snug">{badge.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================================
       TOOL CATEGORIES & GRID
       ============================================ -->
  <section class="section" id="categories">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <Badge class="mb-3">Toolbox</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-[-0.02em] mb-3">
          All-in-One Image Tools
        </h2>
        <p class="text-sm text-text-secondary leading-relaxed">
          Every tool runs in your browser. No uploads. No waiting. No limits.
        </p>
      </div>

      <!-- Categories Selector -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 sm:gap-3 max-w-4xl mx-auto mb-12 sm:mb-16">
        {(["image-converters", "image-compressors", "image-tools", "pdf-converters", "pdf-tools"] as const).map((cat) => (
          <a
            href={`#${cat}-section`}
            class="flex flex-col items-center text-center p-4 sm:p-5 rounded-xl border border-border-default bg-surface hover:border-brand-300 dark:hover:border-brand-700 hover:shadow-md transition-all duration-200 group"
          >
            <div class="w-10 h-10 rounded-xl bg-surface-muted flex items-center justify-center text-lg mb-2 group-hover:scale-105 transition-transform duration-200">
              {categories[cat].icon}
            </div>
            <span class="text-[11px] font-semibold text-text-primary uppercase tracking-wide group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {categories[cat].title}
            </span>
          </a>
        ))}
      </div>

      <!-- Tool Grids -->
      {(["image-converters", "image-compressors", "image-tools", "pdf-converters", "pdf-tools"] as const).map((catKey) => (
        <div id={`${catKey}-section`} class="scroll-mt-24 mb-12 sm:mb-16">
          <div class="flex items-center gap-2.5 mb-5 sm:mb-6 border-b border-border-default/50 pb-3">
            <span class="text-lg">{categories[catKey].icon}</span>
            <div>
              <h3 class="text-base font-bold text-text-primary">{categories[catKey].title}</h3>
              <p class="text-[11px] text-text-secondary">{categories[catKey].description}</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
            {getToolsByCategory(catKey).map((tool) => (
              <a href={`/tools/${tool.slug}`} class="card-gradient group block overflow-hidden">
                <!-- Format Conversion Visual -->
                <div class="relative px-4 sm:px-5 pt-4 sm:pt-5 pb-3">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="inline-flex items-center justify-center min-w-[3rem] px-2.5 py-1.5 rounded-lg bg-surface-muted border border-border-default text-[11px] font-bold text-text-secondary tracking-wide">
                        {tool.from}
                      </span>
                      <svg class="w-5 h-5 text-brand-500 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                      </svg>
                      <span class="inline-flex items-center justify-center min-w-[3rem] px-2.5 py-1.5 rounded-lg bg-brand-600 text-[11px] font-bold text-white tracking-wide shadow-sm">
                        {tool.to}
                      </span>
                    </div>
                    <span class="text-lg">{tool.icon}</span>
                  </div>
                </div>
                <!-- Content -->
                <div class="px-4 sm:px-5 pb-4 sm:pb-5">
                  <h4 class="text-sm font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                    {tool.title}
                  </h4>
                  <p class="text-[11px] text-text-secondary leading-relaxed">{tool.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </Container>
  </section>

  <!-- ============================================
       CTA
       ============================================ -->
  <section class="section-sm relative overflow-hidden bg-surface-muted border-t border-border-default/50">
    <Container class="relative">
      <div class="text-center max-w-xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-[-0.02em] mb-3">
          Ready to Convert?
        </h2>
        <p class="text-sm text-text-secondary mb-6">
          No account. No uploads. No limits. Just drag your files above.
        </p>
        <div class="flex items-center justify-center gap-3">
          <Button href="#categories" size="lg" variant="secondary">
            Browse All Tools
          </Button>
          <Button href="/why" size="lg" variant="ghost">
            Why Browser-Based?
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <script>
    import { initConverter } from "@scripts/converter.js";
    document.addEventListener("DOMContentLoaded", () => {
      initConverter({ targetFormat: "png", targetExt: "png", targetMime: "image/png" });

      // Quality selector styling
      const qualityRadios = document.querySelectorAll('input[name="quality"]');
      const qualityOptions = document.querySelectorAll('.quality-option');

      function updateQualityStyles() {
        const isDark = document.documentElement.classList.contains('dark');
        qualityOptions.forEach((option) => {
          const radio = option.querySelector('input[type="radio"]');
          if (radio?.checked) {
            option.style.borderColor = isDark ? '#1d4ed8' : '#60a5fa';
            option.style.backgroundColor = isDark ? 'rgba(59,130,246,0.08)' : '#eff6ff';
          } else {
            option.style.borderColor = '';
            option.style.backgroundColor = '';
          }
        });
      }

      qualityRadios.forEach((radio) => {
        radio.addEventListener('change', updateQualityStyles);
      });

      // Also update when dark mode toggles
      const observer = new MutationObserver(updateQualityStyles);
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

      // Set initial state
      updateQualityStyles();
    });
  </script>
</BaseLayout>
