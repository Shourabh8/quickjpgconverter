---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "Passport Photo Size", url: "/passport-photo-size" },
];

const faqItems = [
  {
    question: "What is the standard passport photo size?",
    answer: "The standard passport photo size is 35mm x 45mm (3.5cm x 4.5cm) for most countries including India, USA, UK, and EU countries. In pixels, this is approximately 413 x 531 pixels at 300 DPI.",
  },
  {
    question: "What is the passport photo size in KB?",
    answer: "Most government portals require passport photos between 20KB to 100KB. Indian passport applications typically require 10-50KB, while US passport applications allow up to 600KB.",
  },
  {
    question: "What is the passport photo background color?",
    answer: "Most countries require a plain white or off-white background. Some countries like India accept light blue backgrounds for certain applications.",
  },
  {
    question: "How do I resize my photo to passport size?",
    answer: "Use our free online tool above. Simply upload your photo, and it will automatically resize to the correct passport dimensions. You can also compress it to meet file size requirements.",
  },
];

const passportSizes = [
  { country: "India", size: "35mm × 45mm", pixels: "413 × 531", kb: "10-50 KB", bg: "White" },
  { country: "USA", size: "2in × 2in", pixels: "600 × 600", kb: "Up to 600 KB", bg: "White" },
  { country: "UK", size: "35mm × 45mm", pixels: "413 × 531", kb: "Up to 10 MB", bg: "White/Grey" },
  { country: "Canada", size: "50mm × 70mm", pixels: "591 × 827", kb: "Up to 4 MB", bg: "White" },
  { country: "Australia", size: "35mm × 45mm", pixels: "413 × 531", kb: "Up to 2 MB", bg: "White" },
  { country: "Germany", size: "35mm × 45mm", pixels: "413 × 531", kb: "Up to 10 MB", bg: "White" },
];

const indianUseCases = [
  { form: "Indian Passport", size: "35mm × 45mm", kb: "10-50 KB", bg: "White" },
  { form: "PAN Card", size: "3.5cm × 2.5cm", kb: "Up to 200 KB", bg: "White" },
  { form: "Aadhar Card", size: "3.5cm × 2.5cm", kb: "Up to 300 KB", bg: "White" },
  { form: "SSC Exam", size: "3.5cm × 4.5cm", kb: "20-50 KB", bg: "White" },
  { form: "UPSC Application", size: "3.5cm × 4.5cm", kb: "20-50 KB", bg: "White" },
  { form: "Bank Account", size: "3.5cm × 2.5cm", kb: "20-50 KB", bg: "White" },
  { form: "Railway (RRB)", size: "3.5cm × 4.5cm", kb: "20-50 KB", bg: "White" },
  { form: "Govt Job Forms", size: "3.5cm × 4.5cm", kb: "20-50 KB", bg: "White" },
];
---

<BaseLayout
  title="Passport Photo Size — Free Online Compressor Tool"
  description="Get correct passport photo size for any country. Free online compressor — resize, crop, compress to 20KB–100KB. India, USA, UK, Canada supported."
  canonical="https://quickjpgconverter.com/tools/passport-photo-size"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["passport photo size", "passport photo size in cm", "passport photo size in kb", "passport photo size india", "passport photo size usa", "passport photo size uk", "passport photo background", "passport size photo online free", "passport photo compressor", "resize photo for passport", "passport photo maker online", "35mm 45mm photo size", "passport photo 20kb", "passport size photo compress", "passport photo download"]}
  howToSteps={[
    { name: "Upload your photo", text: "Click the upload button and select your photo from your device." },
    { name: "Select target size", text: "Choose 20KB, 50KB, or 100KB based on your passport application requirements." },
    { name: "Download passport photo", text: "Download your ready-to-use passport photo in JPG format." },
  ]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Passport Photo <span class="gradient-text">Size</span> & Compressor
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Compress your passport photo to 20KB, 50KB, or 100KB — instantly, in your browser. India, USA, UK, Canada — all countries and sizes supported. No signup, 100% private.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Target:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm" id="target-size-btn">≤ 20KB</button>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your photo here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Photo
                    <input type="file" class="sr-only" accept="image/jpeg,image/png,image/webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Max 50MB per file</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                </div>
              </div>
            </div>
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-4">
                <h3 class="text-sm font-medium text-text-secondary mb-3">Target Size</h3>
                <div class="flex flex-wrap gap-2">
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm" data-size="20">20 KB</button>
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary border border-border-default hover:border-brand-300 transition-colors" data-size="50">50 KB</button>
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary border border-border-default hover:border-brand-300 transition-colors" data-size="100">100 KB</button>
                </div>
              </div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compressing...</p>
              </div>
              <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                Compress for Passport
              </button>
              <div id="download-area" class="hidden mt-4"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Reference</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Passport Photo Sizes by Country</h2>
      </div>
      <div class="max-w-5xl mx-auto overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-surface border-b border-border-default">
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Country</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Size (mm)</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Pixels</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">File Size</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Background</th>
            </tr>
          </thead>
          <tbody>
            {passportSizes.map((size, i) => (
              <tr class:list={["border-b border-border-muted", i === 0 && "bg-brand-50/50 dark:bg-brand-950/20"]}>
                <td class="px-4 sm:px-5 py-3 font-medium text-text-primary">{size.country}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.size}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.pixels}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.kb}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.bg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">India Specific</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Photo Sizes for Indian Forms</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {indianUseCases.map((useCase) => (
          <div class="card-hover p-5">
            <h3 class="text-sm font-semibold text-text-primary mb-2">{useCase.form}</h3>
            <div class="space-y-1">
              <p class="text-xs text-text-secondary"><span class="font-medium">Size:</span> {useCase.size}</p>
              <p class="text-xs text-text-secondary"><span class="font-medium">File:</span> {useCase.kb}</p>
              <p class="text-xs text-text-secondary"><span class="font-medium">Background:</span> {useCase.bg}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="prose">
        <h2>How to Create Passport Photos</h2>
        <p>Creating a passport photo with our tool is simple:</p>
        <ol>
          <li><strong>Upload your photo:</strong> Click the upload area and select your photo.</li>
          <li><strong>Select target size:</strong> Choose 20KB, 50KB, or 100KB based on your form requirements.</li>
          <li><strong>Click Compress:</strong> The tool will compress your photo to the target size.</li>
          <li><strong>Download:</strong> Get your passport-ready photo instantly.</li>
        </ol>
        <h3>Photo Quality Tips</h3>
        <ul>
          <li>Use natural, even lighting. Avoid harsh shadows.</li>
          <li>Use a plain white background.</li>
          <li>Face the camera directly with a neutral expression.</li>
          <li>Remove glasses if possible, or ensure no glare.</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="prose">
        <h2>What is the Standard Passport Photo Size?</h2>
        <p>The standard passport photo size for most countries is <strong>35mm × 45mm</strong> (3.5cm × 4.5cm), which equals approximately <strong>413 × 531 pixels</strong> at 300 DPI. The US passport photo uses a different size: <strong>2in × 2in</strong> (51mm × 51mm or 600 × 600 pixels).</p>
        <p>Most government portals and passport application systems require your photo to be between <strong>20KB and 100KB</strong> in file size. Our free online compressor helps you hit the exact target size without losing visible quality.</p>
        <h3>Passport Photo Requirements by Country</h3>
        <p>Each country has slightly different passport photo requirements. India, UK, Australia, and most EU countries use the 35mm × 45mm standard. The US and Philippines use 2×2 inches. Canada uses a larger 50mm × 70mm format. Our tool supports compression to all these sizes — just select your target file size and upload.</p>
        <h3>How to Compress Passport Photo Online</h3>
        <ol>
          <li><strong>Upload your photo</strong> — Click the upload area or drag and drop your image (JPG, PNG, or WebP).</li>
          <li><strong>Choose target size</strong> — Select 20KB, 50KB, or 100KB based on your application portal's requirements.</li>
          <li><strong>Download</strong> — Get your compressed passport photo instantly, ready for upload.</li>
        </ol>
        <p>The entire process runs in your browser — <strong>your photos are never uploaded to any server</strong>. This makes our tool the safest way to compress sensitive passport photos online.</p>
        <p>Need to compress photos for a <a href="/compress-for-govt-form" class="text-brand-600 hover:text-brand-700 underline">government form (SSC, UPSC, Bank)</a>? Or convert your image to <a href="/photo-to-base64" class="text-brand-600 hover:text-brand-700 underline">Base64 for web development</a>?</p>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Tools</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/compress-to-100kb" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress to 100KB</h3>
          <p class="text-sm text-text-secondary">Reduce images to under 100KB.</p>
        </a>
        <a href="/compress-for-govt-form" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress for Govt Form</h3>
          <p class="text-sm text-text-secondary">Reduce images for SSC, UPSC forms.</p>
        </a>
        <a href="/photo-to-base64" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Photo to Base64</h3>
          <p class="text-sm text-text-secondary">Convert images to Base64 strings.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    
    const config = { targetSize: 20 * 1024 };
    initTargetedCompressor(config);
    
    const targetSizeBtn = document.getElementById('target-size-btn');
    const sizeButtons = document.querySelectorAll('.size-btn');
    
    sizeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        sizeButtons.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
          b.classList.add('text-text-tertiary', 'border', 'border-border-default');
        });
        btn.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
        btn.classList.remove('text-text-tertiary', 'border', 'border-border-default');
        config.targetSize = parseInt(btn.dataset.size) * 1024;
        if (targetSizeBtn) targetSizeBtn.textContent = '≤ ' + btn.dataset.size + 'KB';
      });
    });
  </script>
</BaseLayout>
