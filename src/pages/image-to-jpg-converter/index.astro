---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import ActiveConverter from "@components/tool/ActiveConverter.astro";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Image to JPG Converter", url: "/image-to-jpg-converter" },
];

const faqItems = [
  {
    question: "What is an image to JPG converter?",
    answer: "An image to JPG converter transforms any image format — PNG, WebP, HEIC, BMP, TIFF — into JPG files. JPG is the most universally compatible image format, supported by every device, browser, and platform.",
  },
  {
    question: "Why convert images to JPG?",
    answer: "JPG files are smaller than PNG and BMP while maintaining excellent visual quality. They're universally supported, making them ideal for sharing, uploading to social media, printing, and web publishing.",
  },
  {
    question: "Is my data safe when converting images?",
    answer: "Yes. Our converter runs entirely in your browser. Your images are never uploaded to any server — all processing happens locally on your device. Your files remain 100% private.",
  },
  {
    question: "Can I convert multiple images to JPG at once?",
    answer: "Yes. Our batch converter supports unlimited files. Drop dozens of images, set your preferred quality, and convert them all in one operation.",
  },
  {
    question: "What quality should I choose for JPG conversion?",
    answer: "For most uses, 85-92% quality provides excellent results. Use 95%+ for print or archival, and 75-80% when file size is the priority.",
  },
  {
    question: "Does JPG support transparency?",
    answer: "No. JPG does not support transparent backgrounds. If your source image has transparency, the transparent areas will be filled with white when converted to JPG. For images needing transparency, keep them as PNG or use WebP.",
  },
];
---

<BaseLayout
  title="Image to JPG Converter — Free Online Tool"
  description="Convert any image to JPG format instantly. Supports PNG, WebP, HEIC, BMP, and more. Free, private, and runs in your browser — no uploads required."
  canonical="https://quickjpgconverter.com/image-to-jpg-converter"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["image to jpg converter", "convert image to jpg", "image to jpg", "image to jpeg", "online image to jpg", "free image to jpg converter", "picture to jpg", "photo to jpg"]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <!-- Title Section -->
  <section class="pb-6 sm:pb-8 bg-glow">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">🖼️ Any Format to JPG</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          <span class="gradient-text">Image</span> to JPG Converter
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Transform any image format into universally compatible JPG files.
          No uploads, 100% private — runs entirely in your browser.
        </p>
      </div>
    </Container>
  </section>

  <!-- Converter Widget -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <ActiveConverter
          targetFormat="jpg"
          targetExt="jpg"
          targetMime="image/jpeg"
          accept=".png,.webp,.heic,.heif,.bmp,.tiff,.tif,.svg"
          inputFormat="Any Image"
          outputFormat="JPG"
        />
      </div>
    </Container>
  </section>

  <!-- How It Works -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Convert in Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Select your images</h3>
          <p class="text-sm text-text-secondary">Drag and drop PNG, WebP, HEIC, or any image format.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Convert instantly</h3>
          <p class="text-sm text-text-secondary">Your images are converted in-browser. No server uploads.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download JPG files</h3>
          <p class="text-sm text-text-secondary">Get your compatible JPG files instantly.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SEO Prose & FAQs -->
  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Convert Any Image to JPG</h2>
        <p>
          Whether you have PNG screenshots, WebP downloads, HEIC iPhone photos, or legacy BMP files, our image to JPG converter transforms them into the most universally compatible format. JPG works on every device, every browser, every social media platform, and every design tool — no exceptions.
        </p>
        <p>
          The conversion process happens entirely in your browser using advanced WebAssembly and Canvas technology. Your images are processed locally and never uploaded to any server. This means faster conversion, complete privacy, and no file size restrictions.
        </p>

        <h3>Common Image to JPG Conversions</h3>
        <ul>
          <li><strong>PNG to JPG</strong> — Reduce file sizes by 5-10x for photos and screenshots</li>
          <li><strong>WebP to JPG</strong> — Use WebP images in tools that don't support the format</li>
          <li><strong>HEIC to JPG</strong> — Open iPhone photos on Windows, Android, and older devices</li>
          <li><strong>BMP to JPG</strong> — Modernize legacy bitmap images for web and sharing</li>
        </ul>

        <h3>Why JPG Is the Standard</h3>
        <p>
          JPG has been the standard image format for over 30 years. Its universal compatibility, reasonable file sizes, and excellent quality for photographs make it the default choice for billions of users worldwide. When in doubt, convert to JPG — it always works.
        </p>

        <h3>Quality Control</h3>
        <p>
          Our converter lets you choose the quality level for each conversion. High quality (92-95%) is ideal for print and archival. Balanced (85-90%) works great for web publishing and sharing. Smallest size (75-80%) is perfect when file size matters most.
        </p>
      </div>

      <div class="mt-12">
        <div class="text-center mb-10">
          <Badge class="mb-4">FAQ</Badge>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
        </div>
        <FAQ items={faqItems} />
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/png-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PNG to JPG</h3>
          <p class="text-sm text-text-secondary">Reduce PNG file sizes by 5-10x.</p>
        </a>
        <a href="/webp-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">WebP to JPG</h3>
          <p class="text-sm text-text-secondary">Convert WebP for universal compatibility.</p>
        </a>
        <a href="/heic-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">HEIC to JPG</h3>
          <p class="text-sm text-text-secondary">Open iPhone photos on any device.</p>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
