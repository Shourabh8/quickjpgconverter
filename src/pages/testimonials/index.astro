---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import { site } from "@data/site";

const breadcrumbs = [{ name: "Architecture & Privacy", url: "/why-browser-based/" }];
---

<BaseLayout
  title="Privacy & Technical Architecture — QuickJPG"
  description="How QuickJPG processes images locally inside your browser using HTML5 Canvas and WebAssembly with zero server uploads."
  canonical={`${site.url}/testimonials/`}
  noindex={true}
  {breadcrumbs}
>
  <section class="section">
    <Container variant="narrow">
      <div class="rounded-2xl border border-border-default bg-surface p-8 sm:p-10 text-center">
        <h1 class="text-2xl sm:text-3xl font-bold text-text-primary mb-3">
          100% Client-Side Image Processing
        </h1>
        <p class="text-text-secondary max-w-xl mx-auto mb-6">
          QuickJPG runs all format conversions and compression directly in your browser memory—no files are ever transmitted to remote servers.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/why-browser-based/" class="btn-primary btn-md">
            Read Technical Architecture
          </a>
          <a href="/tools/" class="btn-secondary btn-md">
            Browse All Image Tools
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
