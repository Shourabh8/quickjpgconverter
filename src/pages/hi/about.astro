---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "hi" as const;
const prefix = getLocalePrefix(locale);
const breadcrumbs = [{ name: "हमारे बारे में", url: `${prefix}/about` }];
---

<BaseLayout
  title="हमारे बारे में — Quick JPG Converter"
  description="Quick JPG Converter के बारे में जानें, एक मुफ्त इमेज कनवर्ज़न टूल जो गोपनीयता केंद्रित है, गति, सरलता और पूर्ण डेटा सुरक्षा के लिए बनाया गया।"
  canonical={`https://quickjpgconverter.com${prefix}/about`}
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-8">
        <Badge class="mb-4">हमारे बारे में</Badge>
      </div>

      <article class="prose mt-6">
        <h1>Quick JPG Converter के बारे में</h1>

        <p class="lead">
          Quick JPG Converter एक मुफ्त ऑनलाइन टूल है जो इमेज फ़ॉर्मेट कनवर्ज़न को सरल,
          तेज़ और पूरी तरह से निजी बनाने के लिए डिज़ाइन किया गया है। फ़ोटोग्राफ़र,
          डिज़ाइनर, डेवलपर्स और डेस्कटॉप सॉफ़्टवेयर की परेशानी के बिना त्वरित इमेज
          कनवर्ज़न की आवश्यकता वाले किसी के लिए बनाया गया।
        </p>

        <h2>हम क्या करते हैं</h2>
        <p>
          हम मुफ्त ब्राउज़र-आधारित इमेज कनवर्ज़न टूल्स का एक सूट प्रदान करते हैं। हमारी
          मुख्य विशेषता उपयोगकर्ताओं को JPG इमेज को PNG, WebP और PDF प्रारूपों में तुरंत
          कनवर्ट करने की अनुमति देती है — PNG को JPG में, WebP को JPG में कनवर्ट करने और
          इमेज को रीसाइज़ करने के लिए अतिरिक्त टूल्स के साथ। हर कनवर्ज़न आधुनिक वेब
          तकनीकों का उपयोग करके पूरी तरह से आपके ब्राउज़र में चलता है, जिसका अर्थ है कि
          आपकी फ़ाइलें कभी आपके डिवाइस से बाहर नहीं जातीं।
        </p>
        <p>
          चाहे आपको PNG में पारदर्शी लोगो, WebP में हल्की इमेज, या फ़ोटो से तेज़ PDF की
          आवश्यकता हो, हमारे टूल्स मिलीसेकंड में काम करते हैं बिना कुछ इंस्टॉल किए या
          अकाउंट बनाए।
        </p>

        <h2>हमारा मिशन</h2>
        <p>
          हम मानते हैं कि इमेज कनवर्ज़न गोपनीयता से समझौता किए बिना सभी के लिए सुलभ
          होना चाहिए। बहुत सारे ऑनलाइन कनवर्टर आपकी फ़ाइलों को दूरस्थ सर्वर पर भेजते
          हैं, व्यक्तिगत फ़ोटो और संवेदनशील दस्तावेजों को अनावश्यक जोखिम में उजागर
          करते हैं। हमने इस समस्या को हल करने के लिए Quick JPG Converter बनाया।
        </p>
        <p>
          हमारा लक्ष्य वेब पर उपलब्ध सबसे तेज़, सबसे निजी इमेज कनवर्ज़न अनुभव प्रदान
          करना है — पूरी तरह से मुफ्त, कोई छिपी फीस नहीं, कोई साइनअप दीवार नहीं, और
          कोई डेटा संग्रह नहीं।
        </p>

        <h2>यह कैसे काम करता है</h2>
        <p>
          पारंपरिक कनवर्टर के विपरीत जो आपकी इमेज को सर्वर पर अपलोड करते हैं, हमारा
          टूल आपके डिवाइस पर सीधे इमेज प्रोसेस करने के लिए आधुनिक ब्राउज़र API का
          उपयोग करता है — Canvas API और WebAssembly सहित। यह दृष्टिकोण कई महत्वपूर्ण
          लाभ प्रदान करता है:
        </p>
        <ul>
          <li><strong>तेज़ कनवर्ज़न</strong> — कोई अपलोड या डाउनलोड इंतज़ार नहीं; प्रोसेसिंग स्थानीय रूप से होती है</li>
          <li><strong>पूर्ण गोपनीयता</strong> — इमेज कभी आपके ब्राउज़र से बाहर नहीं जातीं और किसी सर्वर को प्रसारित नहीं होतीं</li>
          <li><strong>कोई फ़ाइल आकार सीमा नहीं</strong> — केवल आपके डिवाइस की उपलब्ध मेमोरी द्वारा सीमित</li>
          <li><strong>कोई अकाउंट नहीं चाहिए</strong> — साइट खोलें और तुरंत कनवर्ट करना शुरू करें</li>
          <li><strong>किसी भी डिवाइस पर काम करता है</strong> — डेस्कटॉप, टैबलेट या आधुनिक ब्राउज़र वाला फ़ोन</li>
        </ul>

        <h2>हमें क्यों चुनें</h2>
        <p>
          ऑनलाइन दर्जनों इमेज कनवर्टर हैं। यह है कि Quick JPG Converter को क्या अलग
          बनाता है:
        </p>
        <ul>
          <li><strong>100% मुफ्त</strong> — कोई प्रीमियम टियर नहीं, कोई पेवॉल नहीं, कोई छिपी फीस नहीं</li>
          <li><strong>शून्य अपलोड</strong> — आपकी फ़ाइलें हमेशा आपके डिवाइस पर रहती हैं</li>
          <li><strong>तुरंत परिणाम</strong> — कनवर्ज़न मिलीसेकंड में पूरी होती है</li>
          <li><strong>बैच सपोर्ट</strong> — कई फ़ाइलों को एक साथ कनवर्ट करें</li>
          <li><strong>गुणवत्ता नियंत्रण</strong> — उच्च गुणवत्ता, संतुलित या सबसे छोटे आकार में से चुनें</li>
          <li><strong>मोबाइल-फ्रेंडली</strong> — फ़ोन और टैबलेट पर परफेक्ट काम करता है</li>
        </ul>

        <h2>खुला और पारदर्शी</h2>
        <p>
          Quick JPG Converter पारदर्शिता को ध्यान में रखकर बनाया गया है। हमारी गोपनीयता
          नीति स्पष्ट रूप से बताती है कि हम कौन सा डेटा एकत्र करते हैं (लगभग कोई
          नहीं), और हमारी सेवा की शर्तें सरल भाषा में लिखी गई हैं। हम समुदाय से
          फीडबैक, फ़ीचर अनुरोध और योगदान का स्वागत करते हैं।
        </p>

        <h2>हमारी प्रतिबद्धता</h2>
        <p>
          हम इस टूल को मुफ्त और विज्ञापन-समर्थित रखने के लिए प्रतिबद्ध हैं। हम
          उपयोगकर्ता डेटा नहीं बेचते, हमें अकाउंट की आवश्यकता नहीं है, और हम आपकी
          इमेज स्टोर नहीं करते। हमारी राजस्व केवल गैर-घुसपैठ विज्ञापनों से आता है
          जो हमें होस्टिंग और विकास लागत को कवर करने में मदद करते हैं।
        </p>

        <h2>हमसे संपर्क करें</h2>
        <p>
          कोई सवाल, सुझाव है, या बस हेलो कहना चाहते हैं? हम आपसे सुनना पसंद करेंगे।
          हमसे संपर्क करें
          <a href="https://mail.google.com/mail/?view=cm&fs=1&to=supportquickjpgconverter@gmail.com">supportquickjpgconverter@gmail.com</a>
          पर या अधिक विकल्पों के लिए हमारा <a href={`${prefix}/contact`}>संपर्क पेज</a> देखें।
        </p>
      </article>
    </Container>
  </section>
</BaseLayout>
