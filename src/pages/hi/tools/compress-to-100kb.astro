---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "hi" as const;
const prefix = getLocalePrefix(locale);

const breadcrumbs = [
  { name: "उपकरण", url: `${prefix}/tools` },
  { name: "100KB तक कंप्रेस करें", url: `${prefix}/tools/compress-to-100kb` },
];

const faqItems = [
  {
    question: "मुझे इमेज को बिल्कुल 100KB तक कंप्रेस क्यों करना होगा?",
    answer: "बहुत से ऑनलाइन पोर्टल, सरकारी फ़ॉर्म और रोज़गार आवेदनों में पासपोर्ट फ़ोटो या दस्तावेज़ स्कैन 100KB से नीचे होने चाहिए। यह टूल सबसे अच्छी गुणवत्ता बनाए रखते हुए इन सख्त फ़ाइल आकार आवश्यकताओं को पूरा करने में मदद करता है।",
  },
  {
    question: "कंप्रेशन के बाद मेरी इमेज धुंधली दिखेगी?",
    answer: "हमारा कंप्रेसर लक्ष्य आकार प्राप्त करते हुए दृश्य गुणवत्ता को जितना संभव हो सके संरक्षित करने के लिए स्मार्ट गुणवत्ता कमी का उपयोग करता है। 100KB पर फ़ोटो और दस्तावेज़ों के लिए परिणाम आमतौर पर उत्कृष्ट होता है।",
  },
  {
    question: "कौन से इमेज फ़ॉर्मेट सपोर्टेड हैं?",
    answer: "हम JPG, PNG और WebP इनपुट फ़ॉर्मेट सपोर्ट करते हैं। आउटपुट हमेशा JPG होता है ताकि लक्ष्य पर सबसे छोटा फ़ाइल आकार सुनिश्चित हो सके।",
  },
  {
    question: "क्या मैं एक साथ कई इमेज कंप्रेस कर सकता हूं?",
    answer: "हां। आप कई इमेज अपलोड कर सकते हैं और सभी को 100KB या उससे कम कंप्रेस कर सकते हैं। प्रत्येक इमेज को लक्ष्य आकार पूरा करने के लिए अलग-अलग प्रोसेस किया जाता है।",
  },
  {
    question: "अपलोड के लिए फ़ाइल आकार की कोई सीमा है?",
    answer: "आप 50MB तक की इमेज अपलोड कर सकते हैं। कंप्रेसर पूरी तरह आपके ब्राउज़र में चलता है, इसलिए प्रोसेसिंग समय आपके डिवाइस और इमेज की संख्या पर निर्भर करता है।",
  },
  {
    question: "क्या यह मोबाइल पर काम करता है?",
    answer: "हां। हमारा कंप्रेसर किसी भी डिवाइस पर काम करता है — iPhone, Android, टैबलेट या डेस्कटॉप। कोई ऐप इंस्टॉल करने की आवश्यकता नहीं। बस अपने ब्राउज़र में टूल खोलें और कंप्रेस करें।",
  },
];

const steps = [
  { title: "अपनी इमेज अपलोड करें", desc: "अपनी फ़ोटो ड्रैग और ड्रॉप करें या चुनने के लिए क्लिक करें।" },
  { title: "ऑटो-कंप्रेस", desc: "हमारा एल्गोरिदम बिल्कुल 100KB तक पहुंचने के लिए गुणवत्ता कम करता है।" },
  { title: "JPG डाउनलोड करें", desc: "तुरंत अपनी 100KB इमेज प्राप्त करें, अपलोड के लिए तैयार।" },
];

const relatedTools = [
  { slug: "compress-to-200kb", title: "200KB तक कंप्रेस करें", desc: "इमेज को 200KB से कम कंप्रेस करें।" },
  { slug: "image-enhancer", title: "इमेज एन्हांसर", desc: "ब्राइटनेस, कंट्रास्ट और शार्पनेस बेहतर बनाएं।" },
  { slug: "image-compressor", title: "इमेज कंप्रेसर", desc: "क्वालिटी स्लाइडर के साथ कस्टम कंप्रेशन।" },
  { slug: "resize-jpg", title: "JPG रीसाइज़ करें", desc: "इमेज को किसी भी आयाम में रीसाइज़ करें।" },
  { slug: "jpg-to-png", title: "JPG से PNG", desc: "JPG को हानि-रहित गुणवत्ता में PNG में बदलें।" },
  { slug: "jpg-to-webp", title: "JPG से WebP", desc: "JPG को आधुनिक WebP प्रारूप में बदलें।" },
];
---

<BaseLayout
  title="इमेज को 100KB तक कंप्रेस करें — मुफ्त ऑनलाइन फ़ोटो रीड्यूसर"
  description="पासपोर्ट फ़ोटो, फ़ॉर्म सबमिशन और पोर्टल अपलोड के लिए किसी भी इमेज को 100KB से कम कंप्रेस करें। मुफ्त ऑनलाइन टूल जो आपके ब्राउज़र में चलता है — कोई अपलोड नहीं, कोई पंजीकरण नहीं।"
  canonical={`https://quickjpgconverter.com${prefix}/tools/compress-to-100kb`}
  keywords={["इमेज को 100kb तक कंप्रेस करें", "फ़ोटो 100kb तक रीड्यूस करें", "100kb इमेज कंप्रेसर", "इमेज 100kb"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  locale={locale}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          मुफ्त · बिना पंजीकरण · निजी
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          इमेज को <span class="gradient-text">100KB</span> तक कंप्रेस करें
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          पासपोर्ट फ़ोटो, फ़ॉर्म सबमिशन और पोर्टल अपलोड के लिए बिल्कुल सही। किसी भी इमेज को 100KB से कम कंप्रेस करें गुणवत्ता बनाए रखते हुए।
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">लक्ष्य आकार:</span>
            <div class="flex items-center gap-2">
              <span id="target-size-display" class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">100 KB</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">अपनी इमेज यहां ड्रैग करें</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">या अपने कंप्यूटर से चुनने के लिए क्लिक करें</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    फ़ाइलें चुनें
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · अधिकतम 50MB प्रति फ़ाइल · कई फ़ाइलें सपोर्टेड</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">अपलोड करने के लिए छोड़ें</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 फ़ाइलें तैयार</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">सब साफ़ करें</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">लक्ष्य: ≤ 100KB</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">आउटपुट: JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">लक्ष्य फ़ाइल आकार</h3>
                <div class="p-4 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30">
                  <div class="text-center">
                    <div class="text-3xl font-bold text-brand-600 dark:text-brand-400 mb-1">100KB</div>
                    <p class="text-xs text-text-secondary">पासपोर्ट फ़ोटो और फ़ॉर्म सबमिशन के लिए आदर्श</p>
                  </div>
                </div>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">आउटपुट प्रारूप</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">JPG</div>
                      <div class="text-xs text-text-tertiary">हानि-संपीड़ित · सार्वभौमिक · छोटी फ़ाइलें</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">कंप्रेस हो रहा है...</p>
              </div>
              <div id="compress-btn-area">
                <button id="compress-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  100KB तक कंप्रेस करें
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">कंप्रेशन शुरू करने के लिए इमेज अपलोड करें</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">सपोर्टेड:</span>
          {["JPG", "PNG", "WebP"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>अधिकतम 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>कई फ़ाइलें</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="100KB तक कंप्रेस करें" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">यह कैसे काम करता है</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">तीन चरण</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {steps.map((step, i) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">0{i + 1}</div>
            <h3 class="text-base font-semibold text-text-primary mb-1.5">{step.title}</h3>
            <p class="text-sm text-text-secondary">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>100KB तक कंप्रेस क्यों करें?</h2>
        <p>बहुत से ऑनलाइन पोर्टल, सरकारी वेबसाइटों और रोज़गार आवेदनों में सख्त फ़ाइल आकार सीमाएं होती हैं। पासपोर्ट फ़ोटो, पहचान पत्र और दस्तावेज़ स्कैन को अक्सर 100KB से नीचे होना चाहिए। हमारा कंप्रेसर इस सटीक आवश्यकता को पूरा करते हुए दृश्य स्पष्टता को जितना संभव हो सके संरक्षित करने के लिए गुणवत्ता को स्मार्ट तरीके से कम करता है।</p>
        <h3>सामान्य उपयोग के मामले</h3>
        <ul>
          <li>पासपोर्ट और वीज़ा फ़ोटो अपलोड</li>
          <li>सरकारी पोर्टल पर फ़ॉर्म सबमिशन</li>
          <li>रोज़गार आवेदनों के लिए फ़ोटो आवश्यकताएं</li>
          <li>विश्वविद्यालय प्रवेश फ़ॉर्म</li>
          <li>साइज़ लिमिट वाले सोशल मीडिया प्रोफ़ाइल फ़ोटो</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">अक्सर पूछे जाने वाले सवाल</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">संबंधित उपकरण</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">हमारे अन्य कनवर्टर आज़माएं</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {relatedTools.map((tool) => (
          <a href={`${prefix}/tools/${tool.slug}`} class="card-hover p-5 group">
            <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{tool.title}</h3>
            <p class="text-sm text-text-secondary">{tool.desc}</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    document.addEventListener("DOMContentLoaded", () => initTargetedCompressor({ targetSize: 100 * 1024 }));
  </script>
</BaseLayout>
