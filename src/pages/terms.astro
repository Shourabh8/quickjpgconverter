---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [{ name: "Terms of Service", url: "/terms" }];
---

<BaseLayout
  title="Terms of Service — Quick JPG Converter"
  description="Quick JPG Converter terms of service. Read the rules and guidelines for using our free image conversion tools."
  canonical="https://quickjpgconverter.com/terms"
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-8">
        <Badge class="mb-4">Legal</Badge>
      </div>

      <article class="prose mt-6">
        <h1>Terms of Service</h1>
        <p><em>Last updated: June 9, 2026</em></p>

        <p>
          Welcome to Quick JPG Converter. These Terms of Service ("Terms") govern
          your use of our website and tools located at
          <a href="https://quickjpgconverter.com">quickjpgconverter.com</a>. By
          accessing or using our services, you agree to be bound by these Terms.
        </p>
        <p>
          If you do not agree to these Terms, please do not use our services.
        </p>

        <h2>1. Acceptance of Terms</h2>
