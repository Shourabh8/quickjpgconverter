---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [{ name: "JPG to PDF", url: "/jpg-to-pdf" }];

const faqItems = [
  {
    question: "Why should I convert JPG to PDF?",
    answer: "PDF is the universal document format. Converting JPG images to PDF makes them easy to share, print, and archive. PDFs maintain consistent formatting across all devices and platforms, and are required by many institutions for document submission.",
  },
  {
    question: "Can I combine multiple JPGs into one PDF?",
    answer: "Yes. You can select multiple JPG files and our converter will combine them into a single multi-page PDF document. Each image becomes one page in the PDF.",
  },
  {
    question: "Can I control the page order?",
    answer: "Yes. Images are placed in the order you select them. Select them in the order you want the pages to appear in the PDF.",
  },
  {
    question: "Can I convert PNG or WebP images to PDF?",
    answer: "Yes. While named JPG to PDF, our converter also accepts PNG, WebP, and HEIC image files.",
  },
  {
    question: "What quality will the PDF be?",
    answer: "Our converter preserves your original image quality. The PDF output contains full-resolution images from your original JPG files.",
  },
  {
    question: "Is the conversion private?",
    answer: "Yes. Everything runs locally in your browser using JavaScript and the Canvas API. No files are uploaded to any server.",
  },
];
---

<BaseLayout
  title="Free JPG to PDF Converter — Convert Images to PDF Online"
  description="Convert JPG images to PDF documents online for free. Combine multiple JPGs into a multi-page PDF. 100% private, no uploads, instant conversion."
  canonical="https://quickjpgconverter.com/jpg-to-pdf"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["jpg to pdf", "convert jpg to pdf", "image to pdf", "jpeg to pdf", "multiple jpg to pdf", "jpg to pdf online free"]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <!-- Title Section -->
  <section class="pb-6 sm:pb-8 bg-glow">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">📄 Multi-page PDF Support</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          JPG to <span class="gradient-text">PDF</span> Converter
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Convert JPG images to PDF documents instantly. Combine multiple images
          into a single PDF — 100% private, no uploads required.
        </p>
      </div>
    </Container>
  </section>

  <!-- Converter Widget -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar -->
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Convert to:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-red-600 text-white shadow-sm">PDF</button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
                >
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your JPG files here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse — supports JPG, PNG, WebP</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Images
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp,image/*" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG · PNG · WebP · Max 50MB per file · Multiple files → Multi-page PDF</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>

              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Input: JPG / PNG</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-red-600 dark:text-red-400 font-medium">Output: PDF</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Options + Actions -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">PDF Configuration</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-red-50 dark:bg-red-950/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">Multi-page PDF</div>
                      <div class="text-xs text-text-tertiary">Each image becomes one page</div>
                    </div>
                  </div>
                </div>

                <div class="space-y-2 mb-6">
                  {[
                    { label: "High Quality", desc: "Best fidelity, larger PDF size", checked: true },
                    { label: "Balanced", desc: "Good quality, reasonable size" },
                    { label: "Compact", desc: "Smallest PDF, some compression" },
                  ].map((opt) => (
                    <label class={`flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200 ${opt.checked ? "border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30" : "border-border-default hover:border-border-strong hover:bg-surface-subtle/50"}`}>
                      <input type="radio" name="pdf-quality" checked={opt.checked} class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-text-primary">{opt.label}</div>
                        <div class="text-xs text-text-tertiary mt-0.5">{opt.desc}</div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <div class="flex-1"></div>

              <div>
                <div id="progress-area" class="hidden mb-4">
                  <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Converting...</p>
                </div>

                <div id="convert-btn-area">
                  <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    Convert to PDF
                  </button>
                  <p class="text-xs text-text-tertiary text-center mt-2">Processed locally in your browser</p>
                </div>

                <div id="download-area" class="hidden"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- How It Works -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Select your images</h3>
          <p class="text-sm text-text-secondary">Drop your JPGs or click to browse. Add multiple files for a multi-page PDF.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Convert instantly</h3>
          <p class="text-sm text-text-secondary">Images are assembled into a PDF document right in your browser.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download PDF</h3>
          <p class="text-sm text-text-secondary">Get your completed PDF document ready to share or print.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SEO & FAQ -->
  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Convert JPG to PDF?</h2>
        <p>
          PDF (Portable Document Format) is the world's most trusted document format. Converting your JPG images to PDF lets you share photos as professional documents, preserve them in an archive-ready format, and submit them to institutions that require PDF format.
        </p>
        <p>
          With our free converter, you can combine multiple JPG images into a single multi-page PDF in seconds. No software installation, no sign-up, and no server uploads — just instant, private conversion.
        </p>

        <h3>Common JPG to PDF Use Cases</h3>
        <ul>
          <li>Submitting scanned documents to government agencies or employers</li>
          <li>Combining a series of photos into a single shareable document</li>
          <li>Creating photo portfolios or lookbooks in PDF format</li>
          <li>Converting phone photos of receipts or invoices to PDF for bookkeeping</li>
          <li>Archiving important images in a universally compatible format</li>
          <li>Preparing images for professional printing through a print shop</li>
        </ul>

        <h3>PDF vs Image Files</h3>
        <p>
          PDF documents are self-contained and preserve their layout on any device. They are universally supported by email clients, mobile apps, and printers. Unlike raw image files, PDFs can also be password-protected and digitally signed, making them ideal for professional and official document workflows.
        </p>
      </div>

      <div class="mt-12">
        <div class="text-center mb-10">
          <Badge class="mb-4">FAQ</Badge>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
        </div>
        <FAQ items={faqItems} />
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/pdf-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PDF to JPG</h3>
          <p class="text-sm text-text-secondary">Extract JPG images from PDF pages.</p>
        </a>
        <a href="/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG Compressor</h3>
          <p class="text-sm text-text-secondary">Reduce JPG file size before converting.</p>
        </a>
        <a href="/jpg-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PNG</h3>
          <p class="text-sm text-text-secondary">Convert JPG to transparent PNG.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initJpgToPdf } from "@scripts/jpg-to-pdf.js";
    document.addEventListener("DOMContentLoaded", () => initJpgToPdf());
  </script>
</BaseLayout>
