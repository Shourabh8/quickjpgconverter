---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "pt" as const;
const prefix = getLocalePrefix(locale);

const breadcrumbs = [
  { name: "Ferramentas", url: `${prefix}/tools` },
  { name: "Foto Passaporte", url: `${prefix}/passport-photo-size` },
];

const faqItems = [
  {
    question: "Qual é o tamanho padrão de foto de passaporte?",
    answer: "O tamanho padrão de foto de passaporte é 35mm x 45mm (3,5cm x 4,5cm) para a maioria dos países, incluindo Brasil, EUA, Reino Unido e países da UE. Em pixels, isso corresponde aproximadamente a 413 x 531 pixels a 300 DPI.",
  },
  {
    question: "Quanto pesa a foto de passaporte em KB?",
    answer: "A maioria dos portais governamentais exige fotos de passaporte entre 20KB e 100KB. As solicitações de passaporte brasileiro tipicamente exigem 10-50KB, enquanto as solicitações de passaporte dos EUA permitem até 600KB.",
  },
  {
    question: "Qual é a cor de fundo da foto de passaporte?",
    answer: "A maioria dos países exige um fundo branco ou branco quebrado. Alguns países aceitam fundo azul claro para certas solicitações.",
  },
  {
    question: "Como redimensiono minha foto para o tamanho de passaporte?",
    answer: "Use nossa ferramenta gratuita online acima. Basta enviar sua foto e ela será redimensionada automaticamente para as dimensões corretas de passaporte. Você também pode comprimi-la para atender aos requisitos de tamanho de arquivo.",
  },
];

const passportSizes = [
  { country: "Brasil", size: "35mm × 45mm", pixels: "413 × 531", kb: "10-50 KB", bg: "Branco" },
  { country: "EUA", size: "2in × 2in", pixels: "600 × 600", kb: "Até 600 KB", bg: "Branco" },
  { country: "Reino Unido", size: "35mm × 45mm", pixels: "413 × 531", kb: "Até 10 MB", bg: "Branco/Cinza" },
  { country: "Canadá", size: "50mm × 70mm", pixels: "591 × 827", kb: "Até 4 MB", bg: "Branco" },
  { country: "Austrália", size: "35mm × 45mm", pixels: "413 × 531", kb: "Até 2 MB", bg: "Branco" },
  { country: "Alemanha", size: "35mm × 45mm", pixels: "413 × 531", kb: "Até 10 MB", bg: "Branco" },
];

const indianUseCases = [
  { form: "Passaporte Indiano", size: "35mm × 45mm", kb: "10-50 KB", bg: "Branco" },
  { form: "Cartão PAN", size: "3,5cm × 2,5cm", kb: "Até 200 KB", bg: "Branco" },
  { form: "Cartão Aadhar", size: "3,5cm × 2,5cm", kb: "Até 300 KB", bg: "Branco" },
  { form: "Exame SSC", size: "3,5cm × 4,5cm", kb: "20-50 KB", bg: "Branco" },
  { form: "Solicitação UPSC", size: "3,5cm × 4,5cm", kb: "20-50 KB", bg: "Branco" },
  { form: "Conta Bancária", size: "3,5cm × 2,5cm", kb: "20-50 KB", bg: "Branco" },
  { form: "Ferroviária (RRB)", size: "3,5cm × 4,5cm", kb: "20-50 KB", bg: "Branco" },
  { form: "Formulários Gov.", size: "3,5cm × 4,5cm", kb: "20-50 KB", bg: "Branco" },
];

const steps = [
  { title: "Envie sua foto", desc: "Clique na área de envio e selecione sua foto do seu dispositivo." },
  { title: "Selecione o tamanho alvo", desc: "Escolha 20KB, 50KB ou 100KB de acordo com os requisitos da sua solicitação de passaporte." },
  { title: "Baixe a foto de passaporte", desc: "Baixe sua foto pronta para uso no formato JPG." },
];
---

<BaseLayout
  title="Foto de Passaporte Tamanho — Compressor Gratuito Online"
  description="Obtenha o tamanho correto de foto de passaporte para qualquer país. Compressor gratuito online — redimensione, recorte, comprima para 20KB–100KB. Brasil, EUA, Reino Unido, Canadá suportados."
  canonical={`https://quickjpgconverter.com${prefix}/passport-photo-size`}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["tamanho foto passaporte", "tamanho foto passaporte em cm", "tamanho foto passaporte em kb", "foto passaporte brasil", "foto passaporte usa", "foto passaporte uk", "fundo foto passaporte", "foto tamanho passaporte online gratuito", "compressor foto passaporte", "redimensionar foto para passaporte", "fazedor de foto passaporte online", "tamanho foto 35mm 45mm", "foto passaporte 20kb", "foto passaporte comprimir", "baixar foto passaporte"]}
  howToSteps={[
    { name: "Envie sua foto", text: "Clique no botão de envio e selecione sua foto do seu dispositivo." },
    { name: "Selecione o tamanho alvo", text: "Escolha 20KB, 50KB ou 100KB de acordo com os requisitos da sua solicitação de passaporte." },
    { name: "Baixe a foto de passaporte", text: "Baixe sua foto de passaporte pronta para uso no formato JPG." },
  ]}
  locale={locale}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
          </svg>
          Gratuito · Sem Cadastro · Privado
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Foto de Passaporte <span class="gradient-text">Tamanho</span> e Compressor
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Comprima sua foto de passaporte para 20KB, 50KB ou 100KB — instantaneamente, no seu navegador. Brasil, EUA, Reino Unido, Canadá — todos os países e tamanhos suportados. Sem cadastro, 100% privado.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Alvo:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm" id="target-size-btn">≤ 20KB</button>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Arraste sua foto aqui</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">ou clique para selecionar do seu computador</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Selecionar Foto
                    <input type="file" class="sr-only" accept="image/jpeg,image/png,image/webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Máx 50MB por arquivo</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Solte para enviar</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 arquivos prontos</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Limpar tudo</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                </div>
              </div>
            </div>
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-4">
                <h3 class="text-sm font-medium text-text-secondary mb-3">Tamanho Alvo</h3>
                <div class="flex flex-wrap gap-2">
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm" data-size="20">20 KB</button>
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary border border-border-default hover:border-brand-300 transition-colors" data-size="50">50 KB</button>
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary border border-border-default hover:border-brand-300 transition-colors" data-size="100">100 KB</button>
                </div>
              </div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Comprimindo...</p>
              </div>
              <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                Comprimir para Passaporte
              </button>
              <div id="download-area" class="hidden mt-4"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Referência</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Tamanhos de Foto de Passaporte por País</h2>
      </div>
      <div class="max-w-5xl mx-auto overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-surface border-b border-border-default">
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">País</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Tamanho (mm)</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Pixels</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Tamanho Arquivo</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Fundo</th>
            </tr>
          </thead>
          <tbody>
            {passportSizes.map((size, i) => (
              <tr class:list={["border-b border-border-muted", i === 0 && "bg-brand-50/50 dark:bg-brand-950/20"]}>
                <td class="px-4 sm:px-5 py-3 font-medium text-text-primary">{size.country}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.size}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.pixels}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.kb}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.bg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Específico para Índia</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Tamanhos de Foto para Formulários Indianos</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {indianUseCases.map((useCase) => (
          <div class="card-hover p-5">
            <h3 class="text-sm font-semibold text-text-primary mb-2">{useCase.form}</h3>
            <div class="space-y-1">
              <p class="text-xs text-text-secondary"><span class="font-medium">Tamanho:</span> {useCase.size}</p>
              <p class="text-xs text-text-secondary"><span class="font-medium">Arquivo:</span> {useCase.kb}</p>
              <p class="text-xs text-text-secondary"><span class="font-medium">Fundo:</span> {useCase.bg}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="prose">
        <h2>Como Criar Fotos de Passaporte</h2>
        <p>Criar uma foto de passaporte com nossa ferramenta é simples:</p>
        <ol>
          <li><strong>Envie sua foto:</strong> Clique na área de envio e selecione sua foto.</li>
          <li><strong>Selecione o tamanho alvo:</strong> Escolha 20KB, 50KB ou 100KB de acordo com os requisitos do seu formulário.</li>
          <li><strong>Clique em Comprimir:</strong> A ferramenta comprimirá sua foto para o tamanho alvo.</li>
          <li><strong>Baixe:</strong> Obtenha sua foto pronta para passaporte instantaneamente.</li>
        </ol>
        <h3>Dicas de Qualidade da Foto</h3>
        <ul>
          <li>Use iluminação natural e uniforme. Evite sombras duras.</li>
          <li>Use um fundo branco plano.</li>
          <li>Olhe diretamente para a câmera com uma expressão neutra.</li>
          <li>Retire os óculos se possível, ou certifique-se de que não haja reflexos.</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Perguntas Frequentes</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="prose">
        <h2>Qual é o Tamanho Padrão de Foto de Passaporte?</h2>
        <p>O tamanho padrão de foto de passaporte para a maioria dos países é <strong>35mm × 45mm</strong> (3,5cm × 4,5cm), que equivale a aproximadamente <strong>413 × 531 pixels</strong> a 300 DPI. A foto de passaporte dos EUA usa um tamanho diferente: <strong>2in × 2in</strong> (51mm × 51mm ou 600 × 600 pixels).</p>
        <p>A maioria dos portais governamentais e sistemas de solicitação de passaporte exige que sua foto esteja entre <strong>20KB e 100KB</strong> em tamanho de arquivo. Nosso compressor gratuito online ajuda você a atingir o tamanho alvo exato sem perder qualidade visível.</p>
        <h3>Requisitos de Foto de Passaporte por País</h3>
        <p>Cada país tem requisitos ligeiramente diferentes para fotos de passaporte. Brasil, Reino Unido, Austrália e a maioria dos países da UE usam o padrão 35mm × 45mm. EUA e Filipinas usam 2×2 polegadas. Canadá usa um formato maior de 50mm × 70mm. Nossa ferramenta suporta compressão para todos esses tamanhos — basta selecionar o tamanho de arquivo alvo e enviar.</p>
        <h3>Como Comprimir Foto de Passaporte Online</h3>
        <ol>
          <li><strong>Envie sua foto</strong> — Clique na área de envio ou arraste e solte sua imagem (JPG, PNG ou WebP).</li>
          <li><strong>Escolha o tamanho alvo</strong> — Selecione 20KB, 50KB ou 100KB de acordo com os requisitos do seu portal de solicitação.</li>
          <li><strong>Baixe</strong> — Obtenha sua foto de passaporte comprimida instantaneamente, pronta para enviar.</li>
        </ol>
        <p>O processo completo é executado no seu navegador — <strong>susas fotos nunca são enviadas para nenhum servidor</strong>. Isso torna nossa ferramenta a forma mais segura de comprimir fotos de passaporte sensíveis online.</p>
        <p>Precisa comprimir fotos para um <a href={`${prefix}/compress-for-govt-form`} class="text-brand-600 hover:text-brand-700 underline">formulário governamental (SSC, UPSC, Banco)</a>? Ou converter sua imagem para <a href={`${prefix}/photo-to-base64`} class="text-brand-600 hover:text-brand-700 underline">Base64 para desenvolvimento web</a>?</p>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Ferramentas Relacionadas</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Experimente Nossas Outras Ferramentas</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href={`${prefix}/tools/compress-to-100kb`} class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Comprimir para 100KB</h3>
          <p class="text-sm text-text-secondary">Reduza imagens para menos de 100KB.</p>
        </a>
        <a href={`${prefix}/compress-for-govt-form`} class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Comprimir para Formulário Govt</h3>
          <p class="text-sm text-text-secondary">Reduza imagens para formulários SSC, UPSC.</p>
        </a>
        <a href={`${prefix}/photo-to-base64`} class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Foto para Base64</h3>
          <p class="text-sm text-text-secondary">Converta imagens em strings Base64.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    
    const config = { targetSize: 20 * 1024 };
    initTargetedCompressor(config);
    
    const targetSizeBtn = document.getElementById('target-size-btn');
    const sizeButtons = document.querySelectorAll('.size-btn');
    
    sizeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        sizeButtons.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
          b.classList.add('text-text-tertiary', 'border', 'border-border-default');
        });
        btn.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
        btn.classList.remove('text-text-tertiary', 'border', 'border-border-default');
        config.targetSize = parseInt(btn.dataset.size) * 1024;
        if (targetSizeBtn) targetSizeBtn.textContent = '≤ ' + btn.dataset.size + 'KB';
      });
    });
  </script>
</BaseLayout>
