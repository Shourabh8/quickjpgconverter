---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "pt" as const;
const prefix = getLocalePrefix(locale);

const breadcrumbs = [
  { name: "Ferramentas", url: `${prefix}/tools` },
  { name: "Comprimir para 100KB", url: `${prefix}/tools/compress-to-100kb` },
];

const faqItems = [
  {
    question: "Por que eu precisaria comprimir uma imagem para exatamente 100KB?",
    answer: "Muitos portais online, formulários governamentais e candidaturas de emprego exigem que fotos de passaporte ou documentos digitalizados estejam abaixo de 100KB. Esta ferramenta ajuda você a cumprir esses requisitos estritos de tamanho de arquivo mantendo a melhor qualidade possível.",
  },
  {
    question: "Minha imagem ficará embaçada após a compressão?",
    answer: "Nosso compressor usa redução inteligente de qualidade para atingir o tamanho alvo enquanto preserva tanto a qualidade visual quanto possível. O resultado é geralmente excelente para fotos e documentos a 100KB.",
  },
  {
    question: "Quais formatos de imagem são suportados?",
    answer: "Aceitamos formatos de entrada JPG, PNG e WebP. A saída sempre é JPG para garantir o menor tamanho de arquivo possível no alvo.",
  },
  {
    question: "Posso comprimir múltiplas imagens de uma vez?",
    answer: "Sim. Você pode enviar múltiplas imagens e comprimi-las todas para 100KB ou menos. Cada imagem é processada individualmente para atingir o tamanho alvo.",
  },
  {
    question: "Existe um limite de tamanho de arquivo para envios?",
    answer: "Você pode enviar imagens de até 50MB. O compressor funciona inteiramente no seu navegador, portanto o tempo de processamento depende do seu dispositivo e do número de imagens.",
  },
  {
    question: "Funciona em dispositivos móveis?",
    answer: "Sim. Nosso compressor funciona em qualquer dispositivo — iPhone, Android, tablet ou desktop. Sem necessidade de instalar aplicativos. Basta abrir a ferramenta no seu navegador e comprimir.",
  },
];

const steps = [
  { title: "Envie suas imagens", desc: "Arraste e solte ou clique para selecionar suas fotos." },
  { title: "Auto-comprimir", desc: "Nosso algoritmo reduz a qualidade para atingir exatamente 100KB." },
  { title: "Baixe o JPG", desc: "Obtenha sua imagem de 100KB instantaneamente, pronta para enviar." },
];

const relatedTools = [
  { slug: "compress-to-200kb", title: "Comprimir para 200KB", desc: "Comprima imagens para menos de 200KB." },
  { slug: "image-enhancer", title: "Aprimorador de Imagem", desc: "Melhore brilho, contraste e nitidez." },
  { slug: "image-compressor", title: "Compressor de Imagem", desc: "Compressão personalizada com controle deslizante de qualidade." },
  { slug: "resize-jpg", title: "Redimensionar JPG", desc: "Redimensione imagens para qualquer dimensão." },
  { slug: "jpg-to-png", title: "JPG para PNG", desc: "Converta JPG para PNG com qualidade sem perda." },
  { slug: "jpg-to-webp", title: "JPG para WebP", desc: "Converta JPG para o moderno formato WebP." },
];
---

<BaseLayout
  title="Comprimir Imagem para 100KB — Redutor de Fotos Gratuito Online"
  description="Comprima qualquer imagem para menos de 100KB para fotos de passaporte, envios de formulários e upload em portais. Ferramenta gratuita online que funciona no seu navegador — sem uploads, sem cadastro."
  canonical={`https://quickjpgconverter.com${prefix}/tools/compress-to-100kb`}
  keywords={["comprimir imagem para 100kb", "reduzir imagem para 100kb", "compressor de imagem 100kb", "imagem para 100kb"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  locale={locale}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Gratuito · Sem Cadastro · Privado
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Comprimir Imagem para <span class="gradient-text">100KB</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Perfeito para fotos de passaporte, envios de formulários e upload em portais. Comprima qualquer imagem para menos de 100KB mantendo a qualidade.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Tamanho alvo:</span>
            <div class="flex items-center gap-2">
              <span id="target-size-display" class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">100 KB</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Arraste suas imagens aqui</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">ou clique para selecionar do seu computador</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Selecionar Arquivos
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Máx 50MB por arquivo · Múltiplos arquivos suportados</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Solte para enviar</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 arquivos prontos</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Limpar tudo</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Alvo: ≤ 100KB</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Saída: JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Tamanho de Arquivo Alvo</h3>
                <div class="p-4 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30">
                  <div class="text-center">
                    <div class="text-3xl font-bold text-brand-600 dark:text-brand-400 mb-1">100KB</div>
                    <p class="text-xs text-text-secondary">Ideal para fotos de passaporte e envios de formulários</p>
                  </div>
                </div>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Formato de Saída</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">JPG</div>
                      <div class="text-xs text-text-tertiary">Com perda · Universal · Arquivos menores</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Comprimindo...</p>
              </div>
              <div id="compress-btn-area">
                <button id="compress-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Comprimir para 100KB
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Envie imagens para iniciar a compressão</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Suportados:</span>
          {["JPG", "PNG", "WebP"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Máx 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>Múltiplos arquivos</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="Comprimir para 100KB" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Como Funciona</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Três Passos</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {steps.map((step, i) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">0{i + 1}</div>
            <h3 class="text-base font-semibold text-text-primary mb-1.5">{step.title}</h3>
            <p class="text-sm text-text-secondary">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Por Que Comprimir para 100KB?</h2>
        <p>Muitos portais online, sites governamentais e candidaturas de emprego têm limites estritos de tamanho de arquivo. Fotos de passaporte, documentos de identidade e documentos digitalizados geralmente precisam estar abaixo de 100KB. Nosso compressor reduz inteligentemente a qualidade para atender a este requisito exato enquanto preserva a maior clareza visual possível.</p>
        <h3>Casos de Uso Comuns</h3>
        <ul>
          <li>Envio de fotos de passaporte e visto</li>
          <li>Envios de formulários em portais governamentais</li>
          <li>Requisitos de foto para candidaturas de emprego</li>
          <li>Formulários de admissão universitária</li>
          <li>Fotos de perfil em redes sociais com limites de tamanho</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Perguntas Frequentes</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Ferramentas Relacionadas</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Experimente Nossos Outros Conversores</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {relatedTools.map((tool) => (
          <a href={`${prefix}/tools/${tool.slug}`} class="card-hover p-5 group">
            <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{tool.title}</h3>
            <p class="text-sm text-text-secondary">{tool.desc}</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    document.addEventListener("DOMContentLoaded", () => initTargetedCompressor({ targetSize: 100 * 1024 }));
  </script>
</BaseLayout>
