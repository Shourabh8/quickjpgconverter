---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [{ name: "Contact", url: "/contact/" }];

const email = "supportquickjpgconverter@gmail.com";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Quick JPG Converter",
  description: "Get in touch with the Quick JPG Converter engineering and support team for technical help, feedback, and privacy inquiries.",
  url: "https://quickjpgconverter.com/contact/",
  mainEntity: {
    "@type": "Organization",
    name: "Quick JPG Converter",
    url: "https://quickjpgconverter.com/",
    contactPoint: {
      "@type": "ContactPoint",
      email: email,
      contactType: "customer support",
      availableLanguage: ["English", "Spanish", "German", "French", "Portuguese", "Hindi"],
    },
  },
};
---

<BaseLayout
  title="Contact Us — Quick JPG Converter Support & Feedback"
  description="Get in touch with the Quick JPG Converter team. Reach our engineers for tool questions, bug reports, feature requests, and privacy support."
  canonical="https://quickjpgconverter.com/contact/"
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-8 text-center max-w-xl mx-auto mb-10">
        <Badge class="mb-3">Get in Touch</Badge>
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-3">
          Contact Our Team
        </h1>
        <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
          Have a question about our browser-based tools, spotted a bug, or have a suggestion? We're here to help.
        </p>
      </div>

      <!-- Quick Contact Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="p-5 rounded-2xl border border-border-default bg-surface text-center">
          <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center mx-auto mb-3 text-brand-600 dark:text-brand-400 text-lg">
            ✉️
          </div>
          <h3 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-1">Direct Email</h3>
          <p class="text-xs text-text-secondary mb-2">Fastest response for inquiries</p>
          <a href={`mailto:${email}`} class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline break-all">
            {email}
          </a>
        </div>

        <div class="p-5 rounded-2xl border border-border-default bg-surface text-center">
          <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center mx-auto mb-3 text-brand-600 dark:text-brand-400 text-lg">
            ⏱️
          </div>
          <h3 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-1">Response Time</h3>
          <p class="text-xs text-text-secondary mb-2">Mon–Fri, 9am–6pm EST</p>
          <span class="text-xs font-semibold text-text-primary">Within 24–48 hours</span>
        </div>

        <div class="p-5 rounded-2xl border border-border-default bg-surface text-center">
          <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center mx-auto mb-3 text-brand-600 dark:text-brand-400 text-lg">
            🛡️
          </div>
          <h3 class="text-xs font-bold text-text-primary uppercase tracking-wider mb-1">Privacy Guarantee</h3>
          <p class="text-xs text-text-secondary mb-2">Zero server storage</p>
          <a href="/privacy/" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
            Read Privacy Policy →
          </a>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="p-6 sm:p-8 rounded-3xl border border-border-default bg-surface shadow-xs mb-12">
        <h2 class="text-xl font-bold text-text-primary mb-2">Send Us a Direct Message</h2>
        <p class="text-xs sm:text-sm text-text-secondary mb-6">
          Fill out the form below and our team will get back to you promptly.
        </p>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-text-primary mb-1">Your Name *</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                autocomplete="name"
                required
                placeholder="Jane Doe"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-default bg-surface text-text-primary placeholder:text-text-tertiary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all min-h-[44px]"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-text-primary mb-1">Your Email Address *</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                required
                placeholder="jane@example.com"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-default bg-surface text-text-primary placeholder:text-text-tertiary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all min-h-[44px]"
              />
            </div>
          </div>

          <div>
            <label for="contact-topic" class="block text-xs font-semibold text-text-primary mb-1">Topic / Category *</label>
            <select
              id="contact-topic"
              name="topic"
              required
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-default bg-surface text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
            >
              <option value="General Inquiry">General Question or Feedback</option>
              <option value="Bug Report">Technical Support & Bug Report</option>
              <option value="Feature Request">New Format or Tool Request</option>
              <option value="Privacy Concern">Privacy & Data Handling Concern</option>
              <option value="Partnership / AdSense">Advertising & Partnership Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-text-primary mb-1">Your Message *</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Tell us what's on your mind... (Please include your browser and operating system if reporting a bug)"
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-default bg-surface text-text-primary placeholder:text-text-tertiary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            <span class="text-[11px] text-text-tertiary">Opens your email client addressed to {email}.</span>
            <button
              type="submit"
              id="contact-submit-btn"
              class="px-5 py-2.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl transition-all shadow-xs cursor-pointer inline-flex items-center gap-1.5 min-h-[44px]"
            >
              <span>Compose Email</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
            </button>
          </div>

          <div id="contact-success" aria-live="polite" class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-xs hidden">
            Your email draft is ready. If your mail app did not open automatically, <a id="contact-gmail-link" href={`mailto:${email}`} target="_blank" rel="noopener noreferrer" class="underline font-semibold">open in Gmail</a> or email <a href={`mailto:${email}`} class="underline font-semibold">{email}</a> directly.
          </div>
        </form>
      </div>

      <!-- Additional Detailed Sections for E-E-A-T and Transparency -->
      <article class="prose">
        <h2>Technical Support & Troubleshooting</h2>
        <p>
          Before filing a technical bug ticket, please note that our converter works entirely inside your browser using modern Web APIs (Canvas API, Web Workers, and WebAssembly). If you encounter an unexpected error:
        </p>
        <ul>
          <li><strong>Clear browser cache:</strong> Outdated cached scripts can occasionally prevent new canvas features from initializing.</li>
          <li><strong>Browser compatibility:</strong> We recommend using the latest version of Google Chrome, Apple Safari, Mozilla Firefox, or Microsoft Edge.</li>
          <li><strong>Hardware acceleration:</strong> For large 40MB+ image batch operations, ensure hardware acceleration is enabled in your browser settings.</li>
        </ul>

        <h2>Publisher & Legal Inquiries</h2>
        <p>
          Quick JPG Converter (<a href="https://quickjpgconverter.com">quickjpgconverter.com</a>) is maintained by full-stack developer Shourabh Sharma and dedicated technical contributors. For legal matters, DMCA notices, trademark questions, or publisher partnership discussions, please contact our legal desk at <a href={`mailto:${email}`}>{email}</a>.
        </p>

        <h2>Office Hours & Operations</h2>
        <p>
          Email support is active <strong>Monday through Friday, 9:00 AM – 6:00 PM EST</strong>. Inquiries submitted over the weekend or on public holidays are addressed on the following business day in the order received.
        </p>
      </article>
    </Container>
  </section>
</BaseLayout>

<script is:inline define:vars={{ supportEmail: email }}>
(function() {
  var form = document.getElementById('contact-form');
  var successMsg = document.getElementById('contact-success');
  var gmailLink = document.getElementById('contact-gmail-link');

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();

      var name = document.getElementById('contact-name')?.value.trim() || '';
      var senderEmail = document.getElementById('contact-email')?.value.trim() || '';
      var topic = document.getElementById('contact-topic')?.value || 'General Inquiry';
      var message = document.getElementById('contact-message')?.value.trim() || '';

      var subject = '[QuickJPG - ' + topic + '] Message from ' + name;
      var body = 'Name: ' + name + '\nReply-To: ' + senderEmail + '\nTopic: ' + topic + '\n\n' + message;

      if (gmailLink) {
        gmailLink.href = 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(supportEmail) + '&su=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      }
      if (successMsg) {
        successMsg.classList.remove('hidden');
      }

      window.location.href = 'mailto:' + supportEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  }
})();
</script>
