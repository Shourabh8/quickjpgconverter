---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [{ name: "PNG Compressor", url: "/png-compressor" }];

const faqItems = [
  {
    question: "Does PNG compression remove the transparency?",
    answer: "No. Our PNG compressor preserves transparency (alpha channel) during compression. Your transparent PNGs will remain transparent after compression.",
  },
  {
    question: "How is PNG compression different from JPG compression?",
    answer: "PNG uses lossless compression by default — you can reduce file size without any quality loss. However, PNG files are typically larger than equivalent JPGs. For photos, JPG is usually better. For logos, icons, and graphics, PNG is ideal.",
  },
  {
    question: "Can I compress animated PNGs (APNGs)?",
    answer: "Standard PNG compression is applied. Animated PNGs may lose animation as we process each file as a static image. For animated files, we recommend using a dedicated animation optimizer.",
  },
  {
    question: "How much can PNG files be compressed?",
    answer: "Lossless PNG compression typically achieves 10–30% reduction. For greater reduction, consider converting to WebP which offers superior compression while maintaining visual quality.",
  },
  {
    question: "Are my PNG files uploaded anywhere?",
    answer: "No. All processing happens locally in your browser. Your files never leave your device.",
  },
];
---

<BaseLayout
  title="Free PNG Compressor — Reduce PNG Size Online Without Quality Loss"
  description="Compress PNG files online for free. Reduce PNG file size by up to 40% while keeping transparency intact. 100% private, no uploads required."
  canonical="https://quickjpgconverter.com/png-compressor"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["png compressor", "compress png", "reduce png size", "png optimizer", "compress png online free", "lossless png compression"]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <!-- Title Section -->
  <section class="pb-6 sm:pb-8 bg-glow">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">🖼️ Lossless PNG Compression</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          <span class="gradient-text">PNG</span> Compressor
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Reduce PNG file size while preserving transparency and visual quality.
          100% private — runs entirely in your browser.
        </p>
      </div>
    </Container>
  </section>

  <!-- Compressor Widget -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar -->
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Compress PNG files</span>
            <div class="flex items-center gap-1.5 text-xs text-text-tertiary">
              <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
              Local Processing
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[440px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
                >
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your PNG files here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose PNG Files
                    <input type="file" class="sr-only" accept=".png,image/png" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">PNG · Transparency preserved · Max 50MB each</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to compress</p>
                  </div>
                </div>
              </div>

              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Options + Actions -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col justify-between">
              <div>
                <h3 class="text-sm font-semibold text-text-primary mb-3">Compression Mode</h3>
                <div class="space-y-2 mb-6">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30 cursor-pointer transition-all duration-200">
                    <input type="radio" name="mode" value="lossless" checked class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-text-primary">Lossless (Recommended)</div>
                      <div class="text-xs text-text-tertiary mt-0.5">100% quality preserved, transparency safe</div>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                    <input type="radio" name="mode" value="lossy" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-text-primary">Lossy</div>
                      <div class="text-xs text-text-tertiary mt-0.5">Smaller files, slight quality reduction</div>
                    </div>
                  </label>
                </div>

                <div class="h-px bg-border-default mb-6"></div>

                <div class="mb-6">
                  <div class="flex items-center justify-between mb-2">
                    <label class="text-sm font-semibold text-text-primary" for="quality-slider">Quality</label>
                    <span id="quality-value" class="text-sm font-medium text-brand-600 dark:text-brand-400">80%</span>
                  </div>
                  <input
                    id="quality-slider"
                    type="range"
                    min="10"
                    max="95"
                    value="80"
                    class="w-full h-2 bg-surface-muted rounded-full appearance-none cursor-pointer accent-brand-600"
                  />
                  <div class="flex justify-between text-xs text-text-tertiary mt-1">
                    <span>Smaller</span>
                    <span>Better Quality</span>
                  </div>
                </div>

                <div class="h-px bg-border-default mb-6"></div>

                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-2 mb-1">
                    <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-xs font-semibold text-text-primary">Transparency Preserved</span>
                  </div>
                  <p class="text-xs text-text-tertiary">Alpha channel is maintained during compression</p>
                </div>
              </div>

              <div>
                <div id="progress-area" class="hidden mb-4">
                  <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compressing...</p>
                </div>

                <div id="compress-btn-area">
                  <button id="compress-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    Compress PNG
                  </button>
                  <p class="text-xs text-text-tertiary text-center mt-2">Processed locally in your browser</p>
                </div>

                <div id="download-area" class="hidden"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- How It Works -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Compress PNGs in Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Upload PNGs</h3>
          <p class="text-sm text-text-secondary">Drag and drop your PNG files. Batch upload supported.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Select Mode</h3>
          <p class="text-sm text-text-secondary">Choose lossless to preserve transparency or lossy for maximum reduction.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download</h3>
          <p class="text-sm text-text-secondary">Get your compressed PNGs individually or as a ZIP.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SEO & FAQ -->
  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Compress PNG Files?</h2>
        <p>
          PNG is the preferred format for graphics, logos, screenshots, and any image requiring transparency. However, PNG files can be extremely large compared to other formats — a 1920×1080 PNG screenshot might be 2–4MB, while a compressed version is under 500KB with no visible quality difference.
        </p>
        <p>
          Compressing PNG files is essential for web performance. Large PNG files increase page load times, harm Core Web Vitals scores, and waste bandwidth. For logos and UI graphics served millions of times daily, even a 30% PNG reduction translates to significant CDN cost savings.
        </p>

        <h3>When to Use PNG vs JPG</h3>
        <ul>
          <li><strong>Use PNG</strong> for logos, icons, UI elements, screenshots, and any image needing transparency</li>
          <li><strong>Use JPG</strong> for photographs and images where transparency isn't needed</li>
          <li><strong>Use WebP</strong> for the best of both worlds — smaller size with optional transparency</li>
        </ul>

        <h3>PNG Compression Tips</h3>
        <ul>
          <li>Use lossless compression for logos and UI elements where pixel-perfect quality matters</li>
          <li>Consider converting photos from PNG to JPG if transparency isn't needed</li>
          <li>For web logos, converting to SVG (if vector-based) provides infinite scalability with tiny file sizes</li>
          <li>Reduce image dimensions to the actual display size before compressing</li>
        </ul>
      </div>

      <div class="mt-12">
        <div class="text-center mb-10">
          <Badge class="mb-4">FAQ</Badge>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
        </div>
        <FAQ items={faqItems} />
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/jpg-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG Compressor</h3>
          <p class="text-sm text-text-secondary">Reduce JPG file size by up to 80%.</p>
        </a>
        <a href="/png-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PNG to JPG</h3>
          <p class="text-sm text-text-secondary">Convert PNG to JPG for smaller photos.</p>
        </a>
        <a href="/jpg-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PNG</h3>
          <p class="text-sm text-text-secondary">Convert JPG to PNG with transparency support.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initImageCompressor } from "@scripts/compressor.js";
    document.addEventListener("DOMContentLoaded", () => {
      initImageCompressor();
    });
  </script>
</BaseLayout>
