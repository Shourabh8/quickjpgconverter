---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import ActiveConverter from "@components/tool/ActiveConverter.astro";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "CR2 to JPG", url: "/cr2-to-jpg" },
];

const faqItems = [
  {
    question: "What is a CR2 file?",
    answer: "CR2 (Canon Raw version 2) is a RAW image format used by Canon digital cameras. It contains unprocessed sensor data, giving photographers maximum flexibility for editing exposure, white balance, and other settings in post-processing.",
  },
  {
    question: "Why convert CR2 to JPG?",
    answer: "CR2 files are large and require specialized software to view and edit. Converting to JPG creates smaller, universally compatible files that can be shared, uploaded, and viewed on any device without special software.",
  },
  {
    question: "Can I convert CR2 to JPG in my browser?",
    answer: "Browser-based CR2 conversion has limited support. For best results, we recommend using dedicated software like Adobe Lightroom, Canon's Digital Photo Professional, or free tools like RawTherapee. Our converter can handle CR2 files in supported browsers.",
  },
  {
    question: "Will converting CR2 to JPG reduce quality?",
    answer: "CR2 files contain raw sensor data with high dynamic range. Converting to JPG applies lossy compression and clips the dynamic range. For casual sharing, the quality is excellent. For professional editing, keep the CR2 file and work with it in RAW-capable software.",
  },
  {
    question: "What software can open CR2 files?",
    answer: "Adobe Lightroom, Canon Digital Photo Professional, RawTherapee (free), darktable (free), and most modern photo editors can open and process CR2 files. On Mac, Preview can view CR2 files natively.",
  },
  {
    question: "How do I convert CR2 to JPG on Mac?",
    answer: "On Mac, you can open CR2 files in Preview and export as JPG. For batch conversion, use our online tool or Canon's Digital Photo Professional software included with your camera.",
  },
];
---

<BaseLayout
  title="Free CR2 to JPG Converter — Convert Canon RAW Online"
  description="Convert Canon CR2 RAW photos to JPG with our free CR2 to JPG converter. Works in your browser. No uploads, 100% private."
  canonical="https://quickjpgconverter.com/cr2-to-jpg"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["cr2 to jpg converter", "cr2 to jpg", "convert cr2 to jpg", "canon raw to jpg", "cr2 to jpg online free", "free cr2 to jpg converter", "cr2 to jpg free", "canon photo converter"]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <!-- Title Section -->
  <section class="pb-6 sm:pb-8 bg-glow">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">📷 Canon RAW Converter</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          CR2 to <span class="gradient-text">JPG</span> Converter
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Convert Canon CR2 RAW photos to universally compatible JPG format.
          No uploads, 100% private — runs entirely in your browser.
        </p>
      </div>
    </Container>
  </section>

  <!-- Converter Widget -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <ActiveConverter
          targetFormat="jpg"
          targetExt="jpg"
          targetMime="image/jpeg"
          accept=".cr2,.cr3"
          inputFormat="CR2 (Canon RAW)"
          outputFormat="JPG"
        />
      </div>
    </Container>
  </section>

  <!-- How It Works -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your CR2</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select your Canon RAW files.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Convert instantly</h3>
          <p class="text-sm text-text-secondary">Your image is converted in-browser. No server uploads.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download JPG</h3>
          <p class="text-sm text-text-secondary">Get your compatible JPG file instantly.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SEO Prose & FAQs -->
  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Convert CR2 to JPG?</h2>
        <p>
          CR2 (Canon Raw version 2) is the RAW image format used by Canon digital cameras. While RAW files offer photographers maximum editing flexibility, they're large, proprietary, and can't be easily shared or viewed on most devices. Converting CR2 to JPG creates smaller, universally compatible files.
        </p>
        <p>
          JPG is the most universally supported image format — it works on every device, every browser, every social media platform, and every design tool. Once converted, your Canon photos work everywhere without any compatibility issues.
        </p>

        <h3>When You Need JPG</h3>
        <ul>
          <li>Sharing photos on social media platforms</li>
          <li>Uploading to photo printing services</li>
          <li>Sending photos via email or messaging apps</li>
          <li>Using in web projects or presentations</li>
          <li>Sharing with people who don't have RAW-capable software</li>
          <li>Archiving photos for long-term storage</li>
        </ul>

        <h3>CR2 vs JPG: Key Differences</h3>
        <p>
          CR2 files contain unprocessed sensor data from your Canon camera, typically 20-50MB each. They store far more dynamic range and color information than JPG, giving photographers maximum flexibility in post-processing. However, this raw data requires specialized software to view and edit.
        </p>
        <p>
          JPG files are processed and compressed, typically 2-8MB each. They offer excellent quality for viewing and sharing while being universally compatible. The trade-off is less editing flexibility — once converted, you can't recover the full dynamic range of the original RAW data.
        </p>

        <h3>Benefits of Our Converter</h3>
        <ul>
          <li><strong>100% private</strong> — your photos never leave your device</li>
          <li><strong>No software needed</strong> — works in your browser</li>
          <li><strong>Batch conversion</strong> — convert multiple photos at once</li>
          <li><strong>Quality control</strong> — choose between high quality, balanced, or smallest size</li>
          <li><strong>Free forever</strong> — no sign-up, no payment, no watermarks</li>
        </ul>
      </div>

      <div class="mt-12">
        <div class="text-center mb-10">
          <Badge class="mb-4">FAQ</Badge>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
        </div>
        <FAQ items={faqItems} />
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/heic-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">HEIC to JPG</h3>
          <p class="text-sm text-text-secondary">Convert iPhone HEIC photos to JPG.</p>
        </a>
        <a href="/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Compressor</h3>
          <p class="text-sm text-text-secondary">Compress images without quality loss.</p>
        </a>
        <a href="/resize-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Resize JPG</h3>
          <p class="text-sm text-text-secondary">Resize images to any dimension.</p>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
