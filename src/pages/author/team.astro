---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "About", url: "/about/" },
  { name: "Founder & Developer", url: "/author/shourabh/" },
];
---

<BaseLayout
  title="Quick JPG Converter Author — Shourabh Sharma"
  description="Quick JPG Converter is built and maintained independently by full-stack developer Shourabh Sharma."
  canonical="https://quickjpgconverter.com/author/team/"
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-10 p-8 rounded-2xl border border-border-default bg-surface text-center">
        <h1 class="text-2xl sm:text-3xl font-bold text-text-primary mb-3">
          Maintained by Shourabh Sharma
        </h1>
        <p class="text-text-secondary max-w-xl mx-auto mb-6">
          Quick JPG Converter is developed and maintained independently to provide fast, privacy-first browser utilities.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/author/shourabh/" class="btn-primary btn-md">
            View Founder Profile &amp; Guides
          </a>
          <a href="/about/" class="btn-secondary btn-md">
            About QuickJPG
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

