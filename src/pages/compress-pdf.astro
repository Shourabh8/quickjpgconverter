---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compress PDF", url: "/compress-pdf" },
];
---

<BaseLayout
  title="Compress PDF — Free Online PDF Compressor"
  description="Compress PDF files online for free. Reduce file size while preserving quality. 100% private — no uploads required."
  canonical="https://quickjpgconverter.com/compress-pdf"
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-8 mb-10 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-4">
          Compress PDF Documents
        </h1>
        <p class="text-lg text-text-secondary max-w-xl mx-auto mb-6">
          You're in the right place. Our PDF compressor reduces file size while
          preserving all text, images, and formatting.
        </p>
        <Button href="/tools/pdf-compressor" size="lg">
          Open PDF Compressor
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </Button>
        <p class="text-sm text-text-tertiary mt-4">PDF files only · Preserves all content · 100% private</p>
      </div>
    </Container>
  </section>
</BaseLayout>
