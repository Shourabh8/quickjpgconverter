---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "Remove Background", url: "/tools/remove-background" },
];

const faqItems = [
  {
    question: "How does background removal work?",
    answer: "Our AI model runs entirely in your browser to detect the main subject in your image and separate it from the background. The result is a PNG with transparent background.",
  },
  {
    question: "Will my image be uploaded to a server?",
    answer: "No. The entire process happens locally in your browser using AI. Your image never leaves your device, ensuring complete privacy.",
  },
  {
    question: "What image formats are supported?",
    answer: "JPG, PNG, WebP, BMP, and GIF images can be processed. The output is always PNG with transparent background.",
  },
  {
    question: "How long does it take?",
    answer: "On first use, the AI model downloads (~45MB) and caches in your browser. After that, background removal typically takes 3-15 seconds depending on your device and image size.",
  },
  {
    question: "What types of images work best?",
    answer: "Photos with a clear subject (person, product, animal) against a distinct background work best. Complex scenes with multiple subjects may have mixed results.",
  },
];
---

<BaseLayout
  title="Free Background Remover — AI Remove Image Background Online"
  description="Remove image backgrounds instantly with AI. 100% private — runs entirely in your browser. No uploads, no signup. Get transparent PNG output."
  canonical="https://quickjpgconverter.com/tools/remove-background"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["remove background", "background remover", "remove image background", "transparent background", "AI background removal", "free background remover", "online background eraser", "cut out image", "remove bg", "photo background remover"]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
          Free · AI-Powered · 100% Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Remove <span class="gradient-text">Background</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          AI-powered background removal that runs entirely in your browser.
          Your images never leave your device. Get transparent PNG output instantly.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-4xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">AI Background Removal</span>
            <div class="flex items-center gap-3">
              <span id="model-status" class="text-xs font-medium text-amber-600 dark:text-amber-400">AI model not loaded</div>
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
                <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">Remove</span>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[400px]">
            <!-- LEFT: Upload / Preview -->
            <div class="p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your image here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Image
                    <input type="file" class="sr-only" accept="image/*" />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP, BMP, GIF · Max 50MB</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>

              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary truncate"></span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear</button>
                  </div>
                  <div class="flex-1 p-4 overflow-auto flex items-center justify-center bg-surface-muted/30">
                    <img id="preview-image" class="max-w-full max-h-[350px] rounded-lg shadow-sm object-contain" alt="Preview" />
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Actions -->
            <div class="p-5 sm:p-6 flex flex-col">
              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3">How It Works</h3>
                <div class="space-y-3">
                  <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <span class="text-xs font-bold text-brand-600 dark:text-brand-400">1</span>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text-primary">Upload your image</p>
                      <p class="text-xs text-text-tertiary">Drag & drop or click to select</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <span class="text-xs font-bold text-brand-600 dark:text-brand-400">2</span>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text-primary">AI removes background</p>
                      <p class="text-xs text-text-tertiary">Runs entirely in your browser</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <span class="text-xs font-bold text-brand-600 dark:text-brand-400">3</span>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text-primary">Download transparent PNG</p>
                      <p class="text-xs text-text-tertiary">Ready to use anywhere</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="h-px bg-border-default mb-5"></div>

              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-2">Privacy First</h3>
                <div class="flex items-center gap-2 p-3 rounded-lg bg-success/5 border border-success/20">
                  <svg class="w-5 h-5 text-success flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                  </svg>
                  <p class="text-xs text-text-secondary">100% private — your image never leaves your browser</p>
                </div>
              </div>

              <div class="flex-1"></div>

              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Preparing...</p>
              </div>

              <button id="remove-btn" class="w-full btn-primary btn-lg justify-center hidden">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                Remove Background
              </button>

              <div id="download-area" class="hidden mt-4"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="Background Remover" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">AI-Powered Background Removal</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Upload Image</h3>
          <p class="text-sm text-text-secondary">Drop or click to select your image file.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">AI Processing</h3>
          <p class="text-sm text-text-secondary">Our AI detects the subject and removes the background automatically.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download PNG</h3>
          <p class="text-sm text-text-secondary">Get your image with transparent background instantly.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Professional Background Removal</h2>
        <p>Remove backgrounds from photos instantly using advanced AI that runs entirely in your browser. Unlike other tools that upload your images to servers, our tool keeps everything private — your photos never leave your device.</p>
        <h3>Perfect For</h3>
        <ul>
          <li><strong>Product photos</strong> — Create clean white or transparent backgrounds for e-commerce</li>
          <li><strong>Portraits</strong> — Get professional headshots with transparent backgrounds</li>
          <li><strong>Social media</strong> — Create eye-catching images for posts and stories</li>
          <li><strong>Design projects</strong> — Extract subjects for composites and collages</li>
          <li><strong>Passport photos</strong> — Remove backgrounds for official documents</li>
        </ul>
        <h3>Why Choose Our Background Remover?</h3>
        <ul>
          <li><strong>100% Private</strong> — Your images never leave your browser</li>
          <li><strong>AI-Powered</strong> — Advanced neural network for accurate subject detection</li>
          <li><strong>Free Forever</strong> — No signup, no watermarks, no limits</li>
          <li><strong>Works Offline</strong> — After first load, the AI model caches in your browser</li>
          <li><strong>All Formats</strong> — JPG, PNG, WebP, BMP, GIF input → PNG output</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Tools</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Compressor</h3>
          <p class="text-sm text-text-secondary">Reduce file size with quality control.</p>
        </a>
        <a href="/tools/image-enhancer" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Enhancer</h3>
          <p class="text-sm text-text-secondary">Enhance brightness, contrast, and sharpness.</p>
        </a>
        <a href="/tools/resize-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Resize JPG</h3>
          <p class="text-sm text-text-secondary">Resize images to any dimension.</p>
        </a>
        <a href="/tools/jpg-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PNG</h3>
          <p class="text-sm text-text-secondary">Convert JPG to PNG with transparency.</p>
        </a>
        <a href="/tools/png-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PNG to JPG</h3>
          <p class="text-sm text-text-secondary">Convert PNG images to JPG format.</p>
        </a>
        <a href="/tools/compress-to-100kb" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress to 100KB</h3>
          <p class="text-sm text-text-secondary">Reduce images to under 100KB.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initBackgroundRemover } from "@scripts/remove-background.js";
    document.addEventListener("DOMContentLoaded", () => initBackgroundRemover());
  </script>
</BaseLayout>
