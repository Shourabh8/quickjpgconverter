---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "PDF Compressor", url: "/tools/pdf-compressor" },
];

const faqItems = [
  {
    question: "How does PDF compression work?",
    answer: "Our PDF compressor uses pdf-lib to analyze your PDF structure, remove unnecessary metadata, and recompress content streams using object streams. This reduces file size while preserving all text, images, and formatting.",
  },
  {
    question: "Will compression affect PDF quality?",
    answer: "Text and vector graphics are preserved perfectly. Images within the PDF may be recompressed, but at default settings the visual quality remains excellent. The primary savings come from removing redundant metadata and optimizing the internal structure.",
  },
  {
    question: "Is my PDF data safe?",
    answer: "Absolutely. All processing happens entirely in your browser using pdf-lib. Your PDF is never uploaded to any server. The file stays on your device from start to finish.",
  },
  {
    question: "What PDF features are preserved?",
    answer: "All text, images, fonts, links, bookmarks, and form fields are preserved. Page layout, annotations, and security settings (if not password-protected) are maintained through the compression process.",
  },
  {
    question: "Can I compress password-protected PDFs?",
    answer: "Our compressor can attempt to process encrypted PDFs, but password-protected files may fail if the encryption prevents structural analysis. Remove the password first, then compress.",
  },
  {
    question: "How much can I reduce PDF file size?",
    answer: "Results vary depending on the PDF's content and structure. PDFs with lots of metadata or uncompressed streams typically see 10-30% reduction. PDFs that are already optimized may see minimal reduction.",
  },
];
---

<BaseLayout
  title="Free PDF Compressor — Reduce PDF File Size Online"
  description="Compress PDF files instantly in your browser. Reduce file size while preserving quality. 100% private — no uploads required. Fast, free, and secure."
  canonical="https://quickjpgconverter.com/tools/pdf-compressor"
  keywords={["pdf compressor", "compress pdf", "reduce pdf size", "compress pdf online"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "PDF Compressor",
    description: "Compress PDF files to reduce size while preserving quality.",
    url: "https://quickjpgconverter.com/tools/pdf-compressor",
    featureList: ["Reduce PDF file size", "Quality preservation", "Batch compression", "Instant processing", "No software needed", "Works in browser", "Free to use"],
  }}
  noindex={true}
>
  <section class="section">
    <Container>
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-8 mb-8 text-center max-w-2xl mx-auto">
        <Badge class="mb-4">Free · No Signup · Private</Badge>
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-3">
          Free Online PDF <span class="gradient-text">Compressor</span> — Reduce PDF File Size
        </h1>
        <p class="text-base text-text-secondary">
          Reduce PDF file size instantly in your browser. Preserve text, images, and formatting. Your files never leave your device.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <!-- Upload zone -->
        <div id="upload-zone">
          <div
            id="drop-area"
            class="relative min-h-[280px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
          >
            <div class="w-16 h-16 rounded-2xl bg-danger/10 dark:bg-danger/5 flex items-center justify-center border border-danger/20 dark:border-danger/10 mb-5 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8 text-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your PDF here</h3>
            <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
            <label class="btn-primary btn-md cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Choose PDF
              <input type="file" class="sr-only" accept=".pdf" />
            </label>
            <p class="text-xs text-text-tertiary mt-4">PDF files only · Max 50MB</p>
            <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
              <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
              </svg>
              <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
            </div>
          </div>
        </div>

        <!-- Result zone -->
        <div id="result-zone" class="hidden">
          <div id="file-info" class="mb-6"></div>

          <!-- Compression Level -->
          <div class="mb-6">
            <h3 class="text-sm font-semibold text-text-primary mb-3">Compression Level</h3>
            <div class="space-y-2">
              <label class="flex items-start gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                <input type="radio" name="compression" value="low" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-text-primary">Low Compression</div>
                  <div class="text-xs text-text-tertiary mt-0.5">Fast processing, larger file size</div>
                </div>
              </label>
              <label class="flex items-start gap-3 p-3 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30 cursor-pointer transition-all duration-200">
                <input type="radio" name="compression" value="medium" checked class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-text-primary">Medium Compression</div>
                  <div class="text-xs text-text-tertiary mt-0.5">Balanced speed and file size</div>
                </div>
              </label>
              <label class="flex items-start gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                <input type="radio" name="compression" value="high" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-text-primary">High Compression</div>
                  <div class="text-xs text-text-tertiary mt-0.5">Smaller file size, optimized structure</div>
                </div>
              </label>
            </div>
          </div>

          <!-- Page Resolution -->
          <div class="mb-6">
            <h3 class="text-sm font-semibold text-text-primary mb-3">Page Resolution</h3>
            <p class="text-xs text-text-tertiary mb-3">Lower resolution = smaller file</p>
            <div class="space-y-2">
              <label class="flex items-center gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                <input type="radio" name="resolution" value="1.5" class="w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                <span class="text-sm text-text-primary">Standard (1.5x)</span>
              </label>
              <label class="flex items-center gap-3 p-3 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30 cursor-pointer transition-all duration-200">
                <input type="radio" name="resolution" value="1" checked class="w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                <span class="text-sm text-text-primary">Optimized (1x)</span>
              </label>
              <label class="flex items-center gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                <input type="radio" name="resolution" value="0.7" class="w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                <span class="text-sm text-text-primary">Compact (0.7x)</span>
              </label>
            </div>
          </div>

          <!-- Progress -->
          <div id="progress-area" class="hidden mb-6">
            <div class="mb-2">
              <div class="flex items-center justify-between text-xs text-text-secondary mb-1">
                <span id="progress-text">Compressing...</span>
              </div>
              <div class="w-full h-2 rounded-full bg-surface-muted overflow-hidden">
                <div id="progress-bar" class="h-full rounded-full bg-brand-500 transition-all duration-300" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%"></div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-3">
            <button id="compress-btn" class="flex-1 btn-primary btn-lg justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375" />
              </svg>
              Compress PDF
            </button>
            <button id="download-btn" class="flex-1 btn-primary btn-lg justify-center hidden">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download Compressed PDF
            </button>
          </div>
          <button id="compress-more-btn" class="w-full btn-secondary btn-md justify-center mt-3 hidden">
            Compress Another PDF
          </button>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="PDF Compressor" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your PDF</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select your PDF file.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Compress</h3>
          <p class="text-sm text-text-secondary">Our engine optimizes the PDF structure and compresses streams.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download</h3>
          <p class="text-sm text-text-secondary">Get your compressed PDF with all content preserved.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Compress Your PDFs?</h2>
        <p>Large PDF files are difficult to share via email, slow to download, and consume unnecessary storage space. PDF compression reduces file size while preserving all text, images, fonts, and formatting. For businesses, students, and anyone who regularly shares documents, compression is a basic productivity optimization.</p>
        <p>Our PDF compressor works entirely in your browser using pdf-lib. Unlike server-based tools that upload your files to remote servers, our compressor processes everything locally. Your documents never leave your device — guaranteed privacy every time.</p>

        <h2>What Gets Compressed</h2>
        <p>The compressor optimizes several aspects of your PDF:</p>
        <ul>
          <li><strong>Metadata</strong> — removes unnecessary author, title, and creator information</li>
          <li><strong>Content streams</strong> — recompresses text and drawing commands using efficient encoding</li>
          <li><strong>Object streams</strong> — bundles PDF objects for better compression ratios</li>
          <li><strong>Internal structure</strong> — removes redundant cross-reference data</li>
        </ul>
        <p>Text, vector graphics, and page layout are preserved perfectly. Images within the PDF are maintained at their current quality level.</p>

        <h2>When to Compress PDFs</h2>
        <p><strong>Email attachments</strong> — many email services limit attachment sizes to 5-25MB. Compressing a 20MB PDF to 12MB can mean the difference between a successful send and a bounced message.</p>
        <p><strong>Web downloads</strong> — smaller PDFs load faster for your visitors, improving user experience and reducing bandwidth costs.</p>
        <p><strong>Storage</strong> — if you archive large numbers of PDFs, compression can save significant disk space over time.</p>
        <p><strong>Compliance</strong> — some government and legal systems have file size limits for PDF submissions.</p>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <p>Also check out our <a href="/tools/image-compressor">Image Compressor</a> for reducing JPG, PNG, WebP, and AVIF file sizes, and our <a href="/jpg-to-webp">JPG to WebP converter</a> for modern web image optimization.</p>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { initPdfCompressor } from "@scripts/pdf-compressor";
  document.addEventListener("DOMContentLoaded", () => initPdfCompressor());
</script>
