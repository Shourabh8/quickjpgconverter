---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "Image Enhancer", url: "/tools/image-enhancer" },
];

const faqItems = [
  {
    question: "What enhancements can I apply?",
    answer: "You can adjust brightness, contrast, saturation, sharpness, and apply grayscale or sepia effects. All changes are shown in real-time preview.",
  },
  {
    question: "Will my images be uploaded?",
    answer: "No. All processing happens in your browser using Canvas API. Your images never leave your device.",
  },
  {
    question: "What image formats are supported?",
    answer: "JPG, PNG, WebP, BMP, and GIF images can be enhanced. Output is always PNG for maximum quality.",
  },
  {
    question: "Can I reset and start over?",
    answer: "Yes. Use the Reset button to return to original settings, or 'Enhance Another Image' to start fresh.",
  },
];
---

<BaseLayout
  title="Free Image Enhancer — Adjust Brightness, Contrast, Sharpness Online"
  description="Enhance your images with professional adjustments — brightness, contrast, saturation, sharpness. No uploads, 100% private — runs in your browser."
  canonical="https://quickjpgconverter.com/tools/image-enhancer"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["image enhancer", "enhance image", "adjust brightness", "increase contrast", "sharpen image", "online image editor", "free photo editor"]}
  toolSchema={{
    name: "Image Enhancer",
    description: "Enhance images with brightness, contrast, saturation, and sharpness controls.",
    url: "https://quickjpgconverter.com/tools/image-enhancer",
    featureList: ["Brightness control", "Contrast adjustment", "Saturation tuning", "Sharpness enhancement", "Real-time preview", "All formats supported", "Free tool"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free Online Image <span class="gradient-text">Enhancer</span> — Brightness, Contrast, Sharpness
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Professional image enhancement with real-time preview.
          Adjust brightness, contrast, saturation, and sharpness. 100% private — runs in your browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Professional Image Enhancement</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">Enhance</span>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[500px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your image here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Image
                    <input type="file" class="sr-only" accept="image/*" />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP, BMP, GIF · Max 50MB</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>

              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary truncate"></span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear</button>
                  </div>
                  <div class="flex-1 p-4 overflow-auto flex items-center justify-center bg-surface-muted/30">
                    <canvas id="canvas-preview" class="max-w-full max-h-[350px] rounded-lg shadow-sm"></canvas>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Controls + Actions -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col overflow-y-auto max-h-[600px]">
              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Adjustments</h3>
                <div class="space-y-4">
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Brightness</label>
                      <span id="brightness-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">100%</span>
                    </div>
                    <input type="range" id="brightness" min="0" max="200" value="100" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Contrast</label>
                      <span id="contrast-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">100%</span>
                    </div>
                    <input type="range" id="contrast" min="0" max="200" value="100" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Saturation</label>
                      <span id="saturation-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">100%</span>
                    </div>
                    <input type="range" id="saturation" min="0" max="200" value="100" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Sharpness</label>
                      <span id="sharpness-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">0%</span>
                    </div>
                    <input type="range" id="sharpness" min="0" max="100" value="0" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                </div>
              </div>

              <div class="h-px bg-border-default mb-5"></div>

              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Effects</h3>
                <div class="space-y-2">
                  <label class="flex items-center gap-3 p-2.5 rounded-lg border border-border-default hover:bg-surface-subtle/50 cursor-pointer transition-all">
                    <input type="checkbox" id="grayscale" class="w-4 h-4 text-brand-600 rounded border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <span class="text-sm text-text-primary">Grayscale</span>
                  </label>
                  <label class="flex items-center gap-3 p-2.5 rounded-lg border border-border-default hover:bg-surface-subtle/50 cursor-pointer transition-all">
                    <input type="checkbox" id="sepia" class="w-4 h-4 text-brand-600 rounded border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <span class="text-sm text-text-primary">Sepia</span>
                  </label>
                </div>
              </div>

              <div class="flex-1"></div>

              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Enhancing...</p>
              </div>

              <div class="flex gap-2">
                <button id="reset-btn" class="flex-1 btn-secondary btn-md justify-center">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>
                  Reset
                </button>
                <button id="enhance-btn" class="flex-1 btn-primary btn-md justify-center hidden">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
                  Enhance
                </button>
              </div>

              <div id="download-area" class="hidden mt-4"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="Image Enhancer" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Professional Enhancement</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Upload Image</h3>
          <p class="text-sm text-text-secondary">Drop or click to select your image file.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Adjust Settings</h3>
          <p class="text-sm text-text-secondary">Fine-tune brightness, contrast, saturation, and sharpness with live preview.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download</h3>
          <p class="text-sm text-text-secondary">Get your enhanced PNG image instantly.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Professional Image Enhancement</h2>
        <p>Enhance your photos with professional-grade adjustments. All processing happens in your browser using Canvas API — your images never leave your device.</p>
        <h3>Available Adjustments</h3>
        <ul>
          <li><strong>Brightness</strong> — Make dark photos brighter or dim bright photos</li>
          <li><strong>Contrast</strong> — Increase or decrease the difference between light and dark areas</li>
          <li><strong>Saturation</strong> — Control the intensity of colors</li>
          <li><strong>Sharpness</strong> — Enhance edge detail for crisper images</li>
          <li><strong>Grayscale</strong> — Convert to black and white</li>
          <li><strong>Sepia</strong> — Apply a warm vintage tone</li>
        </ul>
        <h3>Use Cases</h3>
        <ul>
          <li>Fix underexposed or overexposed photos</li>
          <li>Enhance product photos for e-commerce</li>
          <li>Improve old or faded photographs</li>
          <li>Create artistic effects with filters</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Tools</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Compressor</h3>
          <p class="text-sm text-text-secondary">Reduce file size with quality control.</p>
        </a>
        <a href="/tools/resize-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Resize JPG</h3>
          <p class="text-sm text-text-secondary">Resize images to any dimension.</p>
        </a>
        <a href="/tools/pdf-enhancer" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PDF Enhancer</h3>
          <p class="text-sm text-text-secondary">Enhance PDF pages with professional adjustments.</p>
        </a>
        <a href="/tools/compress-to-100kb" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress to 100KB</h3>
          <p class="text-sm text-text-secondary">Reduce images to under 100KB.</p>
        </a>
        <a href="/tools/jpg-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PNG</h3>
          <p class="text-sm text-text-secondary">Convert JPG to PNG with transparency.</p>
        </a>
        <a href="/tools/png-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PNG to JPG</h3>
          <p class="text-sm text-text-secondary">Convert PNG images to JPG format.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initImageEnhancer } from "@scripts/image-enhancer.js";
    initImageEnhancer();
  </script>
</BaseLayout>
