---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "UPSC Photo Compressor", url: "/tools/upsc-photo-compressor" },
];

const requirements = [
  { label: "Dimensions", value: "3.5 cm × 4.5 cm", detail: "~138 × 177 px at 100 DPI" },
  { label: "File Size", value: "20 KB – 300 KB", detail: "Preferably under 100 KB" },
  { label: "Format", value: "JPG / JPEG", detail: "PNG not accepted" },
  { label: "Background", value: "White or light", detail: "No shadows or patterns" },
  { label: "Name & Date", value: "Required", detail: "Printed below the photo" },
];

const faqItems = [
  {
    question: "What is the UPSC photo size requirement?",
    answer: "UPSC requires passport-size photos measuring 3.5 cm (width) × 4.5 cm (height). At 100 DPI this is approximately 138 × 177 pixels. The file size must be between 20 KB and 300 KB, preferably under 100 KB. The format must be JPG/JPEG.",
  },
  {
    question: "How do I resize my photo for UPSC application?",
    answer: "Upload your photo to our tool above. Select the UPSC preset (3.5cm × 4.5cm), set target size to 100KB or less, and click Compress. The tool will resize and compress your photo to meet UPSC requirements automatically.",
  },
  {
    question: "What background color is required for UPSC photos?",
    answer: "UPSC requires a plain white or very light colored background. No shadows, patterns, or colored backgrounds. The photo should have even lighting with no harsh shadows on the face or background.",
  },
  {
    question: "Can I use a selfie for UPSC application?",
    answer: "While technically possible, UPSC recommends professional passport photos. If using a selfie, ensure it's taken against a white wall with even lighting, and crop it to passport dimensions (3.5cm × 4.5cm) using our tool.",
  },
  {
    question: "Do I need to print my name and date on the UPSC photo?",
    answer: "Yes. UPSC requires your name and the date the photo was taken to be printed on the photo itself. Most photo studios do this automatically. If submitting digitally, some portals add this overlay.",
  },
  {
    question: "What happens if my UPSC photo doesn't meet size requirements?",
    answer: "If your photo exceeds 300 KB or doesn't match the dimensions, your application may be rejected. Always compress your photo to under 100 KB and verify the dimensions before submitting.",
  },
];
---

<BaseLayout
  title="UPSC Photo Compressor — Resize for Exam"
  description="Resize and compress photos for UPSC application. 3.5cm × 4.5cm, under 100KB. Free online tool. Meets official UPSC photo requirements."
  canonical="https://quickjpgconverter.com/tools/upsc-photo-compressor"
  keywords={["upsc photo size", "upsc photo compressor", "upsc application photo", "resize photo for upsc", "upsc passport photo", "upsc photo requirements", "upsc online form photo size"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "UPSC Photo Compressor",
    description: "Resize and compress photos to meet UPSC exam photo requirements. 3.5cm x 4.5cm, under 100KB.",
    url: "https://quickjpgconverter.com/tools/upsc-photo-compressor",
    featureList: ["UPSC-compliant dimensions (3.5cm × 4.5cm)", "Target size 20KB–300KB", "White background check", "Batch processing", "Instant browser compression", "100% private", "Free to use"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          UPSC 2026 · Free · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          UPSC <span class="gradient-text">Photo Compressor</span> — Resize for UPSC Exam
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Resize and compress your photo to meet UPSC requirements — 3.5cm × 4.5cm, under 100KB, JPG format.
        </p>
      </div>
    </Container>
  </section>

  <!-- Requirements card -->
  <section class="pb-8">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border border-brand-200 dark:border-brand-800 bg-brand-50/30 dark:bg-brand-950/20 overflow-hidden">
          <div class="px-5 sm:px-6 py-4 border-b border-brand-200/50 dark:border-brand-800/50 bg-brand-100/30 dark:bg-brand-900/20">
            <h2 class="text-sm font-bold text-brand-800 dark:text-brand-300 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
              UPSC Official Photo Requirements
            </h2>
          </div>
          <div class="divide-y divide-brand-200/50 dark:divide-brand-800/50">
            {requirements.map((req) => (
              <div class="flex items-center justify-between px-5 sm:px-6 py-3">
                <div>
                  <span class="text-sm font-medium text-text-primary">{req.label}</span>
                  <span class="text-xs text-text-tertiary ml-2">{req.detail}</span>
                </div>
                <span class="text-sm font-bold text-brand-700 dark:text-brand-400">{req.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Tool -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Resize & Compress:</span>
            <div class="flex items-center gap-2">
              <span class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">3.5cm × 4.5cm</span>
              <span class="text-xs text-text-tertiary">·</span>
              <span id="target-size-display" class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">100 KB</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <!-- Upload -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your photo here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">Passport-size photo for UPSC application</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Photo
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp" />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Max 50MB</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">1 file ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 overflow-y-auto max-h-[350px]"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Target: 3.5cm × 4.5cm</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: JPG ≤ 100KB</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Options + Compress -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <h3 class="text-sm font-semibold text-text-primary mb-3">UPSC Photo Settings</h3>

              <div class="space-y-3 mb-6">
                <div class="p-3 rounded-lg border border-brand-200 dark:border-brand-800 bg-brand-50 dark:bg-brand-950/50">
                  <div class="text-xs font-medium text-brand-700 dark:text-brand-400 mb-1">Dimensions</div>
                  <div class="text-sm font-semibold text-text-primary">3.5cm × 4.5cm (UPSC standard)</div>
                </div>
                <div class="p-3 rounded-lg border border-border-default bg-surface-muted">
                  <div class="text-xs font-medium text-text-tertiary mb-1">Target Size</div>
                  <div class="flex items-center gap-2">
                    <input id="target-kb" type="number" min="20" max="300" value="100" class="w-16 px-2 py-1 rounded text-xs font-medium border border-border-default bg-surface text-text-primary focus:outline-none focus:border-brand-500" />
                    <span class="text-xs text-text-tertiary">KB (20–300)</span>
                  </div>
                </div>
              </div>

              <div class="mb-6">
                <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-2">Tips for UPSC Photos</h4>
                <ul class="text-xs text-text-secondary space-y-1.5">
                  <li>• Use a plain white background</li>
                  <li>• Face should occupy 50–70% of frame</li>
                  <li>• Even lighting, no harsh shadows</li>
                  <li>• Recent photo (within 10 days)</li>
                  <li>• Name + date printed below</li>
                </ul>
              </div>

              <div class="flex-1"></div>

              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Processing...</p>
              </div>

              <div id="compress-btn-area">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Resize & Compress for UPSC
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Upload a photo to start</p>
              </div>
              <div id="download-area" class="hidden"></div>

              <div class="mt-6 pt-4 border-t border-border-default">
                <FeatureRequest toolName="UPSC Photo Compressor" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Guide section -->
  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">Complete Guide</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">UPSC Photo Requirements — Full Guide</h2>
      </div>
      <div class="prose">
        <h3>Official UPSC Photo Specifications</h3>
        <p>The Union Public Service Commission (UPSC) has strict photo requirements for all examination applications including Civil Services (IAS/IPS), Engineering Services, CDS, NDA, and other exams.</p>

        <h4>Dimension Requirements</h4>
        <ul>
          <li><strong>Width:</strong> 3.5 cm (approximately 138 pixels at 100 DPI)</li>
          <li><strong>Height:</strong> 4.5 cm (approximately 177 pixels at 100 DPI)</li>
          <li><strong>Format:</strong> JPG/JPEG only (PNG is not accepted)</li>
          <li><strong>File size:</strong> 20 KB to 300 KB (preferably under 100 KB)</li>
        </ul>

        <h4>Photo Quality Requirements</h4>
        <ul>
          <li><strong>Background:</strong> White or very light colored, plain, without patterns</li>
          <li><strong>Lighting:</strong> Even lighting with no harsh shadows on face or background</li>
          <li><strong>Expression:</strong> Neutral expression, mouth closed, eyes open</li>
          <li><strong>Head position:</strong> Full face, front view, ears visible</li>
          <li><strong>Recency:</strong> Photo should be taken within 10 days of application</li>
          <li><strong>Name & Date:</strong> Must be printed on the photo (name + date of photograph)</li>
        </ul>

        <h4>How to Use This Tool</h4>
        <ol>
          <li>Upload your passport-size photo</li>
          <li>Our tool automatically resizes to 3.5cm × 4.5cm (138 × 177 px)</li>
          <li>Set target size to 100 KB or less</li>
          <li>Click "Resize & Compress for UPSC"</li>
          <li>Download the compressed JPG — ready for UPSC application</li>
        </ol>

        <h4>Common Mistakes to Avoid</h4>
        <ul>
          <li>Using a colored or patterned background</li>
          <li>Photo older than 10 days</li>
          <li>File size exceeding 300 KB</li>
          <li>Using PNG format instead of JPG</li>
          <li>Wearing sunglasses or cap (except for medical reasons with certificate)</li>
          <li>Blurry or low-resolution photos</li>
        </ul>

        <p>Also see: <a href="/tools/compress-to-100kb">Compress to 100KB</a> · <a href="/tools/compress-to-200kb">Compress to 200KB</a> · <a href="/tools/compress-to-size">Compress to Any Size</a> · <a href="/tools/resize-jpg">Resize JPG</a></p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    document.addEventListener("DOMContentLoaded", () => {
      const targetInput = document.getElementById("target-kb") as HTMLInputElement;

      function getTargetBytes() {
        const val = parseInt(targetInput?.value || "100", 10);
        return Math.max(20, Math.min(300, isNaN(val) ? 100 : val)) * 1024;
      }

      initTargetedCompressor({ targetSize: getTargetBytes() });

      targetInput?.addEventListener("change", () => {
        const w = window as Record<string, unknown>;
        const val = parseInt(targetInput.value || "100", 10);
        const kb = Math.max(20, Math.min(300, isNaN(val) ? 100 : val));
        if (typeof w.__setTargetSize === "function") w.__setTargetSize(kb);
      });
    });
  </script>
</BaseLayout>
