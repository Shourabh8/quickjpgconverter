---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "CR2 to JPG", url: "/tools/cr2-to-jpg" },
];

const conversionOptions = [
  { id: "quality-high", label: "High Quality", desc: "Best visual fidelity, larger file", checked: true },
  { id: "quality-balanced", label: "Balanced", desc: "Good balance of size and quality", checked: false },
  { id: "quality-small", label: "Smallest Size", desc: "Smallest file, slight quality loss", checked: false },
];

const faqItems = [
  {
    question: "What is a CR2 file?",
    answer: "CR2 (Canon Raw 2) is a RAW image format used by Canon digital cameras. It stores unprocessed sensor data, giving photographers maximum flexibility in post-processing. CR2 files are large but contain all the detail captured by your Canon camera.",
  },
  {
    question: "Why should I convert CR2 to JPG?",
    answer: "While CR2 files offer the highest quality and editing flexibility, they aren't widely supported by web browsers, social media platforms, or basic image viewers. Converting to JPG makes your Canon photos universally viewable and shareable.",
  },
  {
    question: "Will converting CR2 to JPG reduce quality?",
    answer: "JPG uses lossy compression, so some data is lost compared to the original CR2. However, at high quality settings, the visual difference is minimal. JPG files are also much smaller, making them easier to store and share.",
  },
  {
    question: "What browsers support CR2 conversion?",
    answer: "Our CR2 to JPG converter works in all modern browsers including Chrome, Firefox, Safari, and Edge. The conversion runs entirely in your browser — no uploads to any server.",
  },
  {
    question: "What is the best free CR2 to JPG converter?",
    answer: "Quick JPG Converter is one of the best free CR2 to JPG converters. It runs entirely in your browser, requires no sign-up, supports batch conversion, and works on Mac, Windows, and mobile devices.",
  },
  {
    question: "Can I convert multiple CR2 files at once?",
    answer: "Yes. You can drag and drop or select multiple CR2 files from your Canon camera. They'll all be converted to JPG simultaneously, and you can download them individually or as a batch.",
  },
  {
    question: "Do I need software like Lightroom to convert CR2?",
    answer: "No. Our online converter handles CR2 to JPG conversion directly in your browser. While Lightroom and other editors can also convert CR2 files, our tool is faster for quick conversions and requires no software installation.",
  },
  {
    question: "Can I convert CR3 files too?",
    answer: "Yes. Our converter supports both CR2 (older Canon cameras) and CR3 (newer Canon cameras) formats. Simply drop your Canon RAW files and they'll be converted to JPG.",
  },
];

const relatedTools = [
  { href: "/tools/heic-to-jpg", title: "HEIC to JPG", desc: "Convert iPhone HEIC photos to JPG." },
  { href: "/tools/raw-to-jpg", title: "RAW to JPG", desc: "Convert any RAW photo format to JPG." },
  { href: "/tools/image-compressor", title: "Image Compressor", desc: "Compress images without quality loss." },
];
---

<BaseLayout
  title="Free CR2 to JPG Converter — Canon RAW Photo Converter"
  description="Convert Canon CR2 RAW photos to JPG with our free online JPG converter. Universal compatibility, quality control, and 100% private. No uploads required — try it now."
  canonical="https://quickjpgconverter.com/cr2-to-jpg"
  keywords={["cr2 to jpg", "convert cr2 to jpg", "canon raw to jpg", "cr2 converter"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "CR2 to JPG Converter",
    description: "Convert Canon CR2 RAW photos to JPG for universal compatibility.",
    url: "https://quickjpgconverter.com/tools/cr2-to-jpg",
    featureList: ["Canon CR2 and CR3 support", "Universal JPG output", "Batch conversion", "Quality control", "Works on Mac and Windows", "No software installation", "100% private"],
  }}
  noindex={true}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Canon RAW Converter
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free CR2 to <span class="gradient-text">JPG</span> Converter — Canon RAW Photo Converter
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Convert Canon CR2 RAW photos to JPG with our free online JPG converter. Universal compatibility, quality control, and 100% private.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Convert to:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">JPG</button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your CR2 files here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".cr2,.cr3" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">CR2, CR3 · Max 50MB per file · Multiple files supported</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Input: CR2 (Canon RAW)</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Conversion Options</h3>
                <div class="space-y-2">
                  {conversionOptions.map((opt) => (
                    <label class:list={[
                      "flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200",
                      opt.checked ? "border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30" : "border-border-default hover:border-border-strong hover:bg-surface-subtle/50"
                    ]}>
                      <input type="radio" name="quality" value={opt.id} checked={opt.checked} class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-text-primary">{opt.label}</div>
                        <div class="text-xs text-text-tertiary mt-0.5">{opt.desc}</div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>
              <div class="h-px bg-border-default mb-6"></div>
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Output Format</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">JPG</div>
                      <div class="text-xs text-text-tertiary">Lossy · Universal · Smaller files</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Converting...</p>
              </div>
              <div id="convert-btn-area">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Convert to JPG
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Upload a file to start conversion</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Supported:</span>
          {["CR2", "CR3"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Max 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>Multiple files</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="CR2 to JPG" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your CR2</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select your Canon RAW photos.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Convert instantly</h3>
          <p class="text-sm text-text-secondary">Your image is converted in-browser. No server uploads.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download JPG</h3>
          <p class="text-sm text-text-secondary">Get your compatible JPG file instantly.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Convert CR2 to JPG?</h2>
        <p>CR2 (Canon Raw 2) is the RAW image format used by Canon digital cameras. It stores unprocessed sensor data, giving photographers maximum flexibility in post-processing. While CR2 files offer the highest quality, they aren't widely supported by web browsers, social media platforms, or basic image viewers.</p>
        <h3>CR2 vs JPG</h3>
        <p>CR2 files contain all the raw data from your camera's sensor, making them much larger than JPG files. A typical CR2 file can be 20-50MB, while the same image as a JPG might be only 2-5MB. CR2 gives you more editing headroom, but JPG is universally compatible.</p>
        <h3>When You Need JPG</h3>
        <ul>
          <li>Sharing photos on social media platforms that don't support CR2</li>
          <li>Printing photos at a photo lab or online printing service</li>
          <li>Using photos in web design or presentations</li>
          <li>Reducing file size for email or cloud storage</li>
          <li>Viewing photos on devices without RAW support</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Converters</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {relatedTools.map((tool) => (
          <a href={tool.href} class="card-hover p-5 group">
            <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{tool.title}</h3>
            <p class="text-sm text-text-secondary">{tool.desc}</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <script>
    import { initConverter } from "@scripts/converter.js";
    import { initQualitySelector } from "@scripts/quality-selector.js";
    document.addEventListener("DOMContentLoaded", () => { initQualitySelector(); initConverter({ targetFormat: "jpeg", targetExt: "jpg", targetMime: "image/jpeg" }); });
  </script>
</BaseLayout>
