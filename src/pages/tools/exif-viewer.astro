---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "EXIF Viewer & Remover", url: "/tools/exif-viewer" },
];

const faqItems = [
  {
    question: "What is EXIF data?",
    answer: "EXIF (Exchangeable Image File Format) is metadata embedded in your photos by cameras and phones. It includes the date and time the photo was taken, camera settings (ISO, aperture, shutter speed), and most importantly, GPS coordinates showing exactly where the photo was taken.",
  },
  {
    question: "Why should I remove EXIF data?",
    answer: "EXIF data can reveal your exact location when you share photos online. Stripping this data protects your privacy before posting on social media, selling items online, or sending photos to strangers. It also slightly reduces file size.",
  },
  {
    question: "Does stripping EXIF reduce image quality?",
    answer: "No. Our tool removes only the metadata segments from the file. The actual image data is completely untouched. Quality, resolution, and visual appearance remain identical.",
  },
  {
    question: "What metadata does this tool detect?",
    answer: "We detect camera make and model, date/time, exposure settings (ISO, aperture, shutter speed), focal length, GPS coordinates with a Google Maps link, ICC color profiles, and any text metadata embedded in the file.",
  },
  {
    question: "Is my data safe?",
    answer: "Absolutely. All processing happens entirely in your browser. Your photos are never uploaded to any server. They stay on your device from start to finish.",
  },
];
---

<BaseLayout
  title="EXIF Viewer & Remover — Strip Metadata"
  description="View and strip EXIF metadata — GPS location, camera info — from your photos. 100% private. No uploads."
  canonical="https://quickjpgconverter.com/tools/exif-viewer"
  keywords={["exif viewer", "exif remover", "strip exif", "remove metadata", "photo privacy", "gps data photo"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "EXIF Viewer and Remover",
    description: "View and strip EXIF metadata from photos. GPS, camera info, date, and more. 100% private.",
    url: "https://quickjpgconverter.com/tools/exif-viewer",
    featureList: ["View EXIF metadata", "Strip GPS location data", "Remove camera info", "Batch processing", "Preserves image quality", "100% private", "Free to use"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Privacy Tool · 100% Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free <span class="gradient-text">EXIF Viewer</span> & Remover — Strip Photo Metadata
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          See exactly what data your photos reveal — GPS location, camera info, and more. Then strip it all with one click.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span class="text-sm font-medium text-text-primary">Metadata Inspector</span>
            </div>
            <span class="text-xs text-text-tertiary">JPG & PNG supported</span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[500px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:border-r border-border-default">
              <div id="upload-zone" class="p-5 sm:p-6 h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your photos here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Photos
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG · Multiple files supported</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to inspect</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden p-5 sm:p-6 h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[300px] content-start"></div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Metadata + Strip -->
            <div class="flex flex-col">
              <div class="p-5 sm:p-6 flex-1 overflow-y-auto max-h-[500px]">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-sm font-semibold text-text-primary">Detected Metadata</h3>
                  <svg class="w-4 h-4 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div id="metadata-panel">
                  <p class="text-sm text-text-tertiary text-center py-8">Drop or select image files to view their metadata</p>
                </div>
              </div>

              <!-- Strip action -->
              <div id="strip-area" class="hidden border-t border-border-default p-5 sm:p-6">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl bg-warning-50 dark:bg-warning-950/50 flex items-center justify-center border border-warning-200 dark:border-warning-800">
                    <svg class="w-5 h-5 text-warning-600 dark:text-warning-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold text-text-primary">Strip All Metadata</h4>
                    <p class="text-xs text-text-secondary">Remove EXIF, GPS, camera info. Image stays identical.</p>
                  </div>
                </div>
                <button id="strip-btn" class="w-full btn-primary btn-lg justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  Download Clean Images
                </button>
                <div id="strip-progress" class="hidden mt-3">
                  <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                    <div id="strip-progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                </div>
              </div>

              <div class="p-5 sm:p-6 border-t border-border-default">
                <FeatureRequest toolName="EXIF Viewer" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why EXIF Data Is a Privacy Risk</h2>
        <p>Every photo taken with a modern camera or smartphone contains hidden metadata — and most people have no idea it's there. This data can reveal:</p>
        <ul>
          <li><strong>Your exact GPS location</strong> — where the photo was taken, often down to the street address</li>
          <li><strong>When it was taken</strong> — date, time, and sometimes the timezone</li>
          <li><strong>Your device</strong> — camera make, model, and serial number</li>
          <li><strong>Camera settings</strong> — ISO, aperture, focal length, exposure</li>
        </ul>
        <p>When you post a photo on social media, sell an item online, or email a photo to a stranger, this metadata travels with it. Stripping EXIF data before sharing protects your privacy with zero impact on image quality.</p>

        <h2>How It Works</h2>
        <p>Our EXIF viewer reads the binary metadata segments in your JPEG and PNG files and displays them in a human-readable format. The stripper removes only the metadata segments (APP1/APP2 for JPEG, text chunks for PNG) while leaving the image data completely untouched.</p>
        <p>Everything happens in your browser. Your photos are never uploaded anywhere.</p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <script>
    import { initExifTools } from "@scripts/exif-tools.js";
    document.addEventListener("DOMContentLoaded", () => initExifTools());
  </script>
</BaseLayout>
