---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "PDF Enhancer", url: "/tools/pdf-enhancer" },
];

const faqItems = [
  {
    question: "What enhancements can I apply to PDFs?",
    answer: "You can adjust brightness, contrast, saturation, sharpness, and apply grayscale or sepia effects to all pages in your PDF.",
  },
  {
    question: "Will my PDF be uploaded?",
    answer: "No. All processing happens in your browser using PDF.js and Canvas API. Your PDF never leaves your device.",
  },
  {
    question: "Does it work with multi-page PDFs?",
    answer: "Yes. All pages are enhanced with the same settings and compiled into a new PDF document.",
  },
  {
    question: "What if my PDF is encrypted?",
    answer: "Password-protected PDFs cannot be processed. Please remove the password first and try again.",
  },
];
---

<BaseLayout
  title="Free PDF Enhancer — Adjust Brightness, Contrast, Sharpness Online"
  description="Enhance your PDF pages with professional adjustments — brightness, contrast, saturation, sharpness. No uploads, 100% private — runs in your browser."
  canonical="https://quickjpgconverter.com/tools/pdf-enhancer"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["pdf enhancer", "enhance pdf", "adjust pdf brightness", "improve pdf quality", "sharpen pdf", "online pdf editor", "free pdf enhancer"]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          PDF <span class="gradient-text">Enhancer</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Professional PDF enhancement with brightness, contrast, saturation, and sharpness controls.
          No uploads, 100% private — runs in your browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Professional PDF Enhancement</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">Enhance</span>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <!-- LEFT: Upload / Info -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your PDF here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose PDF
                    <input type="file" class="sr-only" accept=".pdf" />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">PDF · Max 50MB · Single file</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>

              <div id="result-zone" class="hidden">
                <div id="file-info" class="mb-4"></div>
                <div id="progress-area" class="hidden">
                  <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Enhancing...</p>
                </div>
                <div class="flex gap-2 mt-4">
                  <button id="enhance-btn" class="flex-1 btn-primary btn-md justify-center hidden">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
                    Enhance PDF
                  </button>
                  <button id="download-btn" class="flex-1 btn-primary btn-md justify-center hidden">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                    Download
                  </button>
                  <button id="enhance-more-btn" class="flex-1 btn-secondary btn-md justify-center hidden">New PDF</button>
                </div>
              </div>
            </div>

            <!-- RIGHT: Controls -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col overflow-y-auto max-h-[600px]">
              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Adjustments</h3>
                <div class="space-y-4">
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Brightness</label>
                      <span id="brightness-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">100%</span>
                    </div>
                    <input type="range" id="brightness" min="0" max="200" value="100" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Contrast</label>
                      <span id="contrast-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">100%</span>
                    </div>
                    <input type="range" id="contrast" min="0" max="200" value="100" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Saturation</label>
                      <span id="saturation-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">100%</span>
                    </div>
                    <input type="range" id="saturation" min="0" max="200" value="100" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="text-xs font-medium text-text-secondary">Sharpness</label>
                      <span id="sharpness-value" class="text-xs font-semibold text-brand-600 dark:text-brand-400">0%</span>
                    </div>
                    <input type="range" id="sharpness" min="0" max="100" value="0" class="w-full h-1.5 rounded-full appearance-none cursor-pointer bg-surface-muted accent-brand-600" />
                  </div>
                </div>
              </div>

              <div class="h-px bg-border-default mb-5"></div>

              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Effects</h3>
                <div class="space-y-2">
                  <label class="flex items-center gap-3 p-2.5 rounded-lg border border-border-default hover:bg-surface-subtle/50 cursor-pointer transition-all">
                    <input type="checkbox" id="grayscale" class="w-4 h-4 text-brand-600 rounded border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <span class="text-sm text-text-primary">Grayscale</span>
                  </label>
                  <label class="flex items-center gap-3 p-2.5 rounded-lg border border-border-default hover:bg-surface-subtle/50 cursor-pointer transition-all">
                    <input type="checkbox" id="sepia" class="w-4 h-4 text-brand-600 rounded border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <span class="text-sm text-text-primary">Sepia</span>
                  </label>
                </div>
              </div>

              <div class="flex-1"></div>

              <div class="p-3 rounded-lg bg-surface-muted border border-border-default">
                <p class="text-xs text-text-tertiary text-center">All pages will be enhanced with the same settings</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="PDF Enhancer" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Professional Enhancement</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Upload PDF</h3>
          <p class="text-sm text-text-secondary">Drop or click to select your PDF file.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Adjust Settings</h3>
          <p class="text-sm text-text-secondary">Fine-tune brightness, contrast, saturation, and sharpness.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download</h3>
          <p class="text-sm text-text-secondary">Get your enhanced PDF instantly.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Professional PDF Enhancement</h2>
        <p>Enhance your PDF documents with professional-grade adjustments. All processing happens in your browser — your PDFs never leave your device.</p>
        <h3>Available Adjustments</h3>
        <ul>
          <li><strong>Brightness</strong> — Make dark PDFs brighter or dim bright pages</li>
          <li><strong>Contrast</strong> — Increase the difference between text and background</li>
          <li><strong>Saturation</strong> — Control the intensity of colors</li>
          <li><strong>Sharpness</strong> — Enhance text and image clarity</li>
          <li><strong>Grayscale</strong> — Convert to black and white</li>
          <li><strong>Sepia</strong> — Apply a warm vintage tone</li>
        </ul>
        <h3>Use Cases</h3>
        <ul>
          <li>Improve scanned documents with low contrast</li>
          <li>Brighten dark PDF pages for better readability</li>
          <li>Enhance old or faded PDF documents</li>
          <li>Make text more crisp and readable</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Tools</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/pdf-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PDF Compressor</h3>
          <p class="text-sm text-text-secondary">Reduce PDF file size without quality loss.</p>
        </a>
        <a href="/tools/image-enhancer" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Enhancer</h3>
          <p class="text-sm text-text-secondary">Enhance images with professional adjustments.</p>
        </a>
        <a href="/tools/pdf-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PDF to JPG</h3>
          <p class="text-sm text-text-secondary">Extract PDF pages as JPG images.</p>
        </a>
        <a href="/tools/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Compressor</h3>
          <p class="text-sm text-text-secondary">Reduce image file size with quality control.</p>
        </a>
        <a href="/tools/resize-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Resize JPG</h3>
          <p class="text-sm text-text-secondary">Resize images to any dimension.</p>
        </a>
        <a href="/tools/jpg-to-pdf" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PDF</h3>
          <p class="text-sm text-text-secondary">Convert JPG images to PDF documents.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initPdfEnhancer } from "@scripts/pdf-enhancer.js";
    initPdfEnhancer();
  </script>
</BaseLayout>
