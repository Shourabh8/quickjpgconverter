---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import CompareSlider from "@components/ui/CompareSlider.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "Batch Converter", url: "/tools/batch-converter" },
];

const conversionOptions = [
  { id: "quality-high", label: "High Quality", desc: "Best visual fidelity, larger file", checked: true },
  { id: "quality-balanced", label: "Balanced", desc: "Good balance of size and quality", checked: false },
  { id: "quality-small", label: "Smallest Size", desc: "Smallest file, slight quality loss", checked: false },
];

const faqItems = [
  {
    question: "What image formats can I convert?",
    answer: "You can upload JPG, JPEG, PNG, WebP, HEIC, and AVIF images. The tool detects formats automatically and lets you choose the output format.",
  },
  {
    question: "How many files can I convert at once?",
    answer: "There's no hard limit. You can drop as many files as you need. They'll all be converted to your chosen format simultaneously.",
  },
  {
    question: "Will conversion reduce image quality?",
    answer: "It depends on the output format. Converting to PNG preserves all quality (lossless). Converting to JPG or WebP uses lossy compression, but you can choose the quality level.",
  },
  {
    question: "Is my data safe?",
    answer: "Absolutely. All conversion happens entirely in your browser. Your images are never uploaded to any server. They stay on your device from start to finish.",
  },
  {
    question: "Can I convert files of different formats together?",
    answer: "Yes. You can mix JPG, PNG, WebP, and HEIC files in the same batch. They'll all be converted to the output format you choose.",
  },
];
---

<BaseLayout
  title="Batch Image Converter — Convert Multiple"
  description="Convert multiple images to JPG, PNG, or WebP at once. Drop 10+ files, choose your format, and download as ZIP. Free, private, no uploads."
  canonical="https://quickjpgconverter.com/tools/batch-converter"
  keywords={["batch converter", "batch image converter", "convert multiple images", "bulk image converter"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  howToSteps={[
    { name: "Upload images", text: "Drag and drop your images or click to browse. Any format accepted." },
    { name: "Choose output format", text: "Select JPG, PNG, or WebP as your target format." },
    { name: "Convert and download", text: "Click Convert and download all files as a ZIP." },
  ]}
  toolSchema={{
    name: "Batch Image Converter",
    description: "Convert multiple images to any format at once — JPG, PNG, or WebP.",
    url: "https://quickjpgconverter.com/tools/batch-converter",
    featureList: ["Multi-format input (JPG, PNG, WebP, HEIC, AVIF)", "Output to JPG, PNG, or WebP", "Batch conversion", "Quality control", "Download all as ZIP", "100% browser-based", "No signup required"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Batch <span class="gradient-text">Image Converter</span> — Convert Multiple Files at Once
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Drop 10, 50, or 100 images. Choose your output format. Download as ZIP.
          Everything runs in your browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar: format selector -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Convert to:</span>
            <div class="flex items-center gap-2">
              <select id="output-format" class="text-sm font-medium px-3 py-1.5 rounded-lg border border-border-default bg-surface text-text-primary focus:outline-none focus:border-brand-500">
                <option value="jpg">JPG</option>
                <option value="png" selected>PNG</option>
                <option value="webp">WebP</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <!-- Upload zone -->
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
                >
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your images here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp,.heic,.heif,.avif" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP, HEIC, AVIF · Max 50MB per file · Multiple files</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>

              <!-- Preview zone -->
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                </div>
              </div>

              <!-- Progress -->
              <div id="progress-area" class="hidden mt-4">
                <div class="flex items-center justify-between mb-2">
                  <span id="progress-text" class="text-sm text-text-secondary">Converting...</span>
                  <span class="text-xs text-text-tertiary">Please wait</span>
                </div>
                <div class="w-full h-2 rounded-full bg-surface-muted overflow-hidden">
                  <div id="progress-bar" class="h-full rounded-full bg-brand-500 transition-all duration-300" style="width: 0%"></div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Options -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <h3 class="text-sm font-semibold text-text-primary mb-4">Conversion Options</h3>

              <!-- Quality -->
              <div class="mb-6">
                <label class="text-xs font-medium text-text-secondary mb-3 block">Quality</label>
                <div class="space-y-2">
                  {conversionOptions.map((opt) => (
                    <label class="flex items-start gap-3 p-3 rounded-xl border border-border-default bg-surface hover:bg-surface-subtle cursor-pointer transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:has-[:checked]:bg-brand-950/50">
                      <input type="radio" name="quality" value={opt.id.replace("quality-", "")} checked={opt.checked} class="mt-0.5 accent-brand-600" />
                      <div>
                        <div class="text-sm font-medium text-text-primary">{opt.label}</div>
                        <div class="text-xs text-text-tertiary">{opt.desc}</div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Convert button -->
              <div id="convert-btn-area" class="hidden mt-auto">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  Convert All
                </button>
              </div>

              <!-- Download area -->
              <div id="download-area" class="hidden mt-auto"></div>

              <!-- Feature request -->
              <div class="mt-6 pt-4 border-t border-border-default">
                <FeatureRequest toolName="Batch Converter" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <CompareSlider />

  <script>
    import { initBatchConverter } from "@scripts/batch-converter";
    document.addEventListener("DOMContentLoaded", () => initBatchConverter());
  </script>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Use a Batch Converter?</h2>
        <p>
          Converting images one by one is tedious. If you have 20 photos from your camera that need to be in JPG format, or 50 screenshots that need to be PNG, doing them individually wastes hours. A batch converter processes all your files simultaneously — drop them all, pick your format, and download everything as a ZIP.
        </p>
        <p>
          Our batch converter supports mixed inputs too. Drop a combination of JPG, PNG, WebP, and HEIC files, and they'll all be converted to your chosen output format. No need to sort or separate them first.
        </p>

        <h2>Supported Formats</h2>
        <ul>
          <li><strong>JPG / JPEG</strong> — Universal format, great for photos, smaller file sizes</li>
          <li><strong>PNG</strong> — Lossless quality, supports transparency, ideal for graphics</li>
          <li><strong>WebP</strong> — Modern format, 25-35% smaller than JPG at equivalent quality</li>
          <li><strong>HEIC / HEIF</strong> — iPhone photo format, converts to any standard format</li>
          <li><strong>AVIF</strong> — Next-gen format with excellent compression</li>
        </ul>

        <h2>100% Private — No Uploads</h2>
        <p>
          Unlike server-based batch converters that upload all your files to their servers, our tool processes everything locally in your browser. Your images never leave your device. This is especially important for batch conversions where you're sending many files at once.
        </p>
        <p>Also check out our <a href="/tools/image-compressor">Image Compressor</a> for reducing file sizes, and our <a href="/tools/resize-jpg">Resize tool</a> for changing dimensions.</p>
      </div>
    </Container>
  </section>
</BaseLayout>
