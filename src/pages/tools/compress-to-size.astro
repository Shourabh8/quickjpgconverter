---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import CompareSlider from "@components/ui/CompareSlider.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "Compress to Any Size", url: "/tools/compress-to-size" },
];

const presetSizes = [
  { kb: 50, label: "50KB", desc: "Thumbnail" },
  { kb: 100, label: "100KB", desc: "Passport" },
  { kb: 150, label: "150KB", desc: "Forms" },
  { kb: 200, label: "200KB", desc: "Portals" },
  { kb: 500, label: "500KB", desc: "General" },
  { kb: 1000, label: "1MB", desc: "High quality" },
];

const faqItems = [
  {
    question: "How does custom size compression work?",
    answer: "Enter your target file size in KB (e.g., 150, 300, 500) and our tool uses binary search to find the optimal JPEG quality that gets as close as possible to your target. It iteratively tests quality levels to hit your exact size.",
  },
  {
    question: "What's the smallest I can compress to?",
    answer: "You can compress down to about 5KB, though quality will be very low at that size. For most photos, 50KB-100KB is the practical minimum before noticeable quality loss.",
  },
  {
    question: "Can I compress multiple images to the same target?",
    answer: "Yes. Upload multiple images and they'll all be compressed to the same target size. Each image is processed individually to meet the target.",
  },
  {
    question: "What if my image is already smaller than the target?",
    answer: "If the image is already under the target size, it will be output as-is (converted to JPG) without additional compression. No quality loss.",
  },
  {
    question: "Does this work on mobile?",
    answer: "Yes. Our compressor works on any device — iPhone, Android, tablet, or desktop. Just open the tool in your browser and compress.",
  },
];
---

<BaseLayout
  title="Compress Image to Any Size — Custom KB Target"
  description="Compress images to any target size in KB. Enter 150KB, 300KB, 500KB — any size you need. Free online tool. 100% private."
  canonical="https://quickjpgconverter.com/tools/compress-to-size"
  keywords={["compress image to size", "compress to any size", "custom image compressor", "compress to 150kb", "compress to 500kb"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "Compress to Any Size",
    description: "Compress images to any target file size in KB. Custom compression for any requirement.",
    url: "https://quickjpgconverter.com/tools/compress-to-size",
    featureList: ["Custom target size in KB", "Binary search optimization", "Batch compression", "Compare before/after", "Preset size shortcuts", "Instant results", "100% private"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Compress Image to <span class="gradient-text">Any Size</span> — Custom KB Target
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Enter your target — 50KB, 150KB, 500KB, anything. Our algorithm finds the optimal quality to hit your exact size.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar with dynamic target input -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Target size:</span>
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1.5">
                <input
                  id="target-input"
                  type="number"
                  min="1"
                  max="10240"
                  value="100"
                  class="w-20 px-2 py-1.5 rounded-lg text-sm font-bold text-center border border-brand-300 dark:border-brand-700 bg-surface text-text-primary focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
                />
                <span class="text-sm font-medium text-text-tertiary">KB</span>
              </div>
              <button id="set-target-btn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-brand-600 text-white hover:bg-brand-700 transition-colors shadow-sm">
                Set
              </button>
              <span id="target-size-display" class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">100 KB</span>
            </div>
          </div>

          <!-- Preset size shortcuts -->
          <div class="px-5 sm:px-6 py-3 border-b border-border-default bg-surface-muted/50">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs text-text-tertiary font-medium">Quick presets:</span>
              {presetSizes.map((preset) => (
                <button
                  class="preset-btn px-3 py-1 rounded-lg text-xs font-medium border border-border-default bg-surface hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/50 dark:hover:bg-brand-950/30 text-text-secondary hover:text-brand-600 dark:hover:text-brand-400 transition-all"
                  data-kb={preset.kb}
                >
                  {preset.label}
                  <span class="text-text-tertiary ml-1">{preset.desc}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your images here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Max 50MB · Multiple files</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Target: ≤ <span id="sidebar-target-size">100 KB</span></span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Options + Compress -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <h3 class="text-sm font-semibold text-text-primary mb-3">Compression Settings</h3>

              <div class="space-y-3 mb-6">
                <div class="p-3 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30">
                  <div class="text-xs font-medium text-brand-700 dark:text-brand-400 mb-1">Output Format</div>
                  <div class="text-sm font-semibold text-text-primary">JPG — smallest files at any target</div>
                </div>
                <div class="p-3 rounded-lg border border-border-default bg-surface-muted">
                  <div class="text-xs font-medium text-text-tertiary mb-1">Algorithm</div>
                  <div class="text-sm text-text-secondary">Binary search — finds optimal quality in &lt;10 iterations</div>
                </div>
              </div>

              <div class="mb-6">
                <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-2">How It Works</h4>
                <ul class="text-xs text-text-secondary space-y-1.5">
                  <li>1. Enter your target size (e.g., 150KB)</li>
                  <li>2. Drop or select your images</li>
                  <li>3. Algorithm finds the best quality level</li>
                  <li>4. Download your compressed images</li>
                </ul>
              </div>

              <div class="flex-1"></div>

              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compressing...</p>
              </div>

              <div id="compress-btn-area">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled data-targeted="true">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Compress to 100 KB
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Upload images to start compression</p>
              </div>
              <div id="download-area" class="hidden"></div>

              <div class="mt-6 pt-4 border-t border-border-default">
                <FeatureRequest toolName="Compress to Any Size" />
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Supported:</span>
          {["JPG", "PNG", "WebP"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Max 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>Multiple files</span>
        </div>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Set Your Target, Get Your Image</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Set target size</h3>
          <p class="text-sm text-text-secondary">Type any KB value or use a preset — 50KB, 150KB, 500KB, anything.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop images</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select. Multiple files supported.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download</h3>
          <p class="text-sm text-text-secondary">Get your compressed images instantly. Compare quality before downloading.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Custom Size Compression?</h2>
        <p>Different platforms have different file size requirements. Government portals might need 100KB, job applications 200KB, social media 500KB. Instead of using separate tools for each size, our custom compressor lets you enter any target and get the optimal result.</p>
        <h3>Common Targets</h3>
        <ul>
          <li><strong>50KB</strong> — Thumbnails, small icons</li>
          <li><strong>100KB</strong> — Passport photos, government forms</li>
          <li><strong>150KB</strong> — SSC, UPSC, bank form submissions</li>
          <li><strong>200KB</strong> — Portal uploads, job applications</li>
          <li><strong>500KB</strong> — General use, email attachments</li>
          <li><strong>1MB</strong> — High-quality sharing</li>
        </ul>
        <p>Also see: <a href="/tools/compress-to-100kb">Compress to 100KB</a> · <a href="/tools/compress-to-200kb">Compress to 200KB</a> · <a href="/tools/image-compressor">Image Compressor with quality slider</a></p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <CompareSlider />

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    document.addEventListener("DOMContentLoaded", () => {
      initTargetedCompressor({ targetSize: 100 * 1024 });

      const targetInput = document.getElementById("target-input") as HTMLInputElement;
      const setTargetBtn = document.getElementById("set-target-btn");

      function applyTarget() {
        const val = parseInt(targetInput?.value || "100", 10);
        const kb = Math.max(1, Math.min(10240, isNaN(val) ? 100 : val));
        const w = window as Record<string, unknown>;
        if (typeof w.__setTargetSize === "function") w.__setTargetSize(kb);
      }

      setTargetBtn?.addEventListener("click", applyTarget);
      targetInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") applyTarget();
      });

      // Preset buttons
      document.querySelectorAll(".preset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const kb = parseInt(btn.getAttribute("data-kb") || "100", 10);
          if (targetInput) targetInput.value = String(kb);
          const w = window as Record<string, unknown>;
          if (typeof w.__setTargetSize === "function") w.__setTargetSize(kb);
        });
      });
    });
  </script>
</BaseLayout>
