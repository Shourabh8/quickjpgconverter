---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "PNG to PDF", url: "/tools/png-to-pdf" },
];

const faqItems = [
  {
    question: "How do I convert PNG images to PDF?",
    answer: "Simply drag and drop your PNG images into the converter or click to browse. Each image becomes a page in the PDF document. You can then download the PDF instantly.",
  },
  {
    question: "Will converting PNG to PDF reduce quality?",
    answer: "No. Your PNG images are embedded into the PDF at full quality. PDF preserves the original image data, so your converted files maintain the same visual fidelity as the originals.",
  },
  {
    question: "Can I combine multiple PNG files into one PDF?",
    answer: "Yes. You can add multiple PNG files, and each will become a separate page in the PDF. You can arrange them in any order before converting.",
  },
  {
    question: "Is there a file size limit?",
    answer: "You can upload PNG files up to 50MB each. The converter runs entirely in your browser, so processing time depends on your device and the number of images.",
  },
  {
    question: "Does this work on mobile?",
    answer: "Yes. Our PNG to PDF converter works on any device — iPhone, Android, tablet, or desktop. No app installation needed. Just open the tool in your browser and convert.",
  },
  {
    question: "Can I convert JPG images to PDF too?",
    answer: "Yes. Our converter supports JPG, PNG, WebP, and HEIC images. Check out our JPG to PDF tool for dedicated JPG conversion with additional options.",
  },
];
---

<BaseLayout
  title="Free PNG to PDF Converter — Create PDF from Images"
  description="Convert PNG images to PDF documents instantly. Free online converter that runs in your browser — no uploads, no signup. Create professional PDFs from your images."
  canonical="https://quickjpgconverter.com/tools/png-to-pdf"
  keywords={["png to pdf", "convert png to pdf", "image to pdf"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "PNG to PDF Converter",
    description: "Convert PNG images into PDF documents.",
    url: "https://quickjpgconverter.com/tools/png-to-pdf",
    featureList: ["Multiple images to PDF", "Page ordering", "Quality options", "Instant conversion", "No software required", "Browser-based", "Free tool"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free PNG to <span class="gradient-text">PDF</span> Converter — Create PDFs from PNG Images
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Convert your PNG images into PDF documents. Perfect for sharing, printing, and archiving. Runs entirely in your browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Convert to:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">PDF</button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your PNG files here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".png" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">PNG · Max 50MB per file · Multiple files supported</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Input: PNG</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: PDF</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Output Format</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">PDF</div>
                      <div class="text-xs text-text-tertiary">Universal · Printable · Archival</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Converting...</p>
              </div>
              <div id="convert-btn-area">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Convert to PDF
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Upload PNG images to start conversion</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Supported:</span>
          {["PNG"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Max 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>Multiple files</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="PNG to PDF" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your PNGs</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select your PNG images.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Create PDF</h3>
          <p class="text-sm text-text-secondary">Each image becomes a page in your PDF. No server uploads.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download PDF</h3>
          <p class="text-sm text-text-secondary">Get your PDF document instantly, ready to share or print.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Convert PNG to PDF?</h2>
        <p>PNG images are great for high-quality graphics and photos, but sometimes you need a single document that combines multiple images. Converting PNG to PDF creates a professional, shareable document that works everywhere.</p>
        <h3>Common Use Cases</h3>
        <ul>
          <li>Combine multiple images into a single document</li>
          <li>Create photo albums or portfolios</li>
          <li>Prepare images for printing</li>
          <li>Archive images in a universal format</li>
          <li>Share multiple images as one file via email</li>
        </ul>
        <p><a href="/tools/jpg-to-pdf">Also try our JPG to PDF converter for JPEG images →</a></p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Converters</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/jpg-to-pdf" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PDF</h3>
          <p class="text-sm text-text-secondary">Convert JPG images into PDF documents.</p>
        </a>
        <a href="/tools/pdf-to-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PDF to JPG</h3>
          <p class="text-sm text-text-secondary">Extract PDF pages as JPG images.</p>
        </a>
        <a href="/tools/pdf-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">PDF to PNG</h3>
          <p class="text-sm text-text-secondary">Extract PDF pages as lossless PNG images.</p>
        </a>
        <a href="/tools/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Compressor</h3>
          <p class="text-sm text-text-secondary">Compress images without quality loss.</p>
        </a>
        <a href="/tools/jpg-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PNG</h3>
          <p class="text-sm text-text-secondary">Convert JPG to PNG with lossless quality.</p>
        </a>
        <a href="/tools/resize-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Resize JPG</h3>
          <p class="text-sm text-text-secondary">Resize images to any dimension.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initJpgToPdf } from "@scripts/jpg-to-pdf.js";
    document.addEventListener("DOMContentLoaded", () => initJpgToPdf());
  </script>
</BaseLayout>
