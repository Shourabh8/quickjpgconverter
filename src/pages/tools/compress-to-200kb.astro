---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import CompareSlider from "@components/ui/CompareSlider.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "Compress to 200KB", url: "/tools/compress-to-200kb" },
];

const faqItems = [
  {
    question: "When would I need to compress an image to 200KB?",
    answer: "200KB is a common file size limit for online job portals, university applications, and professional networking sites. It provides a good balance between file size and image quality.",
  },
  {
    question: "Will my image look good at 200KB?",
    answer: "Yes. 200KB typically preserves good quality for most photos and documents. Our compressor uses intelligent quality reduction to maintain visual clarity while meeting the target size.",
  },
  {
    question: "What image formats are supported?",
    answer: "We support JPG, PNG, and WebP input formats. The output is always JPG to ensure the smallest possible file size at the target.",
  },
  {
    question: "Can I compress multiple images at once?",
    answer: "Yes. You can upload multiple images and compress them all to 200KB or less. Each image is processed individually to meet the target size.",
  },
  {
    question: "Is there a file size limit for uploads?",
    answer: "You can upload images up to 50MB. The compressor runs entirely in your browser, so processing time depends on your device and the number of images.",
  },
  {
    question: "Does this work on mobile?",
    answer: "Yes. Our compressor works on any device — iPhone, Android, tablet, or desktop. No app installation needed. Just open the tool in your browser and compress.",
  },
];
---

<BaseLayout
  title="Compress Image to 200KB — Free Online Photo Reducer"
  description="Compress any image to under 200KB for job portals, applications, and professional use. Free online tool that runs in your browser — no uploads, no signup."
  canonical="https://quickjpgconverter.com/tools/compress-to-200kb"
  keywords={["compress image to 200kb", "reduce image to 200kb", "200kb image compressor"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "Compress to 200KB",
    description: "Compress images to under 200KB for portal uploads and form submissions.",
    url: "https://quickjpgconverter.com/tools/compress-to-200kb",
    featureList: ["Target 200KB file size", "Smart quality optimization", "Portal upload ready", "Batch compression", "Instant processing", "Free to use", "Browser-based"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free Image Compressor to <span class="gradient-text">200KB</span> — No Upload, No Signup
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Perfect for job portals, applications, and professional use. Compress any image to under 200KB while maintaining quality.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Target size:</span>
            <div class="flex items-center gap-2">
              <span id="target-size-display" class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">200 KB</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your images here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Max 50MB per file · Multiple files supported</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Target: ≤ 200KB</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Target File Size</h3>
                <div class="p-4 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30">
                  <div class="text-center">
                    <div class="text-3xl font-bold text-brand-600 dark:text-brand-400 mb-1">200KB</div>
                    <p class="text-xs text-text-secondary">Ideal for job portals and professional use</p>
                  </div>
                </div>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Output Format</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">JPG</div>
                      <div class="text-xs text-text-tertiary">Lossy · Universal · Smaller files</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compressing...</p>
              </div>
              <div id="compress-btn-area">
                <button id="compress-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Compress to 200KB
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Upload images to start compression</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Supported:</span>
          {["JPG", "PNG", "WebP"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Max 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>Multiple files</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="Compress to 200KB" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your images</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select your photos.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Auto-compress</h3>
          <p class="text-sm text-text-secondary">Our algorithm reduces quality to hit exactly 200KB.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download JPG</h3>
          <p class="text-sm text-text-secondary">Get your 200KB image instantly, ready to upload.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Compress to 200KB?</h2>
        <p>Many professional platforms and job portals require profile photos and documents to be under 200KB. This file size provides a good balance between quality and compatibility, making your images suitable for LinkedIn, Indeed, and other professional networks.</p>
        <h3>Common Use Cases</h3>
        <ul>
          <li>Job portal profile photos (LinkedIn, Indeed, etc.)</li>
          <li>Professional networking sites</li>
          <li>University application portals</li>
          <li>Corporate intranet uploads</li>
          <li>Email attachment optimization</li>
        </ul>
        <p><a href="/tools/compress-to-100kb">Need stricter compression? Try our 100KB compressor →</a></p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Related Tools</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Try Our Other Converters</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/compress-to-100kb" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress to 100KB</h3>
          <p class="text-sm text-text-secondary">Compress images to under 100KB.</p>
        </a>
        <a href="/tools/image-enhancer" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Enhancer</h3>
          <p class="text-sm text-text-secondary">Enhance brightness, contrast, and sharpness.</p>
        </a>
        <a href="/tools/image-compressor" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Image Compressor</h3>
          <p class="text-sm text-text-secondary">Custom compression with quality slider.</p>
        </a>
        <a href="/tools/resize-jpg" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Resize JPG</h3>
          <p class="text-sm text-text-secondary">Resize images to any dimension.</p>
        </a>
        <a href="/tools/jpg-to-png" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to PNG</h3>
          <p class="text-sm text-text-secondary">Convert JPG to PNG with lossless quality.</p>
        </a>
        <a href="/tools/jpg-to-webp" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">JPG to WebP</h3>
          <p class="text-sm text-text-secondary">Convert JPG to modern WebP format.</p>
        </a>
      </div>
    </Container>
  </section>

  <CompareSlider />

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    document.addEventListener("DOMContentLoaded", () => initTargetedCompressor({ targetSize: 200 * 1024 }));
  </script>
</BaseLayout>
