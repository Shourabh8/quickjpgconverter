---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import ToolCard from "@components/tool/ToolCard.astro";
import { tools, categories, getToolsByCategory } from "@data/tools";

const categoryOrder: Array<keyof typeof categories> = [
  "image-converters",
  "image-compressors",
  "image-tools",
  "pdf-converters",
  "pdf-tools",
];
---

<BaseLayout
  title="Free Online Image Converter Tools — JPG, PNG, WebP, PDF"
  description="Browse all free online image tools — JPG to PNG, PNG to JPG, JPG to WebP, WebP to JPG, Image Compressor, PDF Compressor, and more. Fast, private, and 100% browser-based."
  canonical="https://quickjpgconverter.com/tools"
  keywords={["free online image tools", "jpg png converter", "image compressor", "resize image", "pdf converter", "bulk image converter"]}
  breadcrumbs={[{ name: "Tools", url: "/tools" }]}
>
  <section class="section bg-glow">
    <Container>
      <div class="text-center mb-8 animate-fade-in-up">
        <Badge class="mb-4">All Tools</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Conversion Tools
        </h1>
        <p class="text-text-secondary max-w-2xl mx-auto mb-8">
          Free, fast, and private image and PDF conversion tools. Everything runs in your browser.
        </p>

        <!-- Search Bar -->
        <div class="max-w-lg mx-auto relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
          </div>
          <input
            id="tool-search"
            type="text"
            placeholder="Search tools... (e.g., pdf, webp, compress)"
            class="w-full pl-11 pr-4 py-3 rounded-xl border border-border-default bg-surface text-text-primary text-sm placeholder:text-text-tertiary focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all"
          />
          <button id="search-clear" class="absolute inset-y-0 right-0 pr-4 flex items-center text-text-tertiary hover:text-text-primary hidden" aria-label="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p id="search-empty" class="text-sm text-text-tertiary mt-3 hidden">No tools match your search. Try a different keyword.</p>
      </div>

      <!-- Category Navigation -->
      <div id="category-nav" class="flex flex-wrap justify-center gap-3 mb-12">
        {categoryOrder.map((cat) => (
          <a
            href={`#${cat}`}
            class="category-link inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-border-default bg-surface hover:bg-surface-muted hover:border-brand-300 dark:hover:border-brand-700 transition-all duration-200 text-sm font-medium text-text-secondary hover:text-text-primary"
          >
            <span>{categories[cat].icon}</span>
            <span>{categories[cat].title}</span>
          </a>
        ))}
      </div>

      <!-- Tool Categories -->
      {categoryOrder.map((cat) => {
        const categoryTools = getToolsByCategory(cat);
        const catInfo = categories[cat];
        return (
          <div id={cat} class="tool-category mb-16 scroll-mt-24" data-category={cat}>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center text-xl">
                {catInfo.icon}
              </div>
              <div>
                <h2 class="text-xl sm:text-2xl font-bold text-text-primary">{catInfo.title}</h2>
                <p class="text-sm text-text-secondary">{catInfo.description}</p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              {categoryTools.map((tool) => (
                <ToolCard
                  slug={tool.slug}
                  title={tool.title}
                  description={tool.description}
                  from={tool.from}
                  to={tool.to}
                  icon={tool.icon}
                  data-search={`${tool.title} ${tool.description} ${tool.from} ${tool.to} ${tool.slug}`.toLowerCase()}
                />
              ))}
            </div>
          </div>
        );
      })}
    </Container>
  </section>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById("tool-search");
      const clearBtn = document.getElementById("search-clear");
      const emptyMsg = document.getElementById("search-empty");
      const categoryNav = document.getElementById("category-nav");
      if (!searchInput) return;

      const cards = document.querySelectorAll("[data-search]");
      const categories = document.querySelectorAll(".tool-category");

      searchInput.addEventListener("input", function () {
        const q = this.value.trim().toLowerCase();
        clearBtn.classList.toggle("hidden", q === "");

        let visibleCount = 0;

        cards.forEach((card) => {
          const match = q === "" || card.getAttribute("data-search").includes(q);
          card.closest(".card-gradient, a")?.classList.toggle("hidden", !match);
          if (match) visibleCount++;
        });

        categories.forEach((cat) => {
          const visibleCards = cat.querySelectorAll("[data-search]");
          const anyVisible = Array.from(visibleCards).some(
            (c) => !c.closest(".card-gradient, a")?.classList.contains("hidden")
          );
          cat.classList.toggle("hidden", !anyVisible);
        });

        categoryNav?.classList.toggle("hidden", q !== "");
        emptyMsg?.classList.toggle("hidden", visibleCount > 0 || q === "");
      });

      clearBtn?.addEventListener("click", function () {
        searchInput.value = "";
        searchInput.dispatchEvent(new Event("input"));
        searchInput.focus();
      });

      // Read ?q= param from URL (used by Google SearchAction sitelinks searchbox)
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get("q");
      if (initialQuery) {
        searchInput.value = initialQuery;
        searchInput.dispatchEvent(new Event("input"));
      }
    })();
  </script>
</BaseLayout>
