---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import ToolCard from "@components/tool/ToolCard.astro";
import { tools, categories, getToolsByCategory } from "@data/tools";

const categoryOrder: Array<keyof typeof categories> = [
  "image-converters",
  "image-compressors",
  "image-tools",
  "pdf-converters",
  "pdf-tools",
];
---

<BaseLayout
  title="Free Online Image Converter Tools — JPG, PNG, WebP, PDF"
  description="Browse all free online image tools — JPG to PNG, PNG to JPG, JPG to WebP, WebP to JPG, Image Compressor, PDF Compressor, and more. Fast, private, and 100% browser-based."
  canonical="https://quickjpgconverter.com/tools"
  keywords={["free online image tools", "jpg png converter", "image compressor", "resize image", "pdf converter", "bulk image converter"]}
  breadcrumbs={[{ name: "Tools", url: "/tools" }]}
>
  <section class="section bg-glow">
    <Container>
      <div class="text-center mb-12 animate-fade-in-up">
        <Badge class="mb-4">All Tools</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Conversion Tools
        </h1>
        <p class="text-text-secondary max-w-2xl mx-auto">
          Free, fast, and private image and PDF conversion tools. Everything runs in your browser.
        </p>
      </div>

      <!-- Category Navigation -->
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        {categoryOrder.map((cat) => (
          <a
            href={`#${cat}`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-border-default bg-surface hover:bg-surface-muted hover:border-brand-300 dark:hover:border-brand-700 transition-all duration-200 text-sm font-medium text-text-secondary hover:text-text-primary"
          >
            <span>{categories[cat].icon}</span>
            <span>{categories[cat].title}</span>
          </a>
        ))}
      </div>

      <!-- Tool Categories -->
      {categoryOrder.map((cat) => {
        const categoryTools = getToolsByCategory(cat);
        const catInfo = categories[cat];
        return (
          <div id={cat} class="mb-16 scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center text-xl">
                {catInfo.icon}
              </div>
              <div>
                <h2 class="text-xl sm:text-2xl font-bold text-text-primary">{catInfo.title}</h2>
                <p class="text-sm text-text-secondary">{catInfo.description}</p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              {categoryTools.map((tool) => (
                <ToolCard
                  slug={tool.slug}
                  title={tool.title}
                  description={tool.description}
                  from={tool.from}
                  to={tool.to}
                  icon={tool.icon}
                />
              ))}
            </div>
          </div>
        );
      })}
    </Container>
  </section>
</BaseLayout>
