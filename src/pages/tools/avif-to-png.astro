---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "AVIF to PNG", url: "/tools/avif-to-png" },
];

const conversionOptions = [
  { id: "quality-high", label: "High Quality", desc: "Best visual fidelity, larger file", checked: true },
  { id: "quality-balanced", label: "Balanced", desc: "Good balance of size and quality", checked: false },
  { id: "quality-small", label: "Smallest Size", desc: "Smallest file, slight quality loss", checked: false },
];

const faqItems = [
  {
    question: "Why should I convert AVIF to PNG?",
    answer: "PNG uses lossless compression, preserving all image data. Converting AVIF to PNG is ideal when you need to edit the image further, require transparency support, or need lossless quality for archival purposes.",
  },
  {
    question: "Will the PNG file be larger than AVIF?",
    answer: "Yes. PNG uses lossless compression, which retains all image data, resulting in larger files. However, the quality is perfectly preserved with no compression artifacts.",
  },
  {
    question: "What is AVIF?",
    answer: "AVIF (AV1 Image File Format) is a next-generation image format developed by the Alliance for Open Media. It offers 50% better compression than JPEG at equivalent quality.",
  },
  {
    question: "Can I convert multiple AVIF files at once?",
    answer: "Yes. You can drag and drop or select multiple AVIF files. They'll all be converted to PNG simultaneously, and you can download them individually or as a ZIP.",
  },
  {
    question: "Is my data safe?",
    answer: "Absolutely. All conversion happens entirely in your browser. Your images are never uploaded to any server. They stay on your device from start to finish.",
  },
];
---

<BaseLayout
  title="Free AVIF to PNG Converter — Lossless Quality"
  description="Convert AVIF to PNG with lossless quality. Free online converter with transparency support. 100% private — no uploads."
  canonical="https://quickjpgconverter.com/tools/avif-to-png"
  keywords={["avif to png", "convert avif to png", "avif to png converter"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "AVIF to PNG Converter",
    description: "Convert AVIF images to PNG with lossless quality and transparency.",
    url: "https://quickjpgconverter.com/tools/avif-to-png",
    featureList: ["Lossless quality preservation", "Transparent background support", "Batch conversion", "Instant browser conversion", "No software needed", "100% private", "Free to use"],
  }}
  noindex={true}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free AVIF to <span class="gradient-text">PNG</span> Converter — Lossless Quality
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Convert your AVIF images to PNG with lossless quality and transparency support.
          Everything runs in your browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Convert to:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">PNG</button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your AVIF files here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".avif" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">AVIF · Max 50MB per file · Multiple files supported</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Input: AVIF</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: PNG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Conversion Options</h3>
                <div class="space-y-2">
                  {conversionOptions.map((opt) => (
                    <label class:list={[
                      "flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200",
                      opt.checked ? "border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30" : "border-border-default hover:border-border-strong hover:bg-surface-subtle/50"
                    ]}>
                      <input type="radio" name="quality" value={opt.id} checked={opt.checked} class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-text-primary">{opt.label}</div>
                        <div class="text-xs text-text-tertiary mt-0.5">{opt.desc}</div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>
              <div class="h-px bg-border-default mb-6"></div>
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Output Format</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">PNG</div>
                      <div class="text-xs text-text-tertiary">Lossless · Transparency · ~3-5× larger</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Converting...</p>
              </div>
              <div id="convert-btn-area">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Convert to PNG
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Upload a file to start conversion</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="AVIF to PNG" />

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Convert AVIF to PNG?</h2>
        <p>While AVIF offers superior compression, PNG provides lossless quality. Converting AVIF to PNG is ideal when you need to preserve every pixel, require transparency support, or need a format supported by all editing software.</p>
        <h3>When You Need PNG</h3>
        <ul>
          <li>Editing images in software that doesn't support AVIF</li>
          <li>Requiring lossless quality for archival or printing</li>
          <li>Needing transparent backgrounds for design work</li>
          <li>When file size is less important than quality</li>
        </ul>
        <p>Also check out our <a href="/tools/avif-to-jpg">AVIF to JPG converter</a> for smaller files, and our <a href="/tools/jpg-to-avif">JPG to AVIF converter</a> for next-gen compression.</p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <script>
    import { initConverter } from "@scripts/converter.js";
    document.addEventListener("DOMContentLoaded", () => initConverter({ targetFormat: "png", targetExt: "png", targetMime: "image/png" }));
  </script>
</BaseLayout>
