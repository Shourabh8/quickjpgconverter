---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "SVG to JPG", url: "/svg-to-jpg" },
];

const conversionOptions = [
  { value: "1", label: "1× (Original)", desc: "Same size as SVG viewBox" },
  { value: "2", label: "2× (Retina)", desc: "2× resolution, crisp on Retina displays", selected: true },
  { value: "4", label: "4× (Ultra)", desc: "4× resolution, print-quality output" },
];

const faqItems = [
  {
    question: "Why should I convert SVG to JPG?",
    answer: "JPG provides universal compatibility across all platforms and devices. It's also much smaller than PNG when transparency isn't needed. JPG is ideal for social media, web graphics, and any situation where file size matters.",
  },
  {
    question: "What happens to transparency?",
    answer: "JPG doesn't support transparency. Transparent areas in your SVG will be filled with white. If you need transparency, use our SVG to PNG converter instead.",
  },
  {
    question: "What resolution should I choose?",
    answer: "For web use, 2× (Retina) is ideal. For print or large displays, choose 4×. For simple icons at exact pixel sizes, 1× works fine.",
  },
  {
    question: "Can I convert multiple SVG files at once?",
    answer: "Yes. You can drag and drop or select multiple SVG files. They'll all be converted simultaneously, and you can download them individually or as a ZIP.",
  },
  {
    question: "Is my data safe?",
    answer: "Absolutely. All conversion happens entirely in your browser. Your files are never uploaded to any server. They stay on your device from start to finish.",
  },
];
---

<BaseLayout
  title="SVG to JPG Converter — Free Online"
  description="Convert SVG to JPG for smaller files and universal compatibility. Choose 1×, 2×, or 4× resolution. Free online converter. 100% private."
  canonical="https://quickjpgconverter.com/svg-to-jpg"
  keywords={["svg to jpg", "convert svg to jpg", "svg to jpeg"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  toolSchema={{
    name: "SVG to JPG Converter",
    description: "Convert SVG images to JPG for wider compatibility and smaller files.",
    url: "https://quickjpgconverter.com/svg-to-jpg",
    featureList: ["Smaller file sizes", "Universal compatibility", "1×, 2×, 4× resolution options", "Batch conversion", "Instant browser conversion", "No software needed", "Free to use"],
  }}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Free SVG to <span class="gradient-text">JPG</span> Converter — Smaller Files
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Convert SVG to JPG for smaller files and universal compatibility.
          Everything runs in your browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Convert to:</span>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
                <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">JPG</button>
              </div>
              <div class="flex items-center gap-2">
                <label class="text-xs text-text-tertiary">Scale:</label>
                <select id="output-scale" class="text-xs font-medium px-2 py-1 rounded-lg border border-border-default bg-surface text-text-primary focus:outline-none focus:border-brand-500">
                  {conversionOptions.map((opt) => (
                    <option value={opt.value} selected={opt.selected}>{opt.label}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your SVG files here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">or click to browse from your computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Files
                    <input type="file" class="sr-only" accept=".svg" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">SVG · Multiple files supported</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to upload</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Input: SVG</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Output: JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Options -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <h3 class="text-sm font-semibold text-text-primary mb-4">Conversion Options</h3>

              <div class="space-y-3 mb-6">
                <div class="p-3 rounded-lg border border-brand-200 dark:border-brand-800 bg-brand-50 dark:bg-brand-950/50">
                  <div class="text-xs font-medium text-brand-700 dark:text-brand-400 mb-1">Output Format</div>
                  <div class="text-sm font-semibold text-text-primary">JPG (No Transparency)</div>
                </div>
                <div class="p-3 rounded-lg border border-border-default bg-surface-muted">
                  <div class="text-xs font-medium text-text-tertiary mb-1">Resolution</div>
                  <div class="text-sm text-text-secondary">2× (Retina) — crisp on high-DPI screens</div>
                </div>
              </div>

              <div class="mb-6">
                <h4 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-2">When to Use</h4>
                <ul class="text-xs text-text-secondary space-y-1.5">
                  <li>• Social media profile pictures</li>
                  <li>• Web graphics where size matters</li>
                  <li>• Email signatures</li>
                  <li>• Platforms that don't support SVG</li>
                </ul>
              </div>

              <div class="mt-auto space-y-2">
                <div id="convert-btn-area" class="hidden">
                  <button id="convert-btn" class="w-full btn-primary btn-lg justify-center">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    Convert to JPG
                  </button>
                </div>
                <div id="progress-area" class="hidden">
                  <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Converting...</p>
                </div>
                <div id="download-area" class="hidden"></div>
              </div>

              <div class="mt-6 pt-4 border-t border-border-default">
                <FeatureRequest toolName="SVG to JPG" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>SVG vs JPG — When to Use Which</h2>
        <p>SVG is ideal for vector graphics on the web — icons, logos, illustrations. But JPG is better when you need universal compatibility or smaller file sizes for photographic content.</p>
        <h3>Choose JPG When:</h3>
        <ul>
          <li>Uploading to social media (Instagram, Twitter, Facebook)</li>
          <li>Sending via email (many clients don't render SVG)</li>
          <li>Using in Microsoft Office documents</li>
          <li>File size is more important than transparency</li>
        </ul>
        <h3>Choose PNG When:</h3>
        <ul>
          <li>You need transparent backgrounds</li>
          <li>Printing at high quality</li>
          <li>Archiving vector graphics as raster</li>
        </ul>
        <p>Also check out our <a href="/svg-to-png">SVG to PNG converter</a> for transparent output.</p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <script>
    import { initSvgConverter } from "@scripts/svg-converter.js";
    document.addEventListener("DOMContentLoaded", () => initSvgConverter({ targetFormat: "jpeg", targetExt: "jpg", targetMime: "image/jpeg" }));
  </script>
</BaseLayout>
