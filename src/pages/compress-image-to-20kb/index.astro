---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Compress Image to 20KB", url: "/compress-image-to-20kb" },
];

const faqItems = [
  {
    question: "Why would I need to compress an image to 20KB?",
    answer: "Some government portals and institutional forms enforce extremely strict file size limits — as low as 20KB. This is common for signature uploads, thumb impressions, and certain SSC/UPSC form fields where minimal file sizes are required.",
  },
  {
    question: "Will a 20KB image be readable and clear?",
    answer: "For small passport-size photos and signature images, 20KB is sufficient for clear, recognizable results. The key is that the image dimensions remain appropriate for the intended use — a small photo at 20KB looks perfectly fine when displayed at the correct size.",
  },
  {
    question: "Can I compress PNG or WebP images to 20KB?",
    output: "Yes. Our tool accepts JPG, PNG, and WebP inputs and outputs a compressed JPG optimized to your target size.",
  },
  {
    question: "What happens if the image can't reach 20KB?",
    answer: "The tool will compress as aggressively as possible to get as close to 20KB as achievable. For very large source images, the result may be slightly above 20KB, but the quality slider can be adjusted further to push the size down.",
  },
  {
    question: "Is this tool different from the 50KB compressor?",
    answer: "The underlying technology is the same, but the 20KB target applies more aggressive compression algorithms. The default quality settings are tuned to achieve the smaller file size while preserving maximum readability.",
  },
  {
    question: "Are my images stored on any server?",
    answer: "No. Everything runs locally in your browser. Your photos never leave your device, ensuring complete privacy and security.",
  },
];

const keywords = [
  "compress image to 20kb",
  "reduce photo to 20kb",
  "20kb image compressor",
  "photo size 20kb",
  "compress jpg to 20kb",
];
---

<BaseLayout
  title="Compress Image to 20KB — Free Online Photo Resizer"
  description="Compress any image to under 20KB instantly. Ideal for strict government form requirements and SSC/UPSC applications. 100% private, browser-based."
  canonical="https://quickjpgconverter.com/compress-image-to-20kb"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={keywords}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <!-- Title Section -->
  <section class="pb-6 sm:pb-8 bg-glow">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">🎯 Ultra-Compact Output</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Compress Image to <span class="gradient-text">20KB</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Reduce any photo to under 20KB instantly. Ideal for strict government
          form requirements and SSC/UPSC applications. 100% private, browser-based.
        </p>
      </div>
    </Container>
  </section>

  <!-- Compressor Widget -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar -->
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Compress to 20KB</span>
            <div class="flex items-center gap-1.5 text-xs text-text-tertiary">
              <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
              Local Processing
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[440px]">
            <!-- LEFT: Upload / Preview -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
                >
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Drop your images here</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">tap to browse or drag and drop</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Choose Images
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp,image/*" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG / PNG / WebP · Multiple files supported · Max 50MB each</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Drop to compress</p>
                  </div>
                </div>
              </div>

              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 files ready</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Clear all</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Options + Actions -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col justify-between">
              <div>
                <h3 class="text-sm font-semibold text-text-primary mb-3">Target Size</h3>
                <div class="space-y-2 mb-6">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30 cursor-pointer transition-all duration-200">
                    <input type="radio" name="target-size" value="20" checked class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-text-primary">20KB (Recommended)</div>
                      <div class="text-xs text-text-tertiary mt-0.5">For strict government portals</div>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                    <input type="radio" name="target-size" value="15" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-text-primary">15KB (Ultra Small)</div>
                      <div class="text-xs text-text-tertiary mt-0.5">For signature and thumb impressions</div>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-border-default hover:border-border-strong hover:bg-surface-subtle/50 cursor-pointer transition-all duration-200">
                    <input type="radio" name="target-size" value="10" class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-text-primary">10KB (Minimum)</div>
                      <div class="text-xs text-text-tertiary mt-0.5">Maximum possible compression</div>
                    </div>
                  </label>
                </div>

                <div class="h-px bg-border-default mb-6"></div>

                <div class="mb-6">
                  <div class="flex items-center justify-between mb-2">
                    <label class="text-sm font-semibold text-text-primary" for="quality-slider">Quality</label>
                    <span id="quality-value" class="text-sm font-medium text-brand-600 dark:text-brand-400">70%</span>
                  </div>
                  <input
                    id="quality-slider"
                    type="range"
                    min="10"
                    max="95"
                    value="70"
                    class="w-full h-2 bg-surface-muted rounded-full appearance-none cursor-pointer accent-brand-600"
                  />
                  <div class="flex justify-between text-xs text-text-tertiary mt-1">
                    <span>Smaller</span>
                    <span>Better Quality</span>
                  </div>
                </div>
              </div>

              <div>
                <div id="progress-area" class="hidden mb-4">
                  <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compressing...</p>
                </div>

                <div id="compress-btn-area">
                  <button id="compress-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    Compress to 20KB
                  </button>
                  <p class="text-xs text-text-tertiary text-center mt-2">Processed locally in your browser</p>
                </div>

                <div id="download-area" class="hidden"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- How It Works -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Simple Process</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">How to Compress an Image to 20KB</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Upload Your Image</h3>
          <p class="text-sm text-text-secondary">Drag and drop or click to select. Accepts JPG, PNG, and WebP files.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Set Target to 20KB</h3>
          <p class="text-sm text-text-secondary">The 20KB target is pre-selected. Fine-tune quality if needed.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download Your Photo</h3>
          <p class="text-sm text-text-secondary">Get your ultra-compact photo ready for the strictest portal requirements.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SEO Prose & FAQ -->
  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Compress Images to 20KB?</h2>
        <p>
          While a 50KB limit is common for most government forms, certain portals enforce even stricter requirements — some demanding images as small as 20KB. This is particularly true for signature uploads, thumb impressions, and specific fields in SSC, UPSC, and IBPS application forms. In these cases, a standard photo compressor may not achieve the aggressive compression needed without specialized targeting.
        </p>
        <p>
          The 20KB threshold represents the extreme end of practical image compression. At this size, every kilobyte matters. Our compressor uses advanced algorithms that intelligently analyze the image content, reduce color depth where it's least noticeable, and optimize encoding to squeeze out maximum compression while keeping the essential visual information intact.
        </p>

        <h3>When You Need 20KB Compression</h3>
        <p>
          The need for ultra-compact 20KB images arises in several specific scenarios across Indian government and institutional systems:
        </p>
        <ul>
          <li><strong>Signature uploads:</strong> Many portals require handwritten signatures to be under 20KB, which is achievable since signatures are typically simple black-on-white images</li>
          <li><strong>Thumb impressions:</strong> Left and right thumb impression uploads often have the strictest size limits in examination forms</li>
          <li><strong>SSC CGL and CHSL forms:</strong> The Staff Selection Commission's combined graduate level and higher secondary level exams sometimes specify 20KB for certain image fields</li>
          <li><strong>UPSC Civil Services registration:</strong> While photos may allow 50KB, signature fields in UPSC forms frequently require 20KB or less</li>
          <li><strong>Bank recruitment forms:</strong> IBPS and individual bank recruitment portals may enforce 20KB limits for secondary image uploads</li>
        </ul>

        <h3>The Science Behind 20KB Compression</h3>
        <p>
          Achieving a 20KB file size from a multi-megabyte source requires aggressive but intelligent compression. The tool works by first analyzing the image's visual complexity, then applying a combination of lossy encoding (reducing color precision in areas the human eye is less sensitive to), metadata stripping (removing EXIF data, camera information, and color profiles), and optional dimension reduction.
        </p>
        <p>
          For simple images like signatures and thumb impressions on white backgrounds, 20KB compression produces excellent results because the image content is inherently low-complexity. For photographs, the quality slider gives you control over the trade-off between file size and visual fidelity. The browser-based processing ensures your sensitive biometric data never leaves your device.
        </p>

        <h3>Best Practices for 20KB Images</h3>
        <ul>
          <li><strong>Crop tightly:</strong> Remove all unnecessary background before compressing — less area means better quality at the same file size</li>
          <li><strong>Use high-contrast originals:</strong> Black text on white backgrounds compress far more efficiently than low-contrast images</li>
          <li><strong>Start with a smaller source:</strong> If you have a 5MB photo, resize it to the target dimensions first, then compress to 20KB</li>
          <li><strong>Check readability:</strong> Always open the compressed file and verify that the content (face, signature, text) is clearly legible</li>
          <li><strong>Keep the original:</strong> Always save the uncompressed original in case you need to re-compress with different settings</li>
        </ul>
      </div>

      <div class="mt-12">
        <div class="text-center mb-10">
          <Badge class="mb-4">FAQ</Badge>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
        </div>
        <FAQ items={faqItems} />
      </div>

      <!-- Related tools -->
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/compress-image-to-50kb" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress to 50KB</h3>
          <p class="text-sm text-text-secondary">Standard compression for most government forms.</p>
        </a>
        <a href="/compress-for-govt-form" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compress for Govt Form</h3>
          <p class="text-sm text-text-secondary">All-in-one tool for government form uploads.</p>
        </a>
        <a href="/passport-photo-size" class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Passport Photo Size</h3>
          <p class="text-sm text-text-secondary">Resize photos to standard passport dimensions.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initImageCompressor } from "@scripts/compressor.js";
    document.addEventListener("DOMContentLoaded", () => {
      initImageCompressor();
    });
  </script>
</BaseLayout>
