---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [{ name: "About", url: "/about" }];

const stats = [
  { value: "2M+", label: "Conversions monthly" },
  { value: "180+", label: "Countries served" },
  { value: "0", label: "Files ever stored" },
  { value: "100%", label: "Browser-side processing" },
];

const values = [
  {
    icon: "🛡️",
    title: "Privacy First",
    desc: "We designed this platform around one core principle: your files never leave your device. Every conversion happens in your browser using modern Web APIs.",
  },
  {
    icon: "⚡",
    title: "Speed Without Compromise",
    desc: "Client-side processing means zero upload wait times. Most conversions complete in under a second, regardless of file size.",
  },
  {
    icon: "🚫",
    title: "No Friction",
    desc: "No account required, no email verification, no file limits, no watermarks. Open the site and start converting immediately.",
  },
  {
    icon: "🌍",
    title: "Free for Everyone",
    desc: "We believe image tools should be universally accessible. Our platform is free to use for everyone, everywhere, forever.",
  },
];
---

<BaseLayout
  title="About Quick JPG Converter — Privacy-First Image Tools Platform"
  description="Learn how Quick JPG Converter works, our privacy-first mission, and why 2M+ users choose us every month for browser-based image conversion."
  canonical="https://quickjpgconverter.com/about"
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-10 text-center max-w-2xl mx-auto mb-12">
        <Badge class="mb-4">About Us</Badge>
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-4">
          Built for Privacy.<br />
          <span class="gradient-text">Designed for Speed.</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Quick JPG Converter is a browser-based image tools platform that processes your files entirely on your device — no server uploads, no data collection, no accounts required.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
        {stats.map((stat) => (
          <div class="text-center p-5 rounded-2xl border border-border-default bg-surface-muted">
            <div class="text-2xl sm:text-3xl font-bold gradient-text mb-1">{stat.value}</div>
            <div class="text-xs text-text-secondary">{stat.label}</div>
          </div>
        ))}
      </div>

      <div class="prose mb-16">
        <h2>Our Story</h2>
        <p>
          Quick JPG Converter was founded on a simple frustration: online image converters were asking users to upload private photos to unknown servers, often with unclear policies about what happened to those files. We decided to build something different.
        </p>
        <p>
          By leveraging the modern browser's Canvas API, WebAssembly capabilities, and JavaScript workers, we built a complete image processing platform that runs entirely in your browser. Your files process locally, complete instantly, and download directly to your device — no cloud infrastructure touches your images at any point.
        </p>
        <p>
          Today, Quick JPG Converter serves millions of conversions each month across 180+ countries, trusted by photographers, designers, developers, students, and businesses who need fast, private image tools they can rely on.
        </p>

        <h2>How It Works</h2>
        <p>
          When you drop a file onto our converter, your browser's JavaScript engine handles everything:
        </p>
        <ol>
          <li>Your file is read using the <strong>FileReader API</strong> directly from your local disk</li>
          <li>The image is decoded and drawn onto an HTML <strong>Canvas element</strong></li>
          <li>The canvas exports the image in your chosen format using <strong>toBlob()</strong></li>
          <li>The result is offered as a direct download via an <strong>Object URL</strong></li>
        </ol>
        <p>
          At no point does any data leave your browser. There are no network requests made during conversion. You can verify this yourself by disconnecting from the internet and using our tools — they work perfectly offline.
        </p>
      </div>

      <!-- Values Grid -->
      <div class="mb-16">
        <h2 class="text-xl font-bold text-text-primary mb-6">Our Values</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {values.map((val) => (
            <div class="p-5 rounded-2xl border border-border-default bg-surface">
              <div class="text-2xl mb-3">{val.icon}</div>
              <h3 class="text-base font-semibold text-text-primary mb-2">{val.title}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{val.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="prose mb-16">
        <h2>Transparency</h2>
        <p>
          We operate our platform with complete transparency. Our privacy policy explains in plain language what we collect (only anonymous analytics), what we never collect (your images, file contents, or personal data), and how we use the minimal data we do receive.
        </p>
        <p>
          Our revenue comes from non-intrusive display advertising that helps us cover hosting and development costs. We do not sell user data, we do not use affiliate tracking, and we do not sell premium features — the tools are free for everyone.
        </p>

        <h2>Contact Us</h2>
        <p>
          We welcome feedback, feature requests, bug reports, and any questions about our platform. Reach us at:
        </p>
        <ul>
          <li>Email: <a href="mailto:supportquickjpgconverter@gmail.com">supportquickjpgconverter@gmail.com</a></li>
          <li>Contact form: <a href="/contact">quickjpgconverter.com/contact</a></li>
        </ul>
        <p>
          We aim to respond within 2 business days. For feature requests, we track all suggestions and consider them for future updates.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
