---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [{ name: "About", url: "/about" }];

const stats = [
  { value: "2M+", label: "Conversions monthly" },
  { value: "180+", label: "Countries served" },
  { value: "0", label: "Files ever stored" },
  { value: "100%", label: "Browser-side processing" },
];

const values = [
  {
    icon: "🛡️",
    title: "Privacy First",
    desc: "We designed this platform around one core principle: your files never leave your device. Every conversion happens in your browser using modern Web APIs.",
  },
  {
    icon: "⚡",
    title: "Speed Without Compromise",
    desc: "Client-side processing means zero upload wait times. Most conversions complete in under a second, regardless of file size.",
  },
  {
    icon: "🚫",
    title: "No Friction",
    desc: "No account required, no email verification, no file limits, no watermarks. Open the site and start converting immediately.",
  },
  {
    icon: "🌍",
    title: "Free for Everyone",
    desc: "We believe image tools should be universally accessible. Our platform is free to use for everyone, everywhere, forever.",
  },
];

const expertise = [
  { label: "Canvas API", desc: "HTML5 image rendering" },
  { label: "WebAssembly", desc: "Near-native processing speed" },
  { label: "Web Workers", desc: "Multi-threaded conversion" },
  { label: "File API", desc: "Direct browser file access" },
];

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Quick JPG Converter",
  description: "Learn about Quick JPG Converter's privacy-first image tools platform and how it serves millions of users worldwide.",
  url: "https://quickjpgconverter.com/about",
  mainEntity: {
    "@type": "Organization",
    name: "Quick JPG Converter",
    url: "https://quickjpgconverter.com",
    description: "Privacy-first browser-based image conversion tools",
    foundingDate: "2024",
    numberOfEmployees: "2-10",
    sameAs: [],
  },
};
---

<BaseLayout
  title="About Quick JPG Converter — Privacy-First Image Tools Platform"
  description="Learn how Quick JPG Converter works, our privacy-first mission, and why 2M+ users choose us every month for browser-based image conversion."
  canonical="https://quickjpgconverter.com/about"
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />

  <section class="section">
    <Container variant="narrow">
      <Breadcrumb items={breadcrumbs} />

      <div class="mt-10 text-center max-w-2xl mx-auto mb-12">
        <Badge class="mb-4">About Us</Badge>
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-4">
          Built for Privacy.<br />
          <span class="gradient-text">Designed for Speed.</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Quick JPG Converter is a browser-based image tools platform that processes your files entirely on your device — no server uploads, no data collection, no accounts required.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
        {stats.map((stat) => (
          <div class="text-center p-5 rounded-2xl border border-border-default bg-surface-muted">
            <div class="text-2xl sm:text-3xl font-bold gradient-text mb-1">{stat.value}</div>
            <div class="text-xs text-text-secondary">{stat.label}</div>
          </div>
        ))}
      </div>

      <div class="prose mb-16">
        <h2>Our Story</h2>
        <p>
          Quick JPG Converter was founded on a simple frustration: online image converters were asking users to upload private photos to unknown servers, often with unclear policies about what happened to those files. We decided to build something different.
        </p>
        <p>
          By leveraging the modern browser's Canvas API, WebAssembly capabilities, and JavaScript workers, we built a complete image processing platform that runs entirely in your browser. Your files process locally, complete instantly, and download directly to your device — no cloud infrastructure touches your images at any point.
        </p>
        <p>
          Today, Quick JPG Converter serves millions of conversions each month across 180+ countries, trusted by photographers, designers, developers, students, and businesses who need fast, private image tools they can rely on.
        </p>

        <h2>How It Works</h2>
        <p>
          When you drop a file onto our converter, your browser's JavaScript engine handles everything:
        </p>
        <ol>
          <li>Your file is read using the <strong>FileReader API</strong> directly from your local disk</li>
          <li>The image is decoded and drawn onto an HTML <strong>Canvas element</strong></li>
          <li>The canvas exports the image in your chosen format using <strong>toBlob()</strong></li>
          <li>The result is offered as a direct download via an <strong>Object URL</strong></li>
        </ol>
        <p>
          At no point does any data leave your browser. There are no network requests made during conversion. You can verify this yourself by disconnecting from the internet and using our tools — they work perfectly offline.
        </p>
      </div>

      <!-- Technology Expertise -->
      <div class="mb-16">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-8 h-8 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
            <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-text-primary">Core Technology</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {expertise.map((tech) => (
            <div class="p-4 rounded-xl border border-border-default bg-surface-muted text-center">
              <div class="text-sm font-semibold text-text-primary mb-1">{tech.label}</div>
              <div class="text-[11px] text-text-tertiary">{tech.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Values Grid -->
      <div class="mb-16">
        <h2 class="text-xl font-bold text-text-primary mb-6">Our Values</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {values.map((val) => (
            <div class="p-5 rounded-2xl border border-border-default bg-surface">
              <div class="text-2xl mb-3">{val.icon}</div>
              <h3 class="text-base font-semibold text-text-primary mb-2">{val.title}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{val.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Team Section -->
      <div class="mb-16">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-8 h-8 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
            <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-text-primary">Our Team</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-border-default bg-surface">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center text-sm font-bold text-brand-700 dark:text-brand-300">QJ</div>
              <div>
                <h3 class="text-base font-semibold text-text-primary">Quick JPG Converter Team</h3>
                <p class="text-xs text-text-tertiary">Founders & Engineers</p>
              </div>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed">A small team of web developers and photographers obsessed with browser-based image processing. We believe privacy and performance aren't trade-offs — they're features.</p>
            <div class="flex flex-wrap gap-2 mt-3">
              <span class="text-xs px-2 py-1 rounded-full bg-surface-muted border border-border-default text-text-secondary">Canvas API</span>
              <span class="text-xs px-2 py-1 rounded-full bg-surface-muted border border-border-default text-text-secondary">WebAssembly</span>
              <span class="text-xs px-2 py-1 rounded-full bg-surface-muted border border-border-default text-text-secondary">Image Processing</span>
            </div>
          </div>
          <div class="p-5 rounded-2xl border border-border-default bg-surface">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center text-sm font-bold text-brand-700 dark:text-brand-300">QJ</div>
              <div>
                <h3 class="text-base font-semibold text-text-primary">Content & Community</h3>
                <p class="text-xs text-text-tertiary">Writers & Support</p>
              </div>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed">We write detailed guides on image conversion, compression, and web optimization — drawing from real experience building and using these tools daily.</p>
            <div class="flex flex-wrap gap-2 mt-3">
              <span class="text-xs px-2 py-1 rounded-full bg-surface-muted border border-border-default text-text-secondary">Technical Writing</span>
              <span class="text-xs px-2 py-1 rounded-full bg-surface-muted border border-border-default text-text-secondary">SEO</span>
              <span class="text-xs px-2 py-1 rounded-full bg-surface-muted border border-border-default text-text-secondary">User Support</span>
            </div>
          </div>
        </div>
      </div>

      <div class="prose mb-16">
        <h2>Transparency</h2>
        <p>
          We operate our platform with complete transparency. Our privacy policy explains in plain language what we collect (only anonymous analytics), what we never collect (your images, file contents, or personal data), and how we use the minimal data we do receive.
        </p>
        <p>
          Our revenue comes from non-intrusive display advertising that helps us cover hosting and development costs. We do not sell user data, we do not use affiliate tracking, and we do not sell premium features — the tools are free for everyone.
        </p>

        <h2>Contact Us</h2>
        <p>
          We welcome feedback, feature requests, bug reports, and any questions about our platform. Reach us at:
        </p>
        <ul>
          <li>Email: <a href="mailto:supportquickjpgconverter@gmail.com">supportquickjpgconverter@gmail.com</a></li>
          <li>Contact form: <a href="/contact">quickjpgconverter.com/contact</a></li>
        </ul>
        <p>
          We aim to respond within 2 business days. For feature requests, we track all suggestions and consider them for future updates.
        </p>
      </div>

      <!-- Trust Signals -->
      <div class="p-6 rounded-2xl border border-border-default bg-surface-muted">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-success-muted flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-base font-semibold text-text-primary mb-1">Verified Privacy</h3>
            <p class="text-sm text-text-secondary">
              We've been independently verified. Our source code is auditable, our privacy claims are technically verifiable, and our tools work offline. We don't just say we're private — we prove it.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
