---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools" },
  { name: "QR Code Generator", url: "/qr-code-generator" },
];

const inputTabs = [
  { id: "url", label: "URL", icon: "🔗" },
  { id: "text", label: "Text", icon: "📝" },
  { id: "email", label: "Email", icon: "✉️" },
  { id: "phone", label: "Phone", icon: "📞" },
  { id: "wifi", label: "WiFi", icon: "📶" },
  { id: "vcard", label: "vCard", icon: "👤" },
];

const faqItems = [
  {
    question: "What is a QR code generator?",
    answer: "A QR code generator is a tool that creates QR codes — scannable barcodes that store information like URLs, text, contact details, or WiFi credentials. QuickJPG generates QR codes entirely in your browser for complete privacy.",
  },
  {
    question: "Are the QR codes free to use?",
    answer: "Yes. QuickJPG generates unlimited QR codes for free. There are no restrictions on usage, no watermarks, and no account required. Download as PNG, SVG, or PDF.",
  },
  {
    question: "Can I customize the QR code appearance?",
    answer: "Yes. You can change the foreground and background colors, adjust the size from 128px to 1024px, set the error correction level (L/M/Q/H), add a logo in the center, and adjust the quiet zone margin.",
  },
  {
    question: "What is error correction level in QR codes?",
    answer: "Error correction determines how much of the QR code can be damaged or obscured while still being readable. Level L recovers 7%, M recovers 15%, Q recovers 25%, and H recovers 30%. Higher levels make larger QR codes but allow logos in the center.",
  },
  {
    question: "Will QR codes I create expire?",
    answer: "No. QR codes are static images — they never expire. However, if you encode a URL, the QR code will only work as long as that URL remains active. Dynamic QR codes that redirect are a different technology not supported here.",
  },
];
---

<BaseLayout
  title="Free QR Code Generator — Create QR Codes Online"
  description="Generate QR codes for URLs, text, email, phone, WiFi, and contacts. Customize colors, size, and add logos. Download as PNG, SVG, or PDF. 100% free, no signup."
  canonical="https://quickjpgconverter.com/qr-code-generator"
  keywords={["qr code generator", "create qr code", "free qr code", "qr code maker", "generate qr code online", "qr code for url", "wifi qr code", "vcard qr code"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
          </svg>
          Free · No Signup · Private
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          <span class="gradient-text">QR Code</span> Generator
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Generate QR codes for URLs, text, contacts, WiFi, and more. Customize colors, add logos, and download instantly.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-6xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <!-- Top bar: Input tabs -->
          <div class="flex items-center gap-1 px-3 sm:px-4 py-3 border-b border-border-default bg-surface-muted overflow-x-auto">
            {inputTabs.map((tab, i) => (
              <button
                data-tab={tab.id}
                class:list={[
                  "flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium border transition-all duration-200 whitespace-nowrap flex-shrink-0",
                  i === 0
                    ? "bg-brand-600 text-white border-brand-600"
                    : "bg-surface text-text-secondary border-border-default hover:border-brand-300 dark:hover:border-brand-700",
                ]}
              >
                <span>{tab.icon}</span>
                <span class="hidden sm:inline">{tab.label}</span>
              </button>
            ))}
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[500px]">
            <!-- LEFT: Input forms -->
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <!-- URL Tab -->
              <div data-tab-panel="url" class="space-y-4">
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Website URL</label>
                  <input id="input-url" type="url" data-qr-input placeholder="https://example.com" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" value="https://quickjpgconverter.com" />
                </div>
                <p class="text-xs text-text-tertiary">Enter any URL to generate a scannable QR code.</p>
              </div>

              <!-- Text Tab -->
              <div data-tab-panel="text" class="space-y-4 hidden">
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Plain Text</label>
                  <textarea id="input-text" data-qr-input rows="5" placeholder="Enter any text..." class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none"></textarea>
                </div>
                <p class="text-xs text-text-tertiary">Encode any text into a QR code.</p>
              </div>

              <!-- Email Tab -->
              <div data-tab-panel="email" class="space-y-4 hidden">
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Email Address</label>
                  <input id="input-email" type="email" data-qr-input placeholder="contact@example.com" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Subject <span class="text-text-tertiary font-normal">(optional)</span></label>
                  <input id="input-email-subject" type="text" data-qr-input placeholder="Email subject" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Message <span class="text-text-tertiary font-normal">(optional)</span></label>
                  <textarea id="input-email-body" data-qr-input rows="3" placeholder="Email body text..." class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none"></textarea>
                </div>
                <p class="text-xs text-text-tertiary">Creates a mailto: link that opens the user's email app.</p>
              </div>

              <!-- Phone Tab -->
              <div data-tab-panel="phone" class="space-y-4 hidden">
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Phone Number</label>
                  <input id="input-phone" type="tel" data-qr-input placeholder="+1 (555) 123-4567" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <p class="text-xs text-text-tertiary">Creates a tel: link that initiates a call when scanned.</p>
              </div>

              <!-- WiFi Tab -->
              <div data-tab-panel="wifi" class="space-y-4 hidden">
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Network Name (SSID)</label>
                  <input id="input-wifi-ssid" type="text" data-qr-input placeholder="MyWiFiNetwork" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Password</label>
                  <input id="input-wifi-pass" type="text" data-qr-input placeholder="WiFi password" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Encryption</label>
                  <select id="input-wifi-enc" data-qr-input class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent cursor-pointer">
                    <option value="WPA">WPA/WPA2/WPA3</option>
                    <option value="WEP">WEP</option>
                    <option value="nopass">None (Open)</option>
                  </select>
                </div>
                <p class="text-xs text-text-tertiary">Scanning connects to the WiFi network automatically.</p>
              </div>

              <!-- vCard Tab -->
              <div data-tab-panel="vcard" class="space-y-4 hidden">
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Full Name *</label>
                  <input id="input-vcard-name" type="text" data-qr-input placeholder="John Doe" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="text-sm font-semibold text-text-primary block mb-2">Organization</label>
                    <input id="input-vcard-org" type="text" data-qr-input placeholder="Company Inc" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                  </div>
                  <div>
                    <label class="text-sm font-semibold text-text-primary block mb-2">Title</label>
                    <input id="input-vcard-title" type="text" data-qr-input placeholder="Software Engineer" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                  </div>
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Phone</label>
                  <input id="input-vcard-phone" type="tel" data-qr-input placeholder="+1 (555) 123-4567" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Email</label>
                  <input id="input-vcard-email" type="email" data-qr-input placeholder="john@example.com" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-text-primary block mb-2">Website</label>
                  <input id="input-vcard-url" type="url" data-qr-input placeholder="https://example.com" class="w-full px-4 py-3 rounded-xl border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <p class="text-xs text-text-tertiary">Creates a contact card that can be saved to the phone's contacts.</p>
              </div>
            </div>

            <!-- RIGHT: Preview + Customization -->
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <!-- QR Preview -->
              <div class="mb-6">
                <div class="rounded-xl border border-border-default bg-surface-muted/50 p-6 flex items-center justify-center min-h-[280px]">
                  <div id="qr-preview" class="flex items-center justify-center">
                    <div class="flex flex-col items-center justify-center text-text-tertiary">
                      <svg class="w-16 h-16 mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
                      </svg>
                      <p class="text-sm">Enter data to generate QR code</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Customization -->
              <div class="space-y-5 mb-6">
                <!-- Size -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label class="text-xs font-semibold text-text-tertiary uppercase tracking-wider">Size</label>
                    <span id="qr-size-value" class="text-xs font-medium text-brand-600 dark:text-brand-400">256px</span>
                  </div>
                  <input id="qr-size" type="range" min="128" max="1024" step="32" value="256" class="w-full h-2 bg-surface-muted rounded-full appearance-none cursor-pointer accent-brand-600" />
                </div>

                <!-- Colors -->
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="text-xs font-semibold text-text-tertiary uppercase tracking-wider block mb-2">Foreground</label>
                    <div class="flex items-center gap-2">
                      <input id="qr-fg-color" type="color" value="#000000" class="w-10 h-10 rounded-lg border border-border-default cursor-pointer" />
                      <span class="text-xs text-text-secondary">#000000</span>
                    </div>
                  </div>
                  <div>
                    <label class="text-xs font-semibold text-text-tertiary uppercase tracking-wider block mb-2">Background</label>
                    <div class="flex items-center gap-2">
                      <input id="qr-bg-color" type="color" value="#ffffff" class="w-10 h-10 rounded-lg border border-border-default cursor-pointer" />
                      <span class="text-xs text-text-secondary">#FFFFFF</span>
                    </div>
                  </div>
                </div>

                <!-- Error Correction -->
                <div>
                  <label class="text-xs font-semibold text-text-tertiary uppercase tracking-wider block mb-2">Error Correction</label>
                  <div class="flex items-center gap-2">
                    <select id="qr-error-level" class="flex-1 px-3 py-2.5 rounded-lg border border-border-default bg-surface text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent cursor-pointer">
                      <option value="L">L — Low (7% recovery)</option>
                      <option value="M" selected>M — Medium (15% recovery)</option>
                      <option value="Q">Q — Quartile (25% recovery)</option>
                      <option value="H">H — High (30% recovery, best for logos)</option>
                    </select>
                  </div>
                </div>

                <!-- Margin -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label class="text-xs font-semibold text-text-tertiary uppercase tracking-wider">Quiet Zone</label>
                    <span id="qr-margin-value" class="text-xs font-medium text-brand-600 dark:text-brand-400">4px</span>
                  </div>
                  <input id="qr-margin" type="range" min="0" max="16" step="1" value="4" class="w-full h-2 bg-surface-muted rounded-full appearance-none cursor-pointer accent-brand-600" />
                </div>

                <!-- Logo -->
                <div>
                  <label class="text-xs font-semibold text-text-tertiary uppercase tracking-wider block mb-2">Center Logo</label>
                  <div id="qr-logo-preview" class="hidden mb-2 flex items-center gap-2">
                    <span class="text-xs text-success font-medium">Logo added</span>
                    <button id="qr-logo-remove" class="text-xs text-danger hover:text-danger/80 transition-colors">Remove</button>
                  </div>
                  <label class="btn-secondary btn-sm w-full justify-center cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Add Logo
                    <input id="qr-logo-upload" type="file" class="sr-only" accept="image/*" />
                  </label>
                  <p class="text-[10px] text-text-tertiary mt-1">Use H error correction for best results</p>
                </div>
              </div>

              <div class="h-px bg-border-default mb-5"></div>

              <!-- Download Options -->
              <div class="space-y-2">
                <button id="download-png" class="w-full btn-primary btn-lg justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  Download PNG
                </button>
                <div class="grid grid-cols-2 gap-2">
                  <button id="download-svg" class="btn-secondary btn-md justify-center">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    SVG
                  </button>
                  <button id="download-pdf" class="btn-secondary btn-md justify-center">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    PDF
                  </button>
                </div>
                <button id="copy-clipboard" class="w-full btn-secondary btn-md justify-center">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                  </svg>
                  Copy to Clipboard
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="QR Code Generator" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">How It Works</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Three Steps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">01</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Choose input type</h3>
          <p class="text-sm text-text-secondary">Select URL, text, email, phone, WiFi, or contact card.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">02</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Customize your QR</h3>
          <p class="text-sm text-text-secondary">Change colors, size, error correction, and add a logo.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">03</div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">Download or share</h3>
          <p class="text-sm text-text-secondary">Save as PNG, SVG, PDF, or copy directly to clipboard.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Why Use a QR Code Generator?</h2>
        <p>
          QR codes are everywhere — on business cards, restaurant menus, product packaging, and marketing materials.
          They provide a instant bridge between physical and digital worlds. With QuickJPG's free QR code generator,
          you can create professional QR codes in seconds without any design skills or software installation.
        </p>
        <h3>Popular QR Code Use Cases</h3>
        <ul>
          <li>Business cards with contact information (vCard)</li>
          <li>WiFi sharing at home, office, or events</li>
          <li>Restaurant menus and product pages</li>
          <li>Social media profiles and links</li>
          <li>Event tickets and registration</li>
          <li>Marketing campaigns and flyers</li>
        </ul>
        <h3>Why Browser-Based Generation?</h3>
        <p>
          QuickJPG generates QR codes entirely in your browser. Your data never leaves your device — no server uploads,
          no tracking, no data collection. This makes it ideal for sensitive information like WiFi passwords, contact
          details, and private URLs. Generate unlimited QR codes for free with no watermarks or restrictions.
        </p>
      </div>
    </Container>
  </section>

