---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import { site } from "@data/site";
import { tools, categories, getToolsByCategory } from "@data/tools";
import { useTranslations, getLocalePrefix } from "@i18n/index";

import "@styles/homepage.css";

const locale = "de" as const;
const t = useTranslations(locale);
const prefix = getLocalePrefix(locale);

const faqItems = [
  {
    question: "Ist dieser JPG-Konverter wirklich kostenlos?",
    answer: "Ja, komplett kostenlos. Keine Registrierung, keine Wasserzeichen, keine versteckten Kosten, keine Nutzungsgrenzen. Konvertieren Sie so viele Bilder wie Sie benötigen, jeden Tag, für immer.",
  },
  {
    question: "Werden meine Bilder auf einen Server hochgeladen?",
    answer: "Nein. Die gesamte Konvertierung erfolgt direkt in Ihrem Browser mit WebAssembly und der Canvas API. Ihre Bilder verlassen Ihr Gerät nie — nicht einmal vorübergehend.",
  },
  {
    question: "Welche Bildformate werden unterstützt?",
    answer: "Wir unterstützen die Formate JPG, JPEG, PNG, WebP, HEIC und PDF. Sie können zwischen allen Kombinationen konvertieren und auch JPG-Bilder auf jede Größe ändern.",
  },
  {
    question: "Gibt es eine Dateigrößenbeschränkung?",
    answer: "Die praktische Grenze ist der verfügbare Speicher Ihres Geräts. Bei den meisten modernen Geräten können Sie Bilder bis zu 50MB ohne Probleme konvertieren.",
  },
  {
    question: "Funktioniert es auf Mobilgeräten?",
    answer: "Ja. Unsere Werkzeuge sind vollständig responsiv und funktionieren auf jedem Gerät mit einem modernen Webbrowser — iPhones, Android-Smartphones, Tablets und Desktops.",
  },
  {
    question: "Was unterscheidet es von anderen JPG-Konvertern?",
    answer: "Im Gegensatz zu serverbasierten Konvertern laden wir Ihre Dateien nie hoch. Das bedeutet schnellere Konvertierung, vollständiger Datenschutz und keine Dateigrößenbeschränkungen durch Serverlimits.",
  },
];

const steps = [
  {
    number: "01",
    title: t.home.step1Title,
    description: t.home.step1Desc,
  },
  {
    number: "02",
    title: t.home.step2Title,
    description: t.home.step2Desc,
  },
  {
    number: "03",
    title: t.home.step3Title,
    description: t.home.step3Desc,
  },
];

const comparisonFeatures = [
  { label: t.home.comparisonFeatures.noUpload, quickjpg: false, iloveimg: true, freeconvert: true },
  { label: t.home.comparisonFeatures.noPrivacyRisk, quickjpg: false, iloveimg: true, freeconvert: true },
  { label: t.home.comparisonFeatures.noFileLimits, quickjpg: false, iloveimg: true, freeconvert: true },
  { label: t.home.comparisonFeatures.noSignup, quickjpg: false, iloveimg: false, freeconvert: true },
  { label: t.home.comparisonFeatures.noWatermarks, quickjpg: false, iloveimg: false, freeconvert: false },
  { label: t.home.comparisonFeatures.offline, quickjpg: true, iloveimg: false, freeconvert: false },
  { label: t.home.comparisonFeatures.unlimited, quickjpg: true, iloveimg: false, freeconvert: false },
  { label: t.home.comparisonFeatures.browserBased, quickjpg: true, iloveimg: false, freeconvert: false },
];

const testimonials = [
  {
    quote: "Endlich ein Konverter, der mich nicht zwingt, meine Fotos auf einen zufälligen Server zu laden. Ein totaler Game-Changer für die Kundenarbeit.",
    author: "Sarah K.",
    role: "Freelance-Fotografin",
  },
  {
    quote: "Wir nutzen dies täglich für unsere E-Commerce-Produktbilder. Schnell, zuverlässig und die Konvertierung zu WebP spart uns Stunden an Optimierung.",
    author: "Marcus T.",
    role: "E-Commerce-Manager",
  },
  {
    quote: "Ich empfehle dies all meinen Studenten. Kein Konto nötig, kein Tracking, es funktioniert einfach. Genau so sollte das Internet sein.",
    author: "Dr. Chen",
    role: "Professor für Informatik",
  },
];
---

<BaseLayout
  title="Kostenloser JPG-Konverter — Online-Bildformat-Konvertierung"
  description="Konvertieren Sie JPG-, PNG-, WebP-, HEIC- und PDF-Bilder sofort mit unserem kostenlosen Online-JPG-Konverter. Schnell, privat und browserbasiert — ohne Uploads. Jetzt ausprobieren."
  canonical={`${site.url}${prefix}`}
  faqItems={faqItems}
  locale={locale}
  keywords={["jpg konverter", "kostenloser jpg konverter", "online jpg konverter", "png nach jpg konverter", "webp nach jpg konverter", "heic nach jpg konverter", "pdf nach jpg konverter", "jpg nach png konverter", "jpg nach webp konverter", "bildkompressor", "bild online komprimieren", "pdf kompressor", "online bildkonverter", "kostenloser bildkonverter", "bildkonverter ohne anmeldung"]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-500/8 rounded-full blur-3xl"></div>
    <Container class="relative pt-20 sm:pt-28 lg:pt-36 pb-16 sm:pb-20 lg:pb-24">
      <div class="text-center max-w-3xl mx-auto">
        <div class="mb-6 animate-fade-in">
          <Badge>{t.home.badge}</Badge>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-text-primary tracking-tight leading-[1.08] mb-6 animate-fade-in-up">
          {t.home.heroTitle1}<br />
          <span class="gradient-text">{t.home.heroTitle2}</span>
        </h1>
        <p class="text-lg sm:text-xl text-text-secondary max-w-xl mx-auto mb-10 leading-relaxed animate-fade-in-up delay-100">
          {t.home.heroSubtitle}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 animate-fade-in-up delay-200">
          <Button href={`${prefix}/tools/jpg-to-png`} size="xl" class="cta-glow">
            {t.home.startConvertingFree}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </Button>
          <Button href={`${prefix}/tools`} variant="secondary" size="xl">
            {t.home.viewAllTools}
          </Button>
        </div>
      </div>
      <!-- Converter preview -->
      <div class="mt-14 sm:mt-16 lg:mt-20 max-w-3xl mx-auto animate-fade-in-up delay-300">
        <div class="rounded-2xl border border-border-default bg-surface shadow-2xl shadow-brand-500/5 overflow-hidden">
          <div class="p-4 sm:p-6 lg:p-8">
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
              <div class="flex items-center gap-2 p-1.5 rounded-xl border border-border-default bg-surface-muted">
                <a href={`${prefix}/tools/jpg-to-png`} class="px-4 py-2 rounded-lg bg-surface text-sm font-semibold text-text-primary shadow-xs transition-colors hover:bg-brand-50 dark:hover:bg-brand-950/30">JPG</a>
                <a href={`${prefix}/tools/png-to-jpg`} class="px-4 py-2 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary cursor-pointer transition-colors">PNG</a>
                <a href={`${prefix}/tools/jpg-to-webp`} class="px-4 py-2 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary cursor-pointer transition-colors">WebP</a>
                <a href={`${prefix}/tools/jpg-to-pdf`} class="px-4 py-2 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary cursor-pointer transition-colors">PDF</a>
              </div>
              <div class="flex items-center gap-2 text-text-tertiary">
                <span class="text-sm font-medium">→</span>
                <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center">
                  <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </div>
                <span class="px-4 py-2 rounded-lg bg-brand-50 dark:bg-brand-950/50 border border-brand-200 dark:border-brand-800 text-sm font-semibold text-brand-700 dark:text-brand-300">PNG</span>
              </div>
            </div>
            <a href={`${prefix}/tools/jpg-to-png`} class="block border-2 border-dashed border-border-default rounded-xl p-8 sm:p-10 text-center bg-surface-muted/50 hover:border-brand-300 dark:hover:border-brand-700 transition-colors cursor-pointer group">
              <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-7 h-7 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                </svg>
              </div>
              <p class="text-sm font-medium text-text-primary mb-1">{t.home.dropzoneText}</p>
              <p class="text-xs text-text-tertiary">{t.home.dropzoneHint}</p>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ALL TOOLS GRID -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          {t.home.allToolsTitle}
        </h2>
        <p class="text-text-secondary max-w-xl mx-auto">
          {t.home.allToolsSubtitle}
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 max-w-6xl mx-auto">
        {tools.map((tool) => (
          <a
            href={`${prefix}/tools/${tool.slug}`}
            class="card-hover p-4 group flex flex-col items-start"
          >
            <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-3 text-lg group-hover:scale-110 transition-transform duration-300">
              {tool.icon}
            </div>
            <h3 class="text-sm font-semibold text-text-primary mb-0.5 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{t.tools[tool.slug as keyof typeof t.tools]?.title || tool.title}</h3>
            <p class="text-xs text-text-secondary leading-snug line-clamp-2">{t.tools[tool.slug as keyof typeof t.tools]?.description || tool.description}</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={`${prefix}/tools`} class="btn-primary btn-lg">
          {t.home.viewAllTools}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- TRUST SIGNALS -->
  <section class="section">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto text-center">
        <div class="flex flex-col items-center">
          <div class="flex items-center gap-1 mb-2">
            {Array(5).fill(0).map(() => (
              <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <span class="text-sm font-semibold text-text-primary">{t.home.trustRating}</span>
          <span class="text-xs text-text-tertiary">{t.home.trustRatingSub}</span>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-3">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128H9m6-3.07a8.959 8.959 0 00-2.625-.372 9.337 9.337 0 00-4.121.952M9 19.128v-.003c0-1.113.285-2.16.786-3.07m0 0a8.959 8.959 0 012.625-.372c1.348 0 2.611.363 3.71.987m-6.71-.987a3.375 3.375 0 114.773 0M12 10.5a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
          </div>
          <span class="text-sm font-semibold text-text-primary">{t.home.trustPrivate}</span>
          <span class="text-xs text-text-tertiary">{t.home.trustPrivateSub}</span>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-3">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
          </div>
          <span class="text-sm font-semibold text-text-primary">{t.home.trustInstant}</span>
          <span class="text-xs text-text-tertiary">{t.home.trustInstantSub}</span>
        </div>
      </div>
    </Container>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <Container>
      <div class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          {t.home.featuresTitle}
        </h2>
        <p class="text-text-secondary max-w-2xl mx-auto">
          {t.home.featuresSubtitle}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card-hover p-6 sm:p-7 group">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/10 to-brand-600/10 flex items-center justify-center border border-brand-200/50 dark:border-brand-800/50 mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-2">{t.home.feature1Title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.home.feature1Desc}</p>
        </div>
        <div class="card-hover p-6 sm:p-7 group">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/10 to-brand-600/10 flex items-center justify-center border border-brand-200/50 dark:border-brand-800/50 mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-2">{t.home.feature2Title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.home.feature2Desc}</p>
        </div>
        <div class="card-hover p-6 sm:p-7 group">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/10 to-brand-600/10 flex items-center justify-center border border-brand-200/50 dark:border-brand-800/50 mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-primary mb-2">{t.home.feature3Title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.home.feature3Desc}</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          {t.home.howItWorksTitle}
        </h2>
        <p class="text-text-secondary max-w-xl mx-auto">
          {t.home.howItWorksSubtitle}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {steps.map((step, i) => (
          <div class="relative text-center md:text-left">
            {i < steps.length - 1 && (
              <div class="hidden md:block absolute top-6 left-[calc(50%+2.5rem)] right-[calc(-50%+2.5rem)] h-px bg-gradient-to-r from-brand-200 to-brand-100 dark:from-brand-800 dark:to-brand-900"></div>
            )}
            <div class="relative inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white font-bold text-sm mb-5 shadow-lg shadow-brand-600/25">
              {step.number}
            </div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">{step.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- COMPARISON -->
  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          {t.home.comparisonTitle}
        </h2>
        <p class="text-text-secondary max-w-xl mx-auto">
          {t.home.comparisonSubtitle}
        </p>
      </div>
      <div class="rounded-2xl border border-border-default overflow-hidden bg-surface shadow-sm">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-surface-muted border-b border-border-default">
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary w-auto"></th>
              <th class="text-center px-4 sm:px-5 py-4 font-medium w-16 sm:w-20">
                <span class="inline-flex items-center gap-1 px-2 sm:px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 font-semibold border border-brand-200 dark:border-brand-800">
                  Quick JPG Converter
                </span>
              </th>
              <th class="text-center px-4 sm:px-5 py-4 font-medium text-text-tertiary w-16 sm:w-20">iLoveIMG</th>
              <th class="text-center px-4 sm:px-5 py-4 font-medium text-text-tertiary w-16 sm:w-20">FreeConvert</th>
            </tr>
          </thead>
          <tbody>
            {comparisonFeatures.map((feature, i) => (
              <tr class:list={[
                "comparison-row",
                i < comparisonFeatures.length - 1 && "border-b border-border-muted"
              ]}>
                <td class="px-4 sm:px-5 py-3 sm:py-3.5 text-text-secondary">{feature.label}</td>
                <td class="text-center px-4 sm:px-5 py-3 sm:py-3.5">
                  {feature.quickjpg ? (
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-success mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  ) : (
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-danger mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  )}
                </td>
                <td class="text-center px-4 sm:px-5 py-3 sm:py-3.5">
                  {feature.iloveimg ? (
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-danger mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  ) : (
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-success mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  )}
                </td>
                <td class="text-center px-4 sm:px-5 py-3 sm:py-3.5">
                  {feature.freeconvert ? (
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-danger mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  ) : (
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-success mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight">
          {t.home.testimonialsTitle}
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {testimonials.map((testimonial) => (
          <div class="card p-6 sm:p-7 flex flex-col">
            <p class="text-sm text-text-secondary leading-relaxed flex-1 mb-5">
              &bdquo;{testimonial.quote}&ldquo;
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-border-muted">
              <div class="w-10 h-10 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center text-sm font-bold text-brand-700 dark:text-brand-300">
                {testimonial.author.charAt(0)}
              </div>
              <div>
                <div class="text-sm font-semibold text-text-primary">{testimonial.author}</div>
                <div class="text-xs text-text-tertiary">{testimonial.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">
          {t.home.faqTitle}
        </h2>
        <p class="text-text-secondary">
          {t.home.faqSubtitle}
        </p>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <!-- CTA -->
  <section class="section relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[250px] bg-brand-500/8 rounded-full blur-3xl"></div>
    <Container class="relative">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-4">
          {t.home.ctaTitle}
        </h2>
        <p class="text-lg text-text-secondary mb-8">
          {t.home.ctaSubtitle}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href={`${prefix}/tools/jpg-to-png`} size="xl" class="cta-glow">
            {t.home.startConvertingFree}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </Button>
          <Button href={`${prefix}/tools`} variant="secondary" size="xl">
            {t.home.browseAllTools}
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>