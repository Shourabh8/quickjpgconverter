---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "de" as const;
const prefix = getLocalePrefix(locale);

const breadcrumbs = [
  { name: "Werkzeuge", url: `${prefix}/tools` },
  { name: "JPG nach PNG", url: `${prefix}/tools/jpg-to-png` },
];

const conversionOptions = [
  { id: "quality-high", label: "Hohe Qualität", desc: "Beste visuelle Treue, größere Datei", checked: true },
  { id: "quality-balanced", desc: "Gutes Gleichgewicht zwischen Größe und Qualität", label: "Ausgewogen", checked: false },
  { id: "quality-small", label: "Minimale Größe", desc: "Kleinere Datei, leichter Qualitätsverlust", checked: false },
];

const faqItems = [
  {
    question: "Was ist der Unterschied zwischen JPG und PNG?",
    answer: "JPG verwendet verlustbehaftete Komprimierung, bei der Bilddaten gelöscht werden, um kleinere Dateien zu erzielen. PNG verwendet verlustfreie Komprimierung und bewahrt jedes Pixel. PNG unterstützt zudem transparente Hintergründe, was JPG nicht kann.",
  },
  {
    question: "Verbessert die Konvertierung von JPG nach PNG die Qualität?",
    answer: "Die Konvertierung von JPG nach PNG stellt die während der ursprünglichen JPG-Komprimierung verlorenen Daten nicht wieder her. Sie verhindert jedoch weiteren Qualitätsverlust bei Bearbeitung und Weitergabe. PNG ist ideal, wenn Sie die aktuelle Qualität bewahren möchten.",
  },
  {
    question: "Warum ist die PNG-Datei größer als die JPG-Datei?",
    answer: "PNG verwendet verlustfreie Komprimierung, die alle Bilddaten beibehält. Dies führt zu größeren Dateien, aber mit perfekter Qualität. JPG erzielt kleinere Größen, indem einige visuelle Daten gelöscht werden, die das menschliche Auge möglicherweise nicht wahrnimmt.",
  },
  {
    question: "Kann ich mehrere JPG-Dateien auf einmal konvertieren?",
    answer: "Ja. Sie können mehrere JPG-Dateien per Drag-and-Drop ablegen oder auswählen. Alle werden gleichzeitig nach PNG konvertiert, und Sie können sie einzeln oder als Stapel herunterladen.",
  },
  {
    question: "Was ist der beste kostenlose JPG-zu-PNG-Konverter?",
    answer: "Quick JPG Converter ist einer der besten kostenlosen JPG-zu-PNG-Konverter. Er läuft vollständig in Ihrem Browser, bewahrt die verlustfreie Qualität, unterstützt Stapelkonvertierung und erfordert keine Registrierung oder Uploads.",
  },
];

const steps = [
  { title: "Laden Sie Ihre JPGs hoch", desc: "Ziehen Sie Ihre Bilder per Drag-and-Drop ab oder klicken Sie zum Auswählen." },
  { title: "Sofort konvertieren", desc: "Ihr Bild wird im Browser konvertiert. Keine Server-Uploads." },
  { title: "PNG herunterladen", desc: "Erhalten Sie Ihre hochwertige PNG-Datei sofort." },
];

const relatedTools = [
  { slug: "png-to-jpg", title: "PNG nach JPG", desc: "Konvertieren Sie PNG-Bilder in JPG-Format." },
  { slug: "jpg-to-webp", title: "JPG nach WebP", desc: "Konvertieren Sie JPG in das moderne WebP-Format." },
  { slug: "webp-to-jpg", title: "WebP nach JPG", desc: "Konvertieren Sie WebP-Bilder in JPG." },
  { slug: "heic-to-jpg", title: "HEIC nach JPG", desc: "Konvertieren Sie iPhone HEIC-Fotos in JPG." },
  { slug: "image-compressor", title: "Bildkompressor", desc: "Komprimieren Sie Bilder ohne Qualitätsverlust." },
  { slug: "resize-jpg", title: "JPG Größe ändern", desc: "Ändern Sie Bilder auf jede Größe." },
];
---

<BaseLayout
  title="Kostenloser JPG-zu-PNG-Konverter — Online-Konvertierungswerkzeug"
  description="Konvertieren Sie JPG sofort nach PNG mit unserem kostenlosen Online-JPG-Konverter. Verlustfreie Qualität, Transparenzunterstützung und 100% privat. Keine Uploads nötig — jetzt ausprobieren."
  canonical={`https://quickjpgconverter.com${prefix}/tools/jpg-to-png`}
  keywords={["jpg nach png", "jpg nach png konvertieren", "jpeg nach png"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  howToSteps={[
    { name: "JPG-Dateien hochladen", text: "Ziehen Sie Ihre JPG-Bilder per Drag-and-Drop ab oder klicken Sie zum Auswählen." },
    { name: "Qualität wählen", text: "Wählen Sie zwischen Hohe Qualität, Ausgewogen oder Minimale Größe." },
    { name: "Konvertieren und herunterladen", text: "Klicken Sie auf Nach PNG konvertieren und laden Sie Ihre Dateien herunter." },
  ]}
  locale={locale}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Kostenlos · Keine Anmeldung · Privat
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          JPG-zu-PNG-<span class="gradient-text">Konverter</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Konvertieren Sie Ihre JPG-Bilder nach PNG mit verlustfreier Qualität und Transparenzunterstützung.
          Alles läuft in Ihrem Browser.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Konvertieren nach:</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm">PNG</button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div
                  id="drop-area"
                  class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group"
                >
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Ziehen Sie Ihre JPG-Dateien hierher</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">oder klicken Sie zum Auswählen von Ihrem Computer</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Dateien auswählen
                    <input type="file" class="sr-only" accept=".jpg,.jpeg" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, JPEG · Max 50MB pro Datei · Mehrere Dateien unterstützt</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Zum Hochladen ablegen</p>
                  </div>
                </div>
              </div>

              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 Dateien bereit</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Alles löschen</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Eingabe: JPG</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Ausgabe: PNG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Konvertierungsoptionen</h3>
                <div class="space-y-2">
                  {conversionOptions.map((opt) => (
                    <label class:list={[
                      "flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200",
                      opt.checked
                        ? "border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30"
                        : "border-border-default hover:border-border-strong hover:bg-surface-subtle/50"
                    ]}>
                      <input type="radio" name="quality" value={opt.id} checked={opt.checked} class="mt-0.5 w-4 h-4 text-brand-600 border-border-strong focus:ring-brand-500 focus:ring-offset-0" />
                      <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-text-primary">{opt.label}</div>
                        <div class="text-xs text-text-tertiary mt-0.5">{opt.desc}</div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <div class="h-px bg-border-default mb-6"></div>

              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Ausgabeformat</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">PNG</div>
                      <div class="text-xs text-text-tertiary">Verlustfrei · Transparenz · ~3-5× größer</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="flex-1"></div>

              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Konvertierung...</p>
              </div>

              <div id="convert-btn-area">
                <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Nach PNG konvertieren
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Laden Sie eine Datei hoch, um die Konvertierung zu starten</p>
              </div>

              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Unterstützt:</span>
          {["JPG", "JPEG"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Max 50MB</span>
          <span class="text-text-tertiary">·</span>
          <span>Mehrere Dateien</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="JPG nach PNG" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">So funktioniert es</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Drei Schritte</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {steps.map((step, i) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">0{i + 1}</div>
            <h3 class="text-base font-semibold text-text-primary mb-1.5">{step.title}</h3>
            <p class="text-sm text-text-secondary">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Warum JPG nach PNG konvertieren?</h2>
        <p>PNG (Portable Network Graphics) ist das ideale Format, wenn Sie verlustfreie Komprimierung oder transparente Hintergründe benötigen. Im Gegensatz zu JPG bewahrt PNG jedes Pixel Ihres Bildes ohne Kompressionsartefakte.</p>
        <h3>Wann PNG statt JPG verwenden</h3>
        <ul>
          <li><strong>Logos und Symbole</strong> — benötigen scharfe Kanten und transparente Hintergründe</li>
          <li><strong>Bildschirmfotos</strong> — Text und Benutzeroberflächenelemente bleiben in jeder Größe scharf</li>
          <li><strong>Grafiken mit soliden Farben</strong> — keine Kompressionsartefakte in flachen Bereichen</li>
          <li><strong>Bilder, die mehrfach bearbeitet werden</strong> — kein generationeller Qualitätsverlust</li>
          <li><strong>Druckfertige Ressourcen</strong> — verlustfreie Qualität für professionelle Ausgabe</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Häufig gestellte Fragen</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Verwandte Werkzeuge</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Testen Sie unsere anderen Konverter</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {relatedTools.map((tool) => (
          <a href={`${prefix}/tools/${tool.slug}`} class="card-hover p-5 group">
            <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{tool.title}</h3>
            <p class="text-sm text-text-secondary">{tool.desc}</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <script>
    import { initConverter } from "@scripts/converter.js";
    document.addEventListener("DOMContentLoaded", () => initConverter({ targetFormat: "png", targetExt: "png", targetMime: "image/png" }));
  </script>
</BaseLayout>