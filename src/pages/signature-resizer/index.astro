---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import MonetizationBanner from "@components/ui/MonetizationBanner.astro";
import RelatedTools from "@components/tool/RelatedTools.astro";

const breadcrumbs = [
  { name: "Tools", url: "/tools/" },
  { name: "Signature Resizer", url: "/signature-resizer/" },
];

const howToSteps = [
  {
    name: "Upload Signature Photo",
    text: "Take a photo of your signature on white paper using your phone or scanner, and upload it here.",
  },
  {
    name: "Select Exam / Portal Preset",
    text: "Choose your target portal (UPSC, SSC, Banking IBPS/SBI, NTA NEET/JEE, GATE) or specify custom dimensions and KB target.",
  },
  {
    name: "Whiten Paper & Compress",
    text: "The tool automatically cleans paper shadows, enhances pen ink, and compresses the image to between 10KB and 20KB. Click Download.",
  },
];

const faqItems = [
  {
    question: "What is the standard signature size for government online forms?",
    answer: "Most government exams (such as UPSC, SSC, IBPS, and State PSC) require signatures in JPG/JPEG format with dimensions between 140×60 pixels and 350×150 pixels, and a file size strictly between 10 KB and 20 KB (or 20 KB to 50 KB depending on the notification).",
  },
  {
    question: "Why do online portals reject signature uploads?",
    answer: "Signatures are most frequently rejected due to: (1) File size exceeding the 20KB limit, (2) File size smaller than the 10KB minimum threshold, (3) Dim paper background or phone shadows instead of pure white paper, and (4) Incorrect aspect ratio or format (e.g. uploading PNG instead of JPG).",
  },
  {
    question: "How does the paper whitening feature work?",
    answer: "Our built-in image processor removes yellowish phone shadows and desk lighting, converting the paper background to clean pure white (#ffffff) while darkening blue and black ink for maximum legibility.",
  },
  {
    question: "Is it safe to upload my signature here?",
    answer: "Yes, 100% safe. All cropping, resizing, contrast enhancement, and compression occur locally inside your browser via HTML5 Canvas. Your signature image is never sent to any server or stored online.",
  },
  {
    question: "Can I resize signatures on my mobile phone?",
    answer: "Yes. Quick JPG Converter works smoothly in all mobile browsers (Chrome, Safari, Firefox). You can snap a photo of your signature with your phone camera and resize it immediately.",
  },
];

const portalTable = [
  { portal: "UPSC Civil Services / NDA / CDS", dimensions: "3.5 cm × 1.5 cm (~350 × 150 px)", size: "10 KB – 20 KB", format: "JPG" },
  { portal: "SSC (CGL, CHSL, MTS, GD)", dimensions: "4.0 cm × 2.0 cm (~280 × 120 px)", size: "10 KB – 20 KB", format: "JPG" },
  { portal: "Banking (IBPS, SBI PO, Clerk, RBI)", dimensions: "140 × 60 pixels", size: "10 KB – 20 KB", format: "JPG" },
  { portal: "NTA (NEET, JEE Main, CUET)", dimensions: "3.5 cm × 1.5 cm", size: "4 KB – 30 KB", format: "JPG" },
  { portal: "GATE / JAM Examination", dimensions: "5.0 cm × 2.0 cm", size: "5 KB – 50 KB", format: "JPG" },
  { portal: "State PSC / Police / Teaching", dimensions: "Standard 7:3 aspect ratio", size: "10 KB – 50 KB", format: "JPG" },
];

const toolSchema = {
  name: "Signature Resizer & Compressor Online",
  description: "Free online signature resizing and compression tool for exam and job portals (UPSC, SSC, IBPS, Bank, NTA). Whitens background and compresses to 10KB-20KB.",
  url: "https://quickjpgconverter.com/signature-resizer/",
  featureList: [
    "Portal presets for UPSC, SSC, Banking IBPS, NTA, and GATE",
    "Automatic paper whitening to remove background phone shadows",
    "Pen ink contrast enhancer for crisp blue/black signatures",
    "Precise binary target compression strictly to 10KB-20KB",
    "100% private in-browser client-side execution",
  ],
};
---

<BaseLayout
  title="Signature Resizer & Compressor (10KB to 20KB) — Free Online Tool"
  description="Resize and compress signatures for UPSC, SSC, IBPS, Bank PO, and government exam forms. Crop, whiten paper background, and compress to 10KB-20KB instantly."
  canonical="https://quickjpgconverter.com/signature-resizer/"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  howToSteps={howToSteps}
  toolSchema={toolSchema}
  keywords={[
    "signature resizer",
    "signature compressor 10kb to 20kb",
    "resize signature online",
    "signature resizer 20kb",
    "upsc signature compressor",
    "ssc signature resize",
    "compress signature to 20kb",
    "signature size converter",
    "whiten signature background",
    "signature photo resizer",
  ]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <!-- Hero Section -->
  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
          </svg>
          Exam & Govt Portal Ready · 10KB–20KB
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Online <span class="gradient-text">Signature Resizer</span> & Compressor
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Resize and compress signature photos for UPSC, SSC, IBPS, NEET, and job portals. Clean paper shadows and compress to exact 10KB–20KB limits.
        </p>
      </div>
    </Container>
  </section>

  <!-- Interactive Tool -->
  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-4xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-xl overflow-hidden">
          
          <!-- Upload Area -->
          <div id="sig-upload-zone" class="p-6 sm:p-10">
            <div
              id="sig-drop-area"
              class="relative min-h-[260px] sm:min-h-[300px] rounded-2xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-8 transition-all duration-200 hover:border-brand-400 hover:bg-brand-50/20 cursor-pointer group"
            >
              <input id="sig-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/bmp" class="hidden" />
              <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 flex items-center justify-center text-brand-600 dark:text-brand-400 mb-4 group-hover:scale-105 transition-transform duration-200 shadow-sm">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-text-primary mb-1">Select or drop your signature photo</h3>
              <p class="text-sm text-text-secondary mb-4">Snap a photo on white paper with your phone or select an existing scan</p>
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm transition-colors shadow-sm">
                Choose Signature Photo
              </div>
              <p class="text-xs text-text-tertiary mt-4">🔒 100% In-Browser Privacy · Your signature never leaves your device</p>
            </div>
          </div>

          <!-- Interactive Workspace -->
          <div id="sig-workspace" class="hidden">
            <!-- Top bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-border-default bg-surface-muted">
              <span id="sig-image-info" class="text-xs sm:text-sm font-medium text-text-secondary truncate max-w-sm sm:max-w-md"></span>
              <button id="sig-reset-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium text-text-secondary hover:text-text-primary hover:bg-surface border border-border-default transition-colors">
                Upload Another
              </button>
            </div>

            <!-- Workspace Grid -->
            <div class="grid grid-cols-1 md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-border-default">
              
              <!-- Left Control Settings (5 cols) -->
              <div class="md:col-span-5 p-5 sm:p-6 space-y-5">
                
                <!-- Preset Selector -->
                <div>
                  <label for="sig-preset-select" class="block text-xs font-semibold uppercase tracking-wider text-text-tertiary mb-2">Target Exam / Portal</label>
                  <select id="sig-preset-select" class="w-full px-3 py-2 text-sm rounded-xl border border-border-default bg-surface text-text-primary font-medium focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">
                    <option value="upsc">UPSC Civil Services / NDA (10–20 KB)</option>
                    <option value="ssc">SSC CGL / CHSL / MTS (10–20 KB)</option>
                    <option value="ibps">Bank IBPS / SBI PO & Clerk (10–20 KB)</option>
                    <option value="nta">NTA NEET / JEE Main (4–30 KB)</option>
                    <option value="gate">GATE / IIT JAM (5–50 KB)</option>
                    <option value="custom">Custom Dimensions & Target Size</option>
                  </select>
                </div>

                <!-- Custom Dimensions (hidden by default) -->
                <div id="sig-custom-dimensions" class="hidden grid grid-cols-2 gap-3 p-3 rounded-xl bg-surface-subtle border border-border-default">
                  <div>
                    <label for="sig-width" class="block text-xs font-medium text-text-secondary mb-1">Width (px)</label>
                    <input id="sig-width" type="number" value="350" class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-border-default bg-surface text-text-primary" />
                  </div>
                  <div>
                    <label for="sig-height" class="block text-xs font-medium text-text-secondary mb-1">Height (px)</label>
                    <input id="sig-height" type="number" value="150" class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-border-default bg-surface text-text-primary" />
                  </div>
                </div>

                <!-- Target File Size -->
                <div>
                  <div class="flex justify-between text-xs text-text-secondary mb-1">
                    <span>Target File Size Limit</span>
                    <span id="sig-target-kb-val" class="font-mono font-semibold text-brand-600 dark:text-brand-400">20 KB</span>
                  </div>
                  <input id="sig-target-kb" type="range" min="10" max="100" step="5" value="20" class="w-full accent-brand-600 cursor-pointer" />
                  <p class="text-[11px] text-text-tertiary mt-1">UPSC & SSC reject files larger than 20 KB</p>
                </div>

                <!-- Paper Whitening & Contrast Enhancer -->
                <div class="border-t border-border-default pt-4 space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-text-tertiary">Background Clean</span>
                    <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-medium text-text-primary">
                      <input id="sig-white-clean" type="checkbox" checked class="rounded accent-brand-600 w-3.5 h-3.5" />
                      <span>Whiten Paper Background</span>
                    </label>
                  </div>
                  <p class="text-[11px] text-text-secondary">Converts phone shadows & gray paper to pure white while preserving crisp ink strokes.</p>

                  <div>
                    <div class="flex justify-between text-xs text-text-secondary mb-1">
                      <span>Ink Contrast Boost</span>
                      <span id="sig-contrast-val" class="font-mono">130</span>
                    </div>
                    <input id="sig-contrast" type="range" min="100" max="220" value="130" class="w-full accent-brand-600 cursor-pointer" />
                  </div>

                  <div>
                    <div class="flex justify-between text-xs text-text-secondary mb-1">
                      <span>Brightness Balance</span>
                      <span id="sig-brightness-val" class="font-mono">10</span>
                    </div>
                    <input id="sig-brightness" type="range" min="-30" max="40" value="10" class="w-full accent-brand-600 cursor-pointer" />
                  </div>
                </div>

              </div>

              <!-- Right Preview & Download Panel (7 cols) -->
              <div class="md:col-span-7 p-5 sm:p-6 flex flex-col justify-between bg-surface-subtle/40">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-semibold uppercase tracking-wider text-text-tertiary">Real-time Result</span>
                    <span id="sig-status-badge" class="text-xs"></span>
                  </div>

                  <!-- Canvas Display Box -->
                  <div class="p-6 rounded-xl border border-border-default bg-white flex items-center justify-center min-h-[160px] shadow-sm overflow-hidden">
                    <canvas id="sig-canvas" class="max-w-full max-h-[140px] object-contain shadow-xs border border-neutral-200"></canvas>
                  </div>

                  <!-- Specifications Readout -->
                  <div class="grid grid-cols-2 gap-3 mt-4">
                    <div class="p-3 rounded-xl border border-border-default bg-surface">
                      <div class="text-[11px] text-text-tertiary">Dimensions</div>
                      <div id="sig-output-dimensions" class="text-sm font-semibold font-mono text-text-primary mt-0.5">350 × 150 px</div>
                    </div>
                    <div class="p-3 rounded-xl border border-border-default bg-surface">
                      <div class="text-[11px] text-text-tertiary">Compressed Size</div>
                      <div id="sig-output-size" class="text-sm font-semibold font-mono text-brand-600 dark:text-brand-400 mt-0.5">14.2 KB</div>
                    </div>
                  </div>
                </div>

                <!-- Download Action -->
                <div class="mt-6 pt-4 border-t border-border-default">
                  <button
                    id="sig-download-btn"
                    type="button"
                    class="w-full py-3 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    Download Form-Compliant Signature (.JPG)
                  </button>
                  <p class="text-[11px] text-center text-text-tertiary mt-2">Guaranteed to upload without "File size exceeded" portal errors</p>
                </div>

              </div>

            </div>
          </div>

        </div>

        <!-- Monetization & Partner Banner -->
        <MonetizationBanner class="mt-6 mb-0" />
      </div>
    </Container>
  </section>

  <!-- Portal Dimension Requirements Table -->
  <section class="section border-t border-border-default/60 bg-surface-muted/30">
    <Container variant="narrow">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-2">
          Official Signature Requirements (2026 Guidelines)
        </h2>
        <p class="text-sm text-text-secondary">
          Common competitive examinations and portal dimension standards across India and global portals.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-border-default bg-surface shadow-xs">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-surface-subtle border-b border-border-default text-text-primary font-semibold">
            <tr>
              <th class="p-3.5 sm:p-4">Examination / Portal</th>
              <th class="p-3.5 sm:p-4">Required Dimensions</th>
              <th class="p-3.5 sm:p-4">File Size (KB)</th>
              <th class="p-3.5 sm:p-4">Format</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-default text-text-secondary">
            {portalTable.map((row) => (
              <tr class="hover:bg-surface-subtle/50 transition-colors">
                <td class="p-3.5 sm:p-4 font-medium text-text-primary">{row.portal}</td>
                <td class="p-3.5 sm:p-4 font-mono">{row.dimensions}</td>
                <td class="p-3.5 sm:p-4 font-mono text-brand-600 dark:text-brand-400 font-semibold">{row.size}</td>
                <td class="p-3.5 sm:p-4">{row.format}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <!-- Deep SEO Prose & Explanations -->
  <section class="section border-t border-border-default/60">
    <Container variant="narrow">
      <div class="prose max-w-none text-text-secondary leading-relaxed space-y-6">
        <h2 class="text-2xl font-bold text-text-primary">How to Resize and Compress Signatures for Online Applications</h2>
        <p>
          Every year, hundreds of thousands of applicants fail to submit competitive examination forms on time because portal upload systems reject their signature files. Official portals like UPSC, SSC, IBPS, and State PSC enforce strict automated server validations: if an uploaded JPG is 20.2 KB instead of 20.0 KB, or if the width-to-height ratio is distorted, the submission fails with generic errors like <em>"Invalid image format or file size outside prescribed range."</em>
        </p>

        <h3 class="text-xl font-bold text-text-primary mt-6">Solving the Common Signature Issues</h3>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Phone Camera Shadows:</strong> When taking a photo of a piece of paper on a desk, the phone casts a gray or yellow shadow over the paper. Our automated <em>Paper Whitening filter</em> removes this gray cast, restoring a clean pure white background required by UIDAI and examination boards.</li>
          <li><strong>Faint or Low-Contrast Pen Ink:</strong> Ballpoint pens often appear light gray or grainy under low indoor lighting. The <em>Ink Contrast Boost</em> sharpens and darkens the stroke pixels so your signature stands out crisply.</li>
          <li><strong>Strict 10KB to 20KB Boundaries:</strong> Standard image compressors only reduce size arbitrarily. Our engine uses dynamic binary compression to guarantee the resulting JPEG file lands securely inside the required 10KB–20KB window.</li>
        </ul>

        <h3 class="text-xl font-bold text-text-primary mt-6">Related Application Form Utilities</h3>
        <p>
          Pair your form-compliant signature with our other official application tools:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose mt-4">
          <a href="/upsc-photo-compressor/" class="p-4 rounded-xl border border-border-default bg-surface hover:border-brand-500 transition-colors">
            <div class="font-semibold text-text-primary text-sm">UPSC Photo Compressor</div>
            <div class="text-xs text-text-secondary mt-1">Resize candidate photos to 3.5cm × 4.5cm under 100KB.</div>
          </a>
          <a href="/compress-image-to-20kb/" class="p-4 rounded-xl border border-border-default bg-surface hover:border-brand-500 transition-colors">
            <div class="font-semibold text-text-primary text-sm">Compress Image to 20KB</div>
            <div class="text-xs text-text-secondary mt-1">Direct single-file compressor to under 20KB for SSC and bank forms.</div>
          </a>
          <a href="/aadhar-photo-resize/" class="p-4 rounded-xl border border-border-default bg-surface hover:border-brand-500 transition-colors">
            <div class="font-semibold text-text-primary text-sm">Aadhaar Photo Resize</div>
            <div class="text-xs text-text-secondary mt-1">Resize photos for UIDAI Aadhaar update portals.</div>
          </a>
          <a href="/compress-for-govt-form/" class="p-4 rounded-xl border border-border-default bg-surface hover:border-brand-500 transition-colors">
            <div class="font-semibold text-text-primary text-sm">Compress for Govt Form</div>
            <div class="text-xs text-text-secondary mt-1">Multi-portal preset compressor for SSC, UPSC, and Railways.</div>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- FAQ Section -->
  <section class="section border-t border-border-default/60 bg-surface-muted/30">
    <Container variant="narrow">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-2">Frequently Asked Questions</h2>
        <p class="text-sm text-text-secondary">Answers to common signature resizing and upload issues.</p>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <!-- Related Tools Internal Linking Grid -->
  <RelatedTools
    currentSlug="signature-resizer"
    customSlugs={["passport-photo-size", "compress-image-to-20kb", "upsc-photo-compressor"]}
    title="Official Portal Tools"
    subtitle="Complementary utilities for passport, exam, and government portal applications."
  />
</BaseLayout>

<script>
  import { initSignatureResizer } from "@scripts/signature-resizer.js";
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSignatureResizer);
  } else {
    initSignatureResizer();
  }
</script>
