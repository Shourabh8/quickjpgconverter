---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import { site } from "@data/site";

const currentYear = new Date().getFullYear();
---

<BaseLayout
  title="Page Not Found — Quick JPG Converter"
  description="The page you're looking for doesn't exist. Use our free image converter tools or find what you need from our homepage."
  canonical="https://quickjpgconverter.com/404"
  noindex={true}
>
  <section class="flex-1 flex items-center justify-center py-16 sm:py-24">
    <Container>
      <div class="text-center max-w-lg mx-auto">
        <!-- 404 Icon -->
        <div class="w-24 h-24 mx-auto mb-8 rounded-3xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50">
          <svg class="w-12 h-12 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" role="img" aria-label="Page not found">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>

        <!-- Error Code -->
        <h1 class="text-8xl font-bold text-text-primary mb-4 tracking-tighter">404</h1>
        
        <!-- Message -->
        <h2 class="text-2xl font-semibold text-text-primary mb-3">Page not found</h2>
        <p class="text-text-secondary mb-8 leading-relaxed">
          The page you're looking for doesn't exist or has been moved. 
          Try one of our free image conversion tools instead.
        </p>

        <!-- Quick Links -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/" class="btn-primary">
            Go to Homepage
          </a>
          <a href="/tools" class="btn-secondary">
            Browse All Tools
          </a>
        </div>

        <!-- Popular Tools -->
        <div class="mt-12 pt-8 border-t border-border-default">
          <p class="text-sm text-text-tertiary mb-4">Popular tools:</p>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a href="/jpg-to-png" class="px-3 py-1.5 rounded-lg text-sm text-text-secondary hover:text-text-primary bg-surface-muted hover:bg-surface-subtle transition-colors">
              JPG → PNG
            </a>
            <a href="/png-to-jpg" class="px-3 py-1.5 rounded-lg text-sm text-text-secondary hover:text-text-primary bg-surface-muted hover:bg-surface-subtle transition-colors">
              PNG → JPG
            </a>
            <a href="/jpg-to-webp" class="px-3 py-1.5 rounded-lg text-sm text-text-secondary hover:text-text-primary bg-surface-muted hover:bg-surface-subtle transition-colors">
              JPG → WebP
            </a>
            <a href="/image-compressor" class="px-3 py-1.5 rounded-lg text-sm text-text-secondary hover:text-text-primary bg-surface-muted hover:bg-surface-subtle transition-colors">
              Image Compressor
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
