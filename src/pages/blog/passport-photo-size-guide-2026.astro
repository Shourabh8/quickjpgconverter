---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Blog", url: "/blog" },
  { name: "Passport Photo Size Guide 2026", url: "/blog/passport-photo-size-guide-2026" },
];

const tableOfContents = [
  { id: "standard-sizes", title: "Standard Passport Photo Sizes" },
  { id: "india-specific", title: "India-Specific Requirements" },
  { id: "usa-requirements", title: "USA Passport Photo Requirements" },
  { id: "file-size", title: "File Size Requirements" },
  { id: "how-to-create", title: "How to Create Passport Photos" },
  { id: "common-mistakes", title: "Common Mistakes to Avoid" },
  { id: "faq", title: "FAQ" },
];
---

<BaseLayout
  title="Passport Photo Size Guide 2026 — All Countries & Requirements"
  description="Complete passport photo size guide for 2026. Standard dimensions for India, USA, UK, Canada, Australia. File size, background color, and format requirements."
  canonical="https://quickjpgconverter.com/blog/passport-photo-size-guide-2026"
  breadcrumbs={breadcrumbs}
  keywords={[
    "passport photo size",
    "passport photo size 2026",
    "passport photo size india",
    "passport photo size usa",
    "passport photo size uk",
    "passport photo requirements",
    "passport photo background",
    "passport size photo online",
    "passport photo maker",
  ]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container variant="narrow">
      <div class="mb-6">
        <Badge class="mb-4">Updated June 2026</Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Passport Photo Size Guide 2026 — All Countries & Requirements
        </h1>
        <p class="text-base sm:text-lg text-text-secondary">
          Everything you need to know about passport photo sizes, dimensions, file requirements, and how to create the perfect passport photo online.
        </p>
      </div>

      <div class="flex items-center gap-4 py-4 border-y border-border-default">
        <div class="w-10 h-10 rounded-full bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center text-sm font-bold text-brand-700 dark:text-brand-300">
          QJ
        </div>
        <div>
          <p class="text-sm font-medium text-text-primary">Quick JPG Converter Team</p>
          <p class="text-xs text-text-tertiary">5 min read · Updated June 11, 2026</p>
        </div>
      </div>
    </Container>
  </section>

  <article class="pb-12 sm:pb-16">
    <Container variant="narrow">
      <div class="prose">
        <h2 id="standard-sizes">Standard Passport Photo Sizes</h2>
        <p>
          Passport photo requirements vary by country, but there are some common standards. The most
          widely used size globally is <strong>35mm × 45mm</strong>, used by India, UK, most European
          countries, Australia, and many others.
        </p>

        <div class="not-prose my-6 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-surface-muted border-b border-border-default">
                <th class="text-left px-4 py-3 font-medium text-text-secondary">Country</th>
                <th class="text-left px-4 py-3 font-medium text-text-secondary">Size (mm)</th>
                <th class="text-left px-4 py-3 font-medium text-text-secondary">Pixels (300 DPI)</th>
                <th class="text-left px-4 py-3 font-medium text-text-secondary">Background</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-border-muted">
                <td class="px-4 py-3 font-medium text-text-primary">India</td>
                <td class="px-4 py-3 text-text-secondary">35 × 45</td>
                <td class="px-4 py-3 text-text-secondary">413 × 531</td>
                <td class="px-4 py-3 text-text-secondary">White</td>
              </tr>
              <tr class="border-b border-border-muted">
                <td class="px-4 py-3 font-medium text-text-primary">USA</td>
                <td class="px-4 py-3 text-text-secondary">51 × 51 (2×2 in)</td>
                <td class="px-4 py-3 text-text-secondary">600 × 600</td>
                <td class="px-4 py-3 text-text-secondary">White</td>
              </tr>
              <tr class="border-b border-border-muted">
                <td class="px-4 py-3 font-medium text-text-primary">UK</td>
                <td class="px-4 py-3 text-text-secondary">35 × 45</td>
                <td class="px-4 py-3 text-text-secondary">413 × 531</td>
                <td class="px-4 py-3 text-text-secondary">Grey/White</td>
              </tr>
              <tr class="border-b border-border-muted">
                <td class="px-4 py-3 font-medium text-text-primary">Canada</td>
                <td class="px-4 py-3 text-text-secondary">50 × 70</td>
                <td class="px-4 py-3 text-text-secondary">591 × 827</td>
                <td class="px-4 py-3 text-text-secondary">White</td>
              </tr>
              <tr class="border-b border-border-muted">
                <td class="px-4 py-3 font-medium text-text-primary">Australia</td>
                <td class="px-4 py-3 text-text-secondary">35 × 45</td>
                <td class="px-4 py-3 text-text-secondary">413 × 531</td>
                <td class="px-4 py-3 text-text-secondary">White</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-text-primary">Germany</td>
                <td class="px-4 py-3 text-text-secondary">35 × 45</td>
                <td class="px-4 py-3 text-text-secondary">413 × 531</td>
                <td class="px-4 py-3 text-text-secondary">White</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="india-specific">India-Specific Requirements</h2>
        <p>
          Indian passport photos have strict requirements. Here's what you need to know:
        </p>
        <ul>
          <li><strong>Size:</strong> 35mm × 45mm (3.5cm × 4.5cm)</li>
          <li><strong>Pixels:</strong> 413 × 531 at 300 DPI</li>
          <li><strong>File Size:</strong> 10KB to 50KB (JPG format)</li>
          <li><strong>Background:</strong> Plain white</li>
          <li><strong>Expression:</strong> Neutral, mouth closed</li>
          <li><strong>Eyes:</strong> Open, looking directly at camera</li>
          <li><strong>Glasses:</strong> Not recommended (remove if possible)</li>
          <li><strong>Headwear:</strong> Not allowed (except religious reasons)</li>
        </ul>

        <h3>Indian Government Forms Photo Requirements</h3>
        <ul>
          <li><strong>SSC CGL/CHSL:</strong> 20-50KB, JPG, 3.5cm × 4.5cm</li>
          <li><strong>UPSC Civil Services:</strong> 20-50KB, JPG, 3.5cm × 4.5cm</li>
          <li><strong>Aadhar Card:</strong> Up to 300KB, JPG, 3.5cm × 2.5cm</li>
          <li><strong>PAN Card:</strong> Up to 200KB, JPG, 3.5cm × 2.5cm</li>
          <li><strong>Bank Account:</strong> 20-50KB, JPG, 3.5cm × 2.5cm</li>
        </ul>

        <h2 id="usa-requirements">USA Passport Photo Requirements</h2>
        <p>
          US passport photos have different requirements than most other countries:
        </p>
        <ul>
          <li><strong>Size:</strong> 2 inches × 2 inches (51mm × 51mm)</li>
          <li><strong>Pixels:</strong> 600 × 600 at 300 DPI</li>
          <li><strong>File Size:</strong> Up to 600KB</li>
          <li><strong>Format:</strong> JPEG</li>
          <li><strong>Background:</strong> Plain white or off-white</li>
          <li><strong>Head position:</strong> Centered, facing camera</li>
          <li><strong>Expression:</strong> Neutral or natural smile</li>
          <li><strong>Lighting:</strong> Even, no shadows</li>
        </ul>

        <h2 id="file-size">File Size Requirements</h2>
        <p>
          File size requirements vary significantly by country and application type:
        </p>
        <ul>
          <li><strong>India:</strong> 10-50KB for passport, 20-100KB for government forms</li>
          <li><strong>USA:</strong> Up to 600KB for passport applications</li>
          <li><strong>UK:</strong> Up to 10MB for online applications</li>
          <li><strong>Canada:</strong> Up to 4MB for online applications</li>
          <li><strong>Australia:</strong> Up to 2MB for online applications</li>
        </ul>

        <h2 id="how-to-create">How to Create Passport Photos Online</h2>
        <p>
          Creating a passport photo is easy with our <a href="/tools/passport-photo-size" class="text-brand-600 dark:text-brand-400 hover:underline">free online tool</a>:
        </p>
        <ol>
          <li><strong>Take a photo:</strong> Use natural lighting, white background, face the camera directly.</li>
          <li><strong>Upload to our tool:</strong> Visit <a href="/passport-photo-size">our passport photo tool</a>.</li>
          <li><strong>Select country:</strong> Choose your country to get the correct dimensions.</li>
          <li><strong>Adjust size:</strong> Select the target file size (20KB, 50KB, or 100KB).</li>
          <li><strong>Download:</strong> Get your passport-ready photo instantly.</li>
        </ol>

        <h2 id="common-mistakes">Common Mistakes to Avoid</h2>
        <ul>
          <li><strong>Wrong background:</strong> Use plain white, not colored or patterned.</li>
          <li><strong>Wrong size:</strong> Check your country's specific requirements.</li>
          <li><strong>Shadows:</strong> Use even lighting, avoid harsh shadows.</li>
          <li><strong>Glasses:</strong> Remove if possible, or ensure no glare.</li>
          <li><strong>Old photo:</strong> Use a photo taken within the last 6 months.</li>
          <li><strong>Filters:</strong> Don't use any filters or effects.</li>
          <li><strong>Wrong expression:</strong> Keep a neutral expression, mouth closed.</li>
        </ul>

        <h2 id="faq">Frequently Asked Questions</h2>

        <h3>What is the standard passport photo size?</h3>
        <p>
          The standard passport photo size is 35mm × 45mm for most countries (India, UK, EU, Australia).
          The USA uses 2 inches × 2 inches (51mm × 51mm).
        </p>

        <h3>What file size should my passport photo be?</h3>
        <p>
          For Indian passport applications: 10-50KB. For US passport applications: up to 600KB.
          For government forms: 20-100KB. Always check the specific requirements for your application.
        </p>

        <h3>What background color is required?</h3>
        <p>
          Most countries require a plain white background. Some countries accept light grey or off-white.
          Avoid colored backgrounds, patterns, or gradients.
        </p>

        <h3>Can I use a selfie for my passport photo?</h3>
        <p>
          It's not recommended. Selfies often have distortion due to the close camera distance.
          Use a tripod or ask someone to take your photo from 1-2 meters away.
        </p>

        <h3>How do I resize my photo for passport application?</h3>
        <p>
          Use our free <a href="/passport-photo-size">passport photo tool</a>. Upload your photo,
          select your country, and the tool will automatically resize it to the correct dimensions.
        </p>
      </div>
    </Container>
  </article>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Create Your Passport Photo Now</h2>
        <p class="text-text-secondary max-w-xl mx-auto">Free online tool to resize, crop, and compress passport photos.</p>
      </div>
      <div class="flex justify-center">
        <a href="/passport-photo-size" class="btn-primary btn-lg">
          Open Passport Photo Tool
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
