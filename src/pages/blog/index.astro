---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { blogPosts } from "@data/blog";

const breadcrumbs = [{ name: "Blog", url: "/blog" }];
---

<BaseLayout
  title="Blog — Quick JPG Converter"
  description="Tips, guides, and news about image conversion, JPG converter tools, and web optimization."
  canonical="https://quickjpgconverter.com/blog"
  breadcrumbs={breadcrumbs}
  keywords={["image conversion tips", "jpg converter guide", "image compression tutorial", "online image tools"]}
>
  <section class="section">
    <Container>
      <Breadcrumb items={breadcrumbs} />

      <div class="text-center mb-12 mt-8">
        <Badge class="mb-4">Blog</Badge>
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight mb-4">
          Image Conversion Guides & Tips
        </h1>
        <p class="text-text-secondary max-w-2xl mx-auto">
          Learn how to convert, compress, and optimize your images with our step-by-step guides.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {blogPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="card-hover p-6 group">
            <div class="flex items-center gap-2 mb-3">
              <Badge>{post.category}</Badge>
              <span class="text-xs text-text-tertiary">{post.readTime}</span>
            </div>
            <h2 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2">
              {post.title}
            </h2>
            <p class="text-sm text-text-secondary line-clamp-3">
              {post.description}
            </p>
            <div class="mt-4 text-sm font-medium text-brand-600 dark:text-brand-400 flex items-center gap-1">
              Read more
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
