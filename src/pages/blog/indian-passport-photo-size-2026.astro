---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";

const breadcrumbs = [
  { name: "Blog", url: "/blog" },
  { name: "Indian Passport Photo Size", url: "/blog/indian-passport-photo-size-2026" },
];

const publishDate = "June 11, 2026";
---

<BaseLayout
  title="Indian Passport Photo Size 2026: Complete Guide (630×810 Pixels)"
  description="Everything you need to know about Indian passport photo size in 2026 — dimensions, file size, background, and how to prepare your photo online."
  canonical="https://quickjpgconverter.com/blog/indian-passport-photo-size-2026"
  breadcrumbs={breadcrumbs}
  keywords={["indian passport photo size", "passport photo size 2026", "630x810 passport photo", "passport seva photo requirements", "india passport photo dimensions", "passport photo size in pixels", "passport seva 2.0 photo", "indian passport photo background"]}
  articleSchema={{
    headline: "Indian Passport Photo Size 2026: Complete Guide (630×810 Pixels)",
    datePublished: "2026-06-11",
  }}
  faqItems={[
    {
      question: "What is the new Indian passport photo size in 2026?",
      answer: "Since September 2025, India uses the ICAO biometric standard. The required dimensions are 630×810 pixels (35×45 mm) in JPEG format, under 250 KB for domestic applications.",
    },
    {
      question: "Can I use a square 2×2 inch photo for passport?",
      answer: "No. The old 2×2 inch square format is no longer accepted for passport applications. You must use the rectangular 630×810 pixel format. The 2×2 inch format is now only used for OCI cards and e-Visa applications.",
    },
    {
      question: "What file size should my passport photo be?",
      answer: "For domestic Passport Seva applications, keep it under 250 KB. For applications abroad (consulate/VFS/BLS), keep it between 20 KB and 100 KB. We recommend aiming for 20-100 KB for safety.",
    },
  ]}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          Passport Photo Guide
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Indian Passport Photo Size <span class="gradient-text">2026</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Everything you need to know about Indian passport photo size — dimensions, file size, background, and how to prepare your photo online.
        </p>
        <p class="text-sm text-text-tertiary mt-3">Published {publishDate} · 7 min read</p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container variant="narrow">
      <div class="prose">
        <h2>What Changed in 2025-2026?</h2>
        <p>India switched to the <strong>ICAO biometric standard</strong> in September 2025. This means the old 2×2 inch square format is no longer accepted for passport applications. Instead, you need a <strong>35×45 mm rectangular photo</strong> (630×810 pixels).</p>

        <h2>Indian Passport Photo Specifications</h2>
        
        <h3>For Domestic Applications (Passport Seva Portal)</h3>
        <table>
          <thead>
            <tr>
              <th>Requirement</th>
              <th>Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Photo size (print)</td>
              <td>35 × 45 mm</td>
            </tr>
            <tr>
              <td>Pixel dimensions</td>
              <td><strong>630 × 810 pixels</strong></td>
            </tr>
            <tr>
              <td>Aspect ratio</td>
              <td>7:9 (rectangular)</td>
            </tr>
            <tr>
              <td>File format</td>
              <td>JPEG (.jpg) only</td>
            </tr>
            <tr>
              <td>File size</td>
              <td>Under 250 KB (aim for 20-100 KB)</td>
            </tr>
            <tr>
              <td>Background</td>
              <td>Plain white</td>
            </tr>
            <tr>
              <td>Face coverage</td>
              <td>80-85% of frame</td>
            </tr>
            <tr>
              <td>Photo age</td>
              <td>Taken within last 6 months</td>
            </tr>
          </tbody>
        </table>

        <h3>For Abroad Applications (Consulate/VFS/BLS)</h3>
        <table>
          <thead>
            <tr>
              <th>Requirement</th>
              <th>Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Photo size (print)</td>
              <td>51 × 51 mm (2 × 2 inches)</td>
            </tr>
            <tr>
              <td>File format</td>
              <td>JPEG</td>
            </tr>
            <tr>
              <td>File size</td>
              <td>20 KB – 100 KB</td>
            </tr>
          </tbody>
        </table>

        <h2>How to Prepare Your Passport Photo Online</h2>
        
        <h3>Step 1: Take a Good Photo</h3>
        <ul>
          <li>Use your phone's rear camera</li>
          <li>Stand near a window for natural lighting</li>
          <li>Use a plain white background</li>
          <li>Remove glasses (Passport Seva 2.0 rejects glasses)</li>
          <li>Keep a neutral expression, mouth closed</li>
        </ul>

        <h3>Step 2: Convert iPhone HEIC to JPG</h3>
        <p>If you have an iPhone, your photos are saved as HEIC by default. Passport Seva requires JPEG. Use our free converter:</p>
        <p><a href="/tools/heic-to-jpg">Convert HEIC to JPG →</a></p>

        <h3>Step 3: Resize to 630×810 Pixels</h3>
        <p>Use our resize tool to get the exact dimensions required:</p>
        <p><a href="/tools/resize-jpg">Resize to 630×810 →</a></p>

        <h3>Step 4: Compress to Under 250KB</h3>
        <p>Make sure your photo is under 250KB (aim for 20-100KB for safety):</p>
        <p><a href="/tools/compress-to-100kb">Compress to 100KB →</a></p>

        <h3>Step 5: Remove Background (Optional)</h3>
        <p>If your background isn't perfectly white, use our AI background remover:</p>
        <p><a href="/tools/remove-background">Remove Background →</a></p>

        <h2>Common Mistakes to Avoid</h2>
        <ol>
          <li><strong>Wrong dimensions</strong> — Using 51×51mm (square) instead of 630×810 (rectangular)</li>
          <li><strong>File too large</strong> — Smartphone photos are 3-8MB, portal max is 250KB</li>
          <li><strong>Wrong format</strong> — PNG or HEIC will be rejected, must be JPEG</li>
          <li><strong>Non-white background</strong> — Indoor lighting makes white walls appear cream</li>
          <li><strong>Wearing glasses</strong> — Passport Seva 2.0 AI rejects all photos with glasses</li>
          <li><strong>Digital editing</strong> — Beauty filters and AI skin smoothing are prohibited</li>
        </ol>

        <h2>Passport Seva 2.0 AI Screening</h2>
        <p>The new Passport Seva 2.0 portal uses AI to automatically screen photos. It checks:</p>
        <ul>
          <li>Exact pixel dimensions (630×810)</li>
          <li>File size (under 250KB)</li>
          <li>Background color (must be white)</li>
          <li>Face coverage (80-85%)</li>
          <li>Glasses detection</li>
        </ul>
        <p>If your photo fails any check, it will be rejected instantly — there's no manual correction window.</p>

        <h2>Tools You'll Need</h2>
        <ul>
          <li><a href="/tools/heic-to-jpg">HEIC to JPG Converter</a> — For iPhone users</li>
          <li><a href="/tools/resize-jpg">Resize JPG</a> — To get 630×810 pixels</li>
          <li><a href="/tools/compress-to-100kb">Compress to 100KB</a> — To meet file size limits</li>
          <li><a href="/tools/remove-background">Background Remover</a> — For perfect white background</li>
          <li><a href="/tools/image-enhancer">Image Enhancer</a> — To adjust brightness/contrast</li>
        </ul>
      </div>

      <div class="mt-8 p-6 rounded-2xl bg-brand-50 dark:bg-brand-950/30 border border-brand-200 dark:border-brand-800 text-center">
        <h3 class="text-lg font-semibold text-text-primary mb-2">Prepare Your Passport Photo Now</h3>
        <p class="text-sm text-text-secondary mb-4">Use our free tools to resize, compress, and prepare your photo for Passport Seva 2.0.</p>
        <a href="/tools" class="btn-primary">View All Tools →</a>
      </div>
    </Container>
  </section>
</BaseLayout>
