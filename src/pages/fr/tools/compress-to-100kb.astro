---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import FeatureRequest from "@components/ui/FeatureRequest.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "fr" as const;
const prefix = getLocalePrefix(locale);

const breadcrumbs = [
  { name: "Outils", url: `${prefix}/tools` },
  { name: "Compresser à 100 Ko", url: `${prefix}/tools/compress-to-100kb` },
];

const faqItems = [
  {
    question: "Pourquoi ai-je besoin de comprimer une image à exactement 100 Ko ?",
    answer: "De nombreux portails en ligne, formulaires gouvernementaux et candidatures d'emploi exigent que les photos de passeport ou les scans de documents soient inférieurs à 100 Ko. Cet outil vous aide à respecter ces exigences strictes de taille de fichier tout en préservant la meilleure qualité possible.",
  },
  {
    question: "Mon image sera-t-elle floue après la compression ?",
    answer: "Notre compresseur utilise une réduction intelligente de la qualité pour atteindre la taille cible tout en préservant autant la qualité visuelle que possible. Le résultat est généralement excellent pour les photos et documents à 100 Ko.",
  },
  {
    question: "Quels formats d'image sont pris en charge ?",
    answer: "Nous acceptons les formats d'entrée JPG, PNG et WebP. La sortie est toujours en JPG pour garantir la taille de fichier la plus petite possible à la cible.",
  },
  {
    question: "Puis-je comprimer plusieurs images à la fois ?",
    answer: "Oui. Vous pouvez téléverser plusieurs images et les comprimer toutes à 100 Ko ou moins. Chaque image est traitée individuellement pour respecter la taille cible.",
  },
  {
    question: "Y a-t-il une limite de taille de fichier pour les téléversements ?",
    answer: "Vous pouvez téléverser des images jusqu'à 50 Mo. Le compresseur s'exécute entièrement dans votre navigateur, donc le temps de traitement dépend de votre appareil et du nombre d'images.",
  },
  {
    question: "Fonctionne-t-il sur mobile ?",
    answer: "Oui. Notre compresseur fonctionne sur tout appareil — iPhone, Android, tablette ou ordinateur. Pas besoin d'installer des applications. Ouvrez simplement l'outil dans votre navigateur et comprimez.",
  },
];

const steps = [
  { title: "Téléversez vos images", desc: "Glissez-déposez ou cliquez pour sélectionner vos photos." },
  { title: "Auto-compression", desc: "Notre algorithme réduit la qualité pour atteindre exactement 100 Ko." },
  { title: "Téléchargez le JPG", desc: "Obtenez votre image de 100 Ko instantanément, prête à être envoyée." },
];

const relatedTools = [
  { slug: "compress-to-200kb", title: "Compresser à 200 Ko", desc: "Compressez les images à moins de 200 Ko." },
  { slug: "image-enhancer", title: "Amélioreur d'image", desc: "Améliorez la luminosité, le contraste et la netteté." },
  { slug: "image-compressor", title: "Compresseur d'image", desc: "Compression personnalisée avec contrôle de la qualité." },
  { slug: "resize-jpg", title: "Redimensionner JPG", desc: "Redimensionnez les images à n'importe quelle dimension." },
  { slug: "jpg-to-png", title: "JPG en PNG", desc: "Convertissez JPG en PNG avec une qualité sans perte." },
  { slug: "jpg-to-webp", title: "JPG en WebP", desc: "Convertissez JPG au format moderne WebP." },
];
---

<BaseLayout
  title="Compresser une image à 100 Ko — Réducteur de photos gratuit en ligne"
  description="Compressez n'importe quelle image à moins de 100 Ko pour les photos de passeport, les formulaires et les téléversements de portails. Outil gratuit en ligne qui s'exécute dans votre navigateur — pas d'envoi, pas d'inscription."
  canonical={`https://quickjpgconverter.com${prefix}/tools/compress-to-100kb`}
  keywords={["compresser image à 100ko", "réduire image à 100ko", "compresseur d'image 100ko", "image à 100ko"]}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  locale={locale}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Gratuit · Sans inscription · Privé
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Compresser une image à <span class="gradient-text">100 Ko</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Parfait pour les photos de passeport, les formulaires et les téléversements de portails. Comprimez n'importe quelle image à moins de 100 Ko en préservant la qualité.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Taille cible :</span>
            <div class="flex items-center gap-2">
              <span id="target-size-display" class="px-3 py-1.5 rounded-lg text-sm font-bold bg-brand-600 text-white shadow-sm">100 Ko</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full min-h-[300px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Glissez vos images ici</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">ou cliquez pour sélectionner depuis votre ordinateur</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Sélectionner des fichiers
                    <input type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Max 50 Mo par fichier · Plusieurs fichiers supportés</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Déposez pour téléverser</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 fichiers prêts</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Tout effacer</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                  <div class="px-4 py-3 border-t border-border-default flex items-center justify-between text-xs">
                    <span class="text-text-tertiary">Cible : ≤ 100 Ko</span>
                    <span class="text-text-tertiary">→</span>
                    <span class="text-brand-600 dark:text-brand-400 font-medium">Sortie : JPG</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Taille de fichier cible</h3>
                <div class="p-4 rounded-xl border border-brand-300 dark:border-brand-700 bg-brand-50/50 dark:bg-brand-950/30">
                  <div class="text-center">
                    <div class="text-3xl font-bold text-brand-600 dark:text-brand-400 mb-1">100 Ko</div>
                    <p class="text-xs text-text-secondary">Idéal pour les photos de passeport et les formulaires</p>
                  </div>
                </div>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3">Format de sortie</h3>
                <div class="p-3 rounded-xl border border-border-default bg-surface-muted">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center">
                      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-text-primary">JPG</div>
                      <div class="text-xs text-text-tertiary">Avec perte · Universel · Fichiers plus petits</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-1"></div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compression en cours...</p>
              </div>
              <div id="compress-btn-area">
                <button id="compress-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  Compresser à 100 Ko
                </button>
                <p class="text-xs text-text-tertiary text-center mt-2">Téléversez des images pour lancer la compression</p>
              </div>
              <div id="download-area" class="hidden"></div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-text-tertiary">
          <span class="font-medium text-text-secondary">Supportés :</span>
          {["JPG", "PNG", "WebP"].map((fmt) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-surface-subtle border border-border-muted font-medium text-text-secondary">{fmt}</span>
          ))}
          <span class="text-text-tertiary">·</span>
          <span>Max 50 Mo</span>
          <span class="text-text-tertiary">·</span>
          <span>Plusieurs fichiers</span>
        </div>
      </div>
    </Container>
  </section>

  <FeatureRequest toolName="Compresser à 100 Ko" />

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Comment ça marche</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Trois Étapes</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {steps.map((step, i) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-bold text-sm flex items-center justify-center mx-auto mb-4 shadow-md shadow-brand-600/20">0{i + 1}</div>
            <h3 class="text-base font-semibold text-text-primary mb-1.5">{step.title}</h3>
            <p class="text-sm text-text-secondary">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="prose">
        <h2>Pourquoi compresser à 100 Ko ?</h2>
        <p>De nombreux portails en ligne, sites web gouvernementaux et candidatures d'emploi ont des limites strictes de taille de fichier. Les photos de passeport, pièces d'identité et scans de documents doivent souvent être inférieurs à 100 Ko. Notre compresseur réduit intelligemment la qualité pour respecter cette exigence tout en préservant la netteté visuelle maximale.</p>
        <h3>Cas d'utilisation courants</h3>
        <ul>
          <li>Téléversement de photos de passeport et de visa</li>
          <li>Envoi de formulaires sur des portails gouvernementaux</li>
          <li>Exigences de photo pour les candidatures d'emploi</li>
          <li>Formulaires d'admission universitaire</li>
          <li>Photos de profil sur les réseaux sociaux avec limites de taille</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Questions Fréquentes</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Outils Connexes</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Essayez nos autres convertisseurs</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {relatedTools.map((tool) => (
          <a href={`${prefix}/tools/${tool.slug}`} class="card-hover p-5 group">
            <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{tool.title}</h3>
            <p class="text-sm text-text-secondary">{tool.desc}</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    document.addEventListener("DOMContentLoaded", () => initTargetedCompressor({ targetSize: 100 * 1024 }));
  </script>
</BaseLayout>
