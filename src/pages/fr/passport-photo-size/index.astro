---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import FAQ from "@components/ui/FAQ.astro";
import Breadcrumb from "@components/seo/Breadcrumb.astro";
import { getLocalePrefix } from "@i18n/index";

const locale = "fr" as const;
const prefix = getLocalePrefix(locale);

const breadcrumbs = [
  { name: "Outils", url: `${prefix}/tools` },
  { name: "Photo passeport", url: `${prefix}/passport-photo-size` },
];

const faqItems = [
  {
    question: "Quelle est la taille standard d'une photo de passeport ?",
    answer: "La taille standard d'une photo de passeport est de 35 mm x 45 mm (3,5 cm x 4,5 cm) pour la plupart des pays, y compris l'Inde, les États-Unis, le Royaume-Uni et les pays de l'UE. En pixels, cela correspond à environ 413 x 531 pixels à 300 DPI.",
  },
  {
    question: "Quel est le poids d'une photo de passeport en Ko ?",
    answer: "La plupart des portails gouvernementaux exigent des photos de passeport entre 20 Ko et 100 Ko. Les demandes de passeport indien nécessitent généralement 10-50 Ko, tandis que les demandes de passeport américain autorisent jusqu'à 600 Ko.",
  },
  {
    question: "Quelle est la couleur d'arrière-plan d'une photo de passeport ?",
    answer: "La plupart des pays exigent un fond blanc ou blanc cassé. Certains pays comme l'Inde acceptent les fonds bleu clair pour certaines demandes.",
  },
  {
    question: "Comment redimensionner ma photo à la taille passeport ?",
    answer: "Utilisez notre outil gratuit en ligne ci-dessus. Il vous suffit de téléverser votre photo et elle sera automatiquement redimensionnée aux dimensions passeport correctes. Vous pouvez également la comprimer pour respecter les exigences de taille de fichier.",
  },
];

const passportSizes = [
  { country: "Inde", size: "35 mm × 45 mm", pixels: "413 × 531", kb: "10-50 Ko", bg: "Blanc" },
  { country: "États-Unis", size: "2in × 2in", pixels: "600 × 600", kb: "Jusqu'à 600 Ko", bg: "Blanc" },
  { country: "Royaume-Uni", size: "35 mm × 45 mm", pixels: "413 × 531", kb: "Jusqu'à 10 Mo", bg: "Blanc/Gris" },
  { country: "Canada", size: "50 mm × 70 mm", pixels: "591 × 827", kb: "Jusqu'à 4 Mo", bg: "Blanc" },
  { country: "Australie", size: "35 mm × 45 mm", pixels: "413 × 531", kb: "Jusqu'à 2 Mo", bg: "Blanc" },
  { country: "Allemagne", size: "35 mm × 45 mm", pixels: "413 × 531", kb: "Jusqu'à 10 Mo", bg: "Blanc" },
];

const indianUseCases = [
  { form: "Passeport indien", size: "35 mm × 45 mm", kb: "10-50 Ko", bg: "Blanc" },
  { form: "Carte PAN", size: "3,5 cm × 2,5 cm", kb: "Jusqu'à 200 Ko", bg: "Blanc" },
  { form: "Carte Aadhar", size: "3,5 cm × 2,5 cm", kb: "Jusqu'à 300 Ko", bg: "Blanc" },
  { form: "Examen SSC", size: "3,5 cm × 4,5 cm", kb: "20-50 Ko", bg: "Blanc" },
  { form: "Candidature UPSC", size: "3,5 cm × 4,5 cm", kb: "20-50 Ko", bg: "Blanc" },
  { form: "Compte bancaire", size: "3,5 cm × 2,5 cm", kb: "20-50 Ko", bg: "Blanc" },
  { form: "Fer (RRB)", size: "3,5 cm × 4,5 cm", kb: "20-50 Ko", bg: "Blanc" },
  { form: "Formulaires gouvernementaux", size: "3,5 cm × 4,5 cm", kb: "20-50 Ko", bg: "Blanc" },
];

const steps = [
  { title: "Téléversez votre photo", desc: "Cliquez sur la zone de téléversement et sélectionnez votre photo depuis votre appareil." },
  { title: "Sélectionnez la taille cible", desc: "Choisissez 20 Ko, 50 Ko ou 100 Ko selon les exigences de votre demande de passeport." },
  { title: "Téléchargez la photo passeport", desc: "Téléchargez votre photo prête à l'emploi au format JPG." },
];
---

<BaseLayout
  title="Taille photo passeport — Compresseur gratuit en ligne"
  description="Obtenez la bonne taille de photo passeport pour n'importe quel pays. Compresseur gratuit en ligne — redimensionnez, recadrez, compressez à 20 Ko–100 Ko. Inde, États-Unis, Royaume-Uni, Canada supportés."
  canonical={`https://quickjpgconverter.com${prefix}/passport-photo-size`}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  keywords={["taille photo passeport", "taille photo passeport en cm", "taille photo passeport en ko", "photo passeport indienne", "photo passeport usa", "photo passeport uk", "fond photo passeport", "photo taille passeport en ligne gratuit", "compresseur photo passeport", "redimensionner photo pour passeport", "créateur de photo passeport en ligne", "taille photo 35mm 45mm", "photo passeport 20ko", "photo passeport compresser", "télécharger photo passeport"]}
  howToSteps={[
    { name: "Téléversez votre photo", text: "Cliquez sur le bouton de téléversement et sélectionnez votre photo depuis votre appareil." },
    { name: "Sélectionnez la taille cible", text: "Choisissez 20 Ko, 50 Ko ou 100 Ko selon les exigences de votre demande de passeport." },
    { name: "Téléchargez la photo passeport", text: "Téléchargez votre photo passeport prête à l'emploi au format JPG." },
  ]}
  locale={locale}
>
  <Container class="py-5 sm:py-6">
    <Breadcrumb items={breadcrumbs} />
  </Container>

  <section class="pb-6 sm:pb-8">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <Badge class="mb-4">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
          </svg>
          Gratuit · Sans inscription · Privé
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Photo passeport <span class="gradient-text">Taille</span> et compresseur
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto">
          Compressez votre photo passeport à 20 Ko, 50 Ko ou 100 Ko — instantanément, dans votre navigateur. Inde, États-Unis, Royaume-Uni, Canada — tous les pays et tailles supportés. Sans inscription, 100% privé.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border-default bg-surface shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-border-default bg-surface-muted">
            <span class="text-sm font-medium text-text-secondary">Cible :</span>
            <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface border border-border-default">
              <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm" id="target-size-btn">≤ 20 Ko</button>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-5 lg:min-h-[480px]">
            <div class="lg:col-span-3 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r border-border-default">
              <div id="upload-zone" class="h-full">
                <div id="drop-area" class="relative h-full sm:min-h-[300px] min-h-[200px] rounded-xl border-2 border-dashed border-border-default bg-surface-muted/50 flex flex-col items-center justify-center text-center p-6 transition-all duration-200 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-950/20 cursor-pointer group">
                  <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-950/50 flex items-center justify-center border border-brand-100 dark:border-brand-900/50 mb-5 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <h3 class="text-base font-semibold text-text-primary mb-1.5">Glissez votre photo ici</h3>
                  <p class="text-sm text-text-secondary mb-5 max-w-xs">ou cliquez pour sélectionner depuis votre ordinateur</p>
                  <label class="btn-primary btn-md cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Sélectionner une photo
                    <input type="file" class="sr-only" accept="image/jpeg,image/png,image/webp" multiple />
                  </label>
                  <p class="text-xs text-text-tertiary mt-4">JPG, PNG, WebP · Max 50 Mo par fichier</p>
                  <div id="drop-overlay" class="absolute inset-0 rounded-xl bg-brand-50/80 dark:bg-brand-950/30 border-2 border-brand-400 dark:border-brand-600 flex flex-col items-center justify-center hidden">
                    <svg class="w-12 h-12 text-brand-500 mb-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <p class="text-base font-semibold text-brand-700 dark:text-brand-300">Déposez pour téléverser</p>
                  </div>
                </div>
              </div>
              <div id="preview-zone" class="hidden h-full">
                <div class="rounded-xl border border-border-default bg-surface overflow-hidden h-full flex flex-col">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-border-default bg-surface-muted">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-success"></div>
                      <span id="file-count" class="text-sm font-medium text-text-primary">0 fichiers prêts</span>
                    </div>
                    <button id="clear-btn" class="text-xs text-text-tertiary hover:text-danger transition-colors font-medium">Tout effacer</button>
                  </div>
                  <div id="preview-grid" class="flex-1 p-4 grid grid-cols-2 sm:grid-cols-3 gap-3 overflow-y-auto max-h-[350px] content-start"></div>
                </div>
              </div>
            </div>
            <div class="lg:col-span-2 p-5 sm:p-6 flex flex-col">
              <div class="mb-4">
                <h3 class="text-sm font-medium text-text-secondary mb-3">Taille cible</h3>
                <div class="flex flex-wrap gap-2">
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium bg-brand-600 text-white shadow-sm" data-size="20">20 Ko</button>
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary border border-border-default hover:border-brand-300 transition-colors" data-size="50">50 Ko</button>
                  <button class="size-btn px-3 py-1.5 rounded-lg text-sm font-medium text-text-tertiary hover:text-text-secondary border border-border-default hover:border-brand-300 transition-colors" data-size="100">100 Ko</button>
                </div>
              </div>
              <div id="progress-area" class="hidden mb-4">
                <div class="w-full h-2 bg-surface-muted rounded-full overflow-hidden">
                  <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-xs text-text-tertiary text-center mt-2">Compression en cours...</p>
              </div>
              <button id="convert-btn" class="w-full btn-primary btn-lg justify-center opacity-50 cursor-not-allowed" disabled>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                Compresser pour passeport
              </button>
              <div id="download-area" class="hidden mt-4"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Référence</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Tailles de photo passeport par pays</h2>
      </div>
      <div class="max-w-5xl mx-auto overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-surface border-b border-border-default">
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Pays</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Taille (mm)</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Pixels</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Taille fichier</th>
              <th class="text-left px-4 sm:px-5 py-4 font-medium text-text-secondary">Arrière-plan</th>
            </tr>
          </thead>
          <tbody>
            {passportSizes.map((size, i) => (
              <tr class:list={["border-b border-border-muted", i === 0 && "bg-brand-50/50 dark:bg-brand-950/20"]}>
                <td class="px-4 sm:px-5 py-3 font-medium text-text-primary">{size.country}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.size}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.pixels}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.kb}</td>
                <td class="px-4 sm:px-5 py-3 text-text-secondary">{size.bg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Spécifique à l'Inde</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Tailles de photo pour formulaires indiens</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {indianUseCases.map((useCase) => (
          <div class="card-hover p-5">
            <h3 class="text-sm font-semibold text-text-primary mb-2">{useCase.form}</h3>
            <div class="space-y-1">
              <p class="text-xs text-text-secondary"><span class="font-medium">Taille :</span> {useCase.size}</p>
              <p class="text-xs text-text-secondary"><span class="font-medium">Fichier :</span> {useCase.kb}</p>
              <p class="text-xs text-text-secondary"><span class="font-medium">Arrière-plan :</span> {useCase.bg}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="prose">
        <h2>Comment créer des photos de passeport</h2>
        <p>Créer une photo de passeport avec notre outil est simple :</p>
        <ol>
          <li><strong>Téléversez votre photo :</strong> Cliquez sur la zone de téléversement et sélectionnez votre photo.</li>
          <li><strong>Sélectionnez la taille cible :</strong> Choisissez 20 Ko, 50 Ko ou 100 Ko selon les exigences de votre formulaire.</li>
          <li><strong>Cliquez sur Compresser :</strong> L'outil comprimera votre photo à la taille cible.</li>
          <li><strong>Téléchargez :</strong> Obtenez votre photo prête pour le passeport instantanément.</li>
        </ol>
        <h3>Conseils de qualité de photo</h3>
        <ul>
          <li>Utilisez un éclairage naturel et uniforme. Évitez les ombres dures.</li>
          <li>Utilisez un fond blanc uni.</li>
          <li>Regardez directement la caméra avec une expression neutre.</li>
          <li>Enlevez vos lunettes si possible, ou assurez-vous qu'il n'y ait pas de reflets.</li>
        </ul>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container variant="narrow">
      <div class="text-center mb-10">
        <Badge class="mb-4">FAQ</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Questions Fréquentes</h2>
      </div>
      <FAQ items={faqItems} />
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container variant="narrow">
      <div class="prose">
        <h2>Quelle est la taille standard d'une photo de passeport ?</h2>
        <p>La taille standard d'une photo de passeport pour la plupart des pays est de <strong>35 mm × 45 mm</strong> (3,5 cm × 4,5 cm), ce qui correspond à environ <strong>413 × 531 pixels</strong> à 300 DPI. La photo de passeport américain utilise une taille différente : <strong>2in × 2in</strong> (51 mm × 51 mm ou 600 × 600 pixels).</p>
        <p>La plupart des portails gouvernementaux et systèmes de demande de passeport exigent que votre photo fasse entre <strong>20 Ko et 100 Ko</strong> en taille de fichier. Notre compresseur gratuit en ligne vous aide à atteindre la taille cible exacte sans perte de qualité visible.</p>
        <h3>Exigences de photo de passeport par pays</h3>
        <p>Chaque pays a des exigences légèrement différentes pour les photos de passeport. L'Inde, le Royaume-Uni, l'Australie et la plupart des pays de l'UE utilisent le standard 35 mm × 45 mm. Les États-Unis et les Philippines utilisent 2×2 pouces. Le Canada utilise un format plus grand de 50 mm × 70 mm. Notre outil supporte la compression à toutes ces tailles — sélectionnez simplement la taille de fichier cible et téléversez.</p>
        <h3>Comment compresser une photo de passeport en ligne</h3>
        <ol>
          <li><strong>Téléversez votre photo</strong> — Cliquez sur la zone de téléversement ou glissez-déposez votre image (JPG, PNG ou WebP).</li>
          <li><strong>Choisissez la taille cible</strong> — Sélectionnez 20 Ko, 50 Ko ou 100 Ko selon les exigences de votre portail de demande.</li>
          <li><strong>Téléchargez</strong> — Obtenez votre photo de passeport compressée instantanément, prête à être envoyée.</li>
        </ol>
        <p>L'ensemble du processus s'exécute dans votre navigateur — <strong>vos photos ne sont jamais envoyées sur un serveur</strong>. Cela fait de notre outil la forme la plus sûre de comprimer des photos de passeport sensibles en ligne.</p>
        <p>Vous avez besoin de comprimer des photos pour un <a href={`${prefix}/tools/compress-for-govt-form`} class="text-brand-600 hover:text-brand-700 underline">formulaire gouvernemental (SSC, UPSC, Banque)</a> ? Ou convertir votre image en <a href={`${prefix}/tools/photo-to-base64`} class="text-brand-600 hover:text-brand-700 underline">Base64 pour le développement web</a> ?</p>
      </div>
    </Container>
  </section>

  <section class="section bg-surface-muted">
    <Container>
      <div class="text-center mb-10">
        <Badge class="mb-4">Outils Connexes</Badge>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight mb-3">Essayez nos autres outils</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href={`${prefix}/tools/compress-to-100kb`} class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compresser à 100 Ko</h3>
          <p class="text-sm text-text-secondary">Réduisez les images à moins de 100 Ko.</p>
        </a>
        <a href={`${prefix}/tools/compress-for-govt-form`} class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Compresser pour formulaire gov</h3>
          <p class="text-sm text-text-secondary">Réduisez les images pour les formulaires SSC, UPSC.</p>
        </a>
        <a href={`${prefix}/tools/photo-to-base64`} class="card-hover p-5 group">
          <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Photo en Base64</h3>
          <p class="text-sm text-text-secondary">Convertissez les images en chaînes Base64.</p>
        </a>
      </div>
    </Container>
  </section>

  <script>
    import { initTargetedCompressor } from "@scripts/targeted-compress.js";
    
    const config = { targetSize: 20 * 1024 };
    initTargetedCompressor(config);
    
    const targetSizeBtn = document.getElementById('target-size-btn');
    const sizeButtons = document.querySelectorAll('.size-btn');
    
    sizeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        sizeButtons.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
          b.classList.add('text-text-tertiary', 'border', 'border-border-default');
        });
        btn.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
        btn.classList.remove('text-text-tertiary', 'border', 'border-border-default');
        config.targetSize = parseInt(btn.dataset.size) * 1024;
        if (targetSizeBtn) targetSizeBtn.textContent = '≤ ' + btn.dataset.size + ' Ko';
      });
    });
  </script>
</BaseLayout>
